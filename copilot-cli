#!/usr/bin/env bash
# Forseti HQ CLI — quick access to Bedrock/Claude for development tasks
# Usage: copilot-cli <prompt>  or  copilot-cli --help

set -euo pipefail

TIMEOUT_SEC=60
HQ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BEDROCK_SCRIPT="$HQ_ROOT/copilot-hq/scripts/hq-bedrock-chat.sh"
BEDROCK_SETUP="$HQ_ROOT/bedrock-setup.sh"

# Load AWS credentials from bedrock-setup.sh
if [ -f "$BEDROCK_SETUP" ]; then
  BEDROCK_SETUP_QUIET=1 source "$BEDROCK_SETUP" || true
fi

# If only profile is set (no direct creds), extract them from ~/.aws/credentials
# so PHP/Drupal subprocesses get direct env vars instead of needing profile support.
if [ -z "${AWS_ACCESS_KEY_ID:-}" ] && [ -f "$HOME/.aws/credentials" ]; then
  _prof="${AWS_PROFILE:-forseti-base}"
  # Try to read directly from the base profile (no role assumption needed;
  # ForsetiBedrock policy is attached directly to the forseti IAM user)
  _key=$(awk "/^\[${_prof}\]/{f=1} f && /aws_access_key_id/{print \$3; exit}" "$HOME/.aws/credentials")
  _secret=$(awk "/^\[${_prof}\]/{f=1} f && /aws_secret_access_key/{print \$3; exit}" "$HOME/.aws/credentials")
  if [ -n "$_key" ] && [ -n "$_secret" ]; then
    export AWS_ACCESS_KEY_ID="$_key"
    export AWS_SECRET_ACCESS_KEY="$_secret"
    export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
    unset AWS_PROFILE AWS_SESSION_TOKEN
  fi
  unset _prof _key _secret
fi

if [ -z "${DRUPAL_ROOT:-}" ] && [ -d "$HQ_ROOT/sites/forseti" ]; then
  export DRUPAL_ROOT="$HQ_ROOT/sites/forseti"
fi

usage() {
  cat <<'EOF'
Forseti HQ CLI — Bedrock/Claude integration for development

Usage:
  copilot-cli <prompt>              Send prompt and get response
  copilot-cli --chat               Interactive multi-turn chat
  copilot-cli --explain <file>     Analyze/explain file contents
  copilot-cli --timeout N          Set timeout (default: 60s)
  copilot-cli --help               Show this help

NOTE: 
  The installed 'copilot' CLI is GitHub Copilot for shell commands only.
  This wrapper uses AWS Bedrock (Claude) for general HQ operations.
  If Bedrock is not configured, use VS Code GitHub Copilot Chat instead.

Examples:
  copilot-cli "What is the JobHunter module architecture?"
  copilot-cli --chat
  copilot-cli --explain sites/forseti/web/modules/custom/job_hunter/README.md
EOF
}

if [ $# -eq 0 ]; then
  usage
  exit 0
fi

ARGS=()
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --timeout)
      TIMEOUT_SEC="${2:-60}"
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [ ${#ARGS[@]} -eq 0 ]; then
  usage
  exit 0
fi

set -- "${ARGS[@]}"

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --chat)
    if [ ! -x "$BEDROCK_SCRIPT" ]; then
      echo "[ERROR] Bedrock script not found: $BEDROCK_SCRIPT"
      echo "[INFO] Bedrock not configured. Use VS Code GitHub Copilot Chat instead."
      exit 1
    fi
    echo "Starting interactive chat (Bedrock, timeout: ${TIMEOUT_SEC}s)..."
    timeout "$TIMEOUT_SEC" "$BEDROCK_SCRIPT" || {
      rc=$?
      if [ $rc -eq 124 ]; then
        echo "[WARN] Chat timed out after ${TIMEOUT_SEC}s"
        exit 0
      fi
    }
    ;;
  --explain)
    FILE="${2:-.}"
    if [ ! -e "$FILE" ]; then
      echo "[ERROR] File not found: $FILE"
      exit 1
    fi
    CONTENT="$(cat "$FILE" 2>/dev/null || echo "")"
    PROMPT="Analyze and explain this file:\n\n\`\`\`\n$CONTENT\n\`\`\`"
    if [ ! -x "$BEDROCK_SCRIPT" ]; then
      echo "[ERROR] Bedrock not configured."
      exit 1
    fi
    echo "Analyzing: $FILE"
    echo "---"
    timeout "$TIMEOUT_SEC" bash -c "echo -e \"\$PROMPT\" | $BEDROCK_SCRIPT" || {
      rc=$?
      if [ $rc -eq 124 ]; then
        echo "[WARN] Request timed out after ${TIMEOUT_SEC}s"
      fi
    }
    ;;
  *)
    # Direct prompt mode
    PROMPT="$@"
    if [ ! -x "$BEDROCK_SCRIPT" ]; then
      echo "[ERROR] Bedrock not configured."
      echo "[INFO] Alternatives:"
      echo "  1. Use VS Code GitHub Copilot Chat"
      echo "  2. Configure AWS Bedrock:"
      echo "     - Set AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"
      echo "     - Run: $BEDROCK_SCRIPT --test"
      exit 1
    fi
    OUTPUT=""
    set +e
    OUTPUT="$(timeout "$TIMEOUT_SEC" bash -c "echo \"$PROMPT\" | $BEDROCK_SCRIPT" 2>&1)"
    rc=$?
    set -e

    if [ $rc -eq 0 ]; then
      printf '%s\n' "$OUTPUT"
      exit 0
    fi

    printf '%s\n' "$OUTPUT"
    if printf '%s\n' "$OUTPUT" | grep -qi "AWSCompromisedKeyQuarantineV3"; then
      echo ""
      echo "[ACTION REQUIRED] Current AWS key is quarantined by IAM policy (AWSCompromisedKeyQuarantineV3)."
      echo "Fix steps:"
      echo "  1) Create/obtain new AWS credentials (or role) without quarantine policy"
      echo "  2) Export them in current shell (or update .env):"
      echo "     export AWS_ACCESS_KEY_ID='<new_key>'"
      echo "     export AWS_SECRET_ACCESS_KEY='<new_secret>'"
      echo "     export AWS_DEFAULT_REGION='us-west-2'"
      echo "  3) If .env was updated and you want to force reload: BEDROCK_SETUP_FORCE=1 source ./bedrock-setup.sh"
      echo "  4) Retry: ./copilot-cli \"test\" --timeout 90"
      exit 3
    fi

    if [ $rc -eq 124 ]; then
      echo "[WARN] Request timed out after ${TIMEOUT_SEC}s"
      exit 124
    fi

    {
      echo "[ERROR] Request failed with exit code $rc"
      exit $rc
    }
    ;;
esac
