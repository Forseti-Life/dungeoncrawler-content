{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/navigation_receipt.schema.json",
  "title": "Navigation Receipt Schema",
  "description": "Canonical client-facing navigation payload for room transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_room_id", "destination", "room", "entities", "connections", "navigation_capabilities", "entry_hex"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["navigation-receipt-v1"]
    },
    "target_room_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "origin_room_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "destination_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "travel_type": {
      "type": "string",
      "enum": ["walk", "ride", "teleport", "climb", "swim", "fly"]
    },
    "estimated_distance": {
      "type": "string",
      "enum": ["adjacent", "short", "medium", "long"]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "template_id": {
      "type": ["string", "null"],
      "maxLength": 255
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room_id", "name", "description", "hexes", "terrain", "lighting", "room_type", "size_category", "gameplay_state", "connections"],
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "hexes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "r"],
            "properties": {
              "q": { "type": "integer" },
              "r": { "type": "integer" },
              "terrain_override": {
                "type": "string",
                "minLength": 1
              },
              "elevation_ft": {
                "type": "integer",
                "minimum": -50,
                "maximum": 200
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "terrain": {
          "type": "object"
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "room_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "size_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "gameplay_state": {
          "type": "object"
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "navigation_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connection_id", "origin_room_id", "target_room_id", "type", "available", "is_discovered", "is_passable", "bidirectional", "requires_interaction", "destination_type", "destination_id", "distance"],
        "properties": {
          "connection_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "origin_room_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "target_room_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "available": { "type": "boolean" },
          "blocked_reason": { "type": ["string", "null"], "maxLength": 64 },
          "is_discovered": { "type": "boolean" },
          "is_passable": { "type": "boolean" },
          "bidirectional": { "type": "boolean" },
          "requires_interaction": { "type": "boolean" },
          "destination_type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "destination_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "distance": { "type": "integer", "minimum": 0 },
          "travel_time_seconds": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "origin_hex": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["q", "r"],
            "properties": {
              "q": { "type": "integer" },
              "r": { "type": "integer" }
            }
          },
          "target_hex": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["q", "r"],
            "properties": {
              "q": { "type": "integer" },
              "r": { "type": "integer" }
            }
          }
        }
      }
    },
    "entry_hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer" },
        "r": { "type": "integer" }
      }
    }
  }
}
