{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/room_placement_instance.schema.json",
  "title": "Canonical Room Placement Instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "definition_ref", "room_id", "anchor_hex", "footprint", "facing", "elevation_ft", "state_defaults", "overrides"],
  "properties": {
    "schema_version": {"const": "room-placement-v1"},
    "instance_id": {"type": "string", "format": "uuid"},
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "definition_id", "version"],
      "properties": {
        "family": {"enum": ["creature", "actor", "item", "obstacle", "trap", "hazard"]},
        "definition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "room_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
    "anchor_hex": {"$ref": "#/$defs/coordinate"},
    "footprint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coordinate"}
    },
    "facing": {"type": "integer", "minimum": 0, "maximum": 5},
    "elevation_ft": {"type": "integer", "minimum": -50, "maximum": 200},
    "state_defaults": {"type": "object"},
    "overrides": {"type": "object"}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "r": {"type": "integer", "minimum": -1000, "maximum": 1000}
      }
    }
  }
}
