{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/quest_touchpoint_ingest.schema.json",
  "title": "Quest Touchpoint Ingest Schema",
  "description": "Canonical runtime contract for quest touchpoint ingest payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["character_id", "touchpoint"],
  "properties": {
    "character_id": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "integer",
      "minimum": 1
    },
    "touchpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_type"],
      "properties": {
        "objective_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "objective_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "entity_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "npc_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "item_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "location_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "matching_mode": {
          "type": "string",
          "maxLength": 64
        },
        "target_name": {
          "type": "string",
          "maxLength": 255
        },
        "occurred_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
