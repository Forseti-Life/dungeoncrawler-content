{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/combat_execution_request.schema.json",
  "title": "Combat Execution Request Schema",
  "description": "Canonical command DTO for action-family execution requests crossing coordinator/orchestrator seams.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "action_type",
    "actor_entity_ref",
    "params"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "combat.execution_request.v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "combat_execution_request"
      ]
    },
    "action_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor_entity_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "target_entity_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "params": {
      "type": "object"
    }
  }
}
