{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/combat_resolution_envelope.schema.json",
  "title": "Combat Resolution Envelope Schema",
  "description": "Canonical execution result envelope emitted by combat action resolvers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "request",
    "packets",
    "result"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "combat.resolution_envelope.v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "combat_resolution_envelope"
      ]
    },
    "request": {
      "type": "object"
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "type": "object"
    }
  }
}
