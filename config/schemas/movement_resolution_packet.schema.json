{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/movement_resolution_packet.schema.json",
  "title": "Movement Resolution Packet Schema",
  "description": "Canonical movement mutation packet for stride/forced movement lanes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "actor_entity_ref",
    "movement_mode",
    "from_hex",
    "to_hex",
    "distance_ft",
    "action_cost",
    "metadata"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "combat.movement_packet.v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "movement_resolution"
      ]
    },
    "actor_entity_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "movement_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "from_hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer" },
        "r": { "type": "integer" }
      }
    },
    "to_hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer" },
        "r": { "type": "integer" }
      }
    },
    "distance_ft": {
      "type": "integer",
      "minimum": 0
    },
    "action_cost": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    }
  }
}
