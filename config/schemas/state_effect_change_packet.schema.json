{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/state_effect_change_packet.schema.json",
  "title": "State Effect Change Packet Schema",
  "description": "Canonical condition/effect lifecycle mutation packet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "actor_entity_ref",
    "target_entity_ref",
    "effect_kind",
    "effect_name",
    "change_type",
    "metadata"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "combat.state_effect_packet.v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "state_effect_change"
      ]
    },
    "actor_entity_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "target_entity_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "effect_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "effect_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "change_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "value": {
      "type": [
        "integer",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
