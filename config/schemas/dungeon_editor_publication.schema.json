{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/dungeon_editor_publication.schema.json",
  "title": "Dungeon Editor Publication",
  "description": "Immutable dungeon publication record. Mirrors room_editor_publication: a request half validated on the way in, a result half recorded on the way out. Publication is unconditional with respect to campaigns; campaign runtime state is disposable and re-initialised, never migrated, and is never read here.",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision", "version", "publication_note", "expected_base_version_id"],
      "properties": {
        "expected_revision": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "publication_note": {"type": "string", "maxLength": 2000},
        "expected_base_version_id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dungeon_id", "version_id", "version", "payload_hash", "published_at", "published_by", "projected_connector_count"],
      "properties": {
        "dungeon_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
        "version_id": {"type": "string", "format": "uuid"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "published_at": {"type": "string", "format": "date-time"},
        "published_by": {"type": "integer", "minimum": 0},
        "projected_connector_count": {
          "type": "integer",
          "minimum": 0,
          "description": "How many connector rows the one-way projection wrote. Port links are the authoring truth; connectors are derived at publication only."
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/request"},
    {"$ref": "#/definitions/result"}
  ]
}
