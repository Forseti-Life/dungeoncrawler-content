{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/room_editor_draft.schema.json",
  "title": "Room Editor Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "room_id", "base_version_id", "revision", "status", "room", "payload_hash", "created_by", "updated_by", "created_at", "updated_at", "published_version_id"],
  "properties": {
    "schema_version": {"const": "room-editor-draft-v1"},
    "draft_id": {"type": "string", "format": "uuid"},
    "room_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
    "base_version_id": {"type": ["string", "null"], "format": "uuid"},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["active", "published", "abandoned"]},
    "room": {"$ref": "canonical_room_aggregate.schema.json"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_by": {"type": "integer", "minimum": 0},
    "updated_by": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "published_version_id": {"type": ["string", "null"], "format": "uuid"}
  }
}
