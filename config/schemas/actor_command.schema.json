{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/actor_command.schema.json",
  "title": "Actor command envelope",
  "description": "actor-command-v1 (DC-ACTOR-AUTHORITY-20261114 C1). Principal, capabilities and correlation are supplied by the authenticated server and are never part of this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "command_id",
    "target",
    "type",
    "base_revision",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "actor-command-v1"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "actor_uuid"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "draft",
            "template",
            "campaign_instance"
          ]
        },
        "actor_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "campaign_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "const": "campaign_instance"
          }
        }
      },
      "then": {
        "required": [
          "campaign_id"
        ]
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "actor.identity.patch",
        "actor.narrative.patch"
      ]
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "set",
                  "unset"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(/[A-Za-z0-9_]+)+$",
                "maxLength": 200
              },
              "value": {}
            },
            "if": {
              "required": [
                "op"
              ],
              "properties": {
                "op": {
                  "const": "set"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
