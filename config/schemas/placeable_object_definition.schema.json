{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/placeable_object_definition.schema.json",
  "title": "Placeable Object Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_id", "definition_version", "family", "label", "category", "tags", "footprint", "visual", "placement_constraints", "allowed_instance_overrides", "source_authority"],
  "properties": {
    "schema_version": {"const": "placeable-object-v1"},
    "definition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
    "definition_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "family": {"enum": ["creature", "actor", "item", "obstacle", "trap", "hazard"]},
    "label": {"type": "string", "minLength": 1, "maxLength": 200},
    "category": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 2000},
    "tags": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"}},
    "footprint": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/coordinate"}},
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sprite_id"],
      "properties": {
        "sprite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
        "color": {"type": "string", "pattern": "^(#[0-9A-Fa-f]{6})?$"}
      }
    },
    "placement_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occupancy", "stackable"],
      "properties": {
        "occupancy": {"enum": ["solid", "soft", "overlay"]},
        "stackable": {"type": "boolean"},
        "allowed_terrain": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_terrain": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "allowed_instance_overrides": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_table", "source_id", "source_hash"],
      "properties": {
        "provider": {"enum": ["content_registry", "canonical_actor"]},
        "source_table": {"enum": ["dungeoncrawler_content_registry", "dc_canonical_actors"]},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 191},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "r": {"type": "integer", "minimum": -1000, "maximum": 1000}
      }
    }
  }
}
