{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyline-authoring-draft-v1",
  "title": "Storyline authoring draft",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "storyline_id",
    "title",
    "description",
    "premise",
    "process_flow",
    "objects",
    "orchestration"
  ],
  "properties": {
    "schema_version": {
      "const": "storyline-authoring-draft-v1"
    },
    "storyline_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "premise": {
      "type": "string"
    },
    "level_range": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "player_hook": {
      "type": "string"
    },
    "entry_actor_id": {
      "type": "string"
    },
    "entry_location_id": {
      "type": "string"
    },
    "ending": {
      "type": "string"
    },
    "process_flow": {
      "type": "object",
      "required": [
        "journal_entries",
        "tasks",
        "objective_completion_criteria",
        "conflicts",
        "narrative_architecture"
      ],
      "properties": {
        "journal_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journal_entry"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "branch_choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch_choice"
          }
        },
        "objective_completion_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        },
        "narrative_architecture": {
          "$ref": "#/$defs/narrative_architecture"
        }
      }
    },
    "objects": {
      "type": "object",
      "required": [
        "actors",
        "dungeons",
        "rooms",
        "items"
      ],
      "properties": {
        "actors": {
          "type": "object",
          "required": [
            "generation_specs",
            "validation_criteria"
          ],
          "properties": {
            "generation_specs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/actor"
              }
            },
            "validation_criteria": {
              "type": "array"
            },
            "relationships": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/actor_relationship"
              }
            }
          }
        },
        "dungeons": {
          "type": "object",
          "required": [
            "generation_specs"
          ],
          "properties": {
            "generation_specs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dungeon"
              }
            }
          }
        },
        "rooms": {
          "type": "object",
          "required": [
            "generation_specs",
            "validation_criteria"
          ],
          "properties": {
            "generation_specs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/room"
              }
            },
            "validation_criteria": {
              "type": "array"
            }
          }
        },
        "items": {
          "type": "object",
          "required": [
            "generation_specs",
            "validation_criteria"
          ],
          "properties": {
            "generation_specs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "validation_criteria": {
              "type": "array"
            }
          }
        },
        "institutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/institution"
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "required": [
        "generation",
        "validation"
      ],
      "properties": {
        "generation": {
          "type": "array"
        },
        "validation": {
          "type": "array"
        }
      }
    },
    "canonical_template": {
      "type": "object",
      "description": "Immutable source template attached by the draft authority."
    }
  },
  "$defs": {
    "string_or_string_array": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "narrative_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats",
        "adventure_requirements"
      ],
      "properties": {
        "beats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inciting_incident",
            "threshold_of_no_return",
            "progressive_complications",
            "crisis",
            "climax",
            "denouement"
          ],
          "properties": {
            "inciting_incident": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "disruption",
                "stakes"
              ],
              "properties": {
                "disruption": {
                  "type": "string"
                },
                "stakes": {
                  "type": "string"
                }
              }
            },
            "threshold_of_no_return": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "crossing",
                "point_of_no_return"
              ],
              "properties": {
                "crossing": {
                  "type": "string"
                },
                "point_of_no_return": {
                  "type": "string"
                }
              }
            },
            "progressive_complications": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "road_of_trials",
                "midpoint_shift"
              ],
              "properties": {
                "road_of_trials": {
                  "type": "string"
                },
                "midpoint_shift": {
                  "type": "string"
                }
              }
            },
            "crisis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dark_night",
                "psychological_pivot"
              ],
              "properties": {
                "dark_night": {
                  "type": "string"
                },
                "psychological_pivot": {
                  "type": "string"
                }
              }
            },
            "climax": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "central_confrontation",
                "premise_resolution"
              ],
              "properties": {
                "central_confrontation": {
                  "type": "string"
                },
                "premise_resolution": {
                  "type": "string"
                }
              }
            },
            "denouement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "new_equilibrium",
                "internal_shift"
              ],
              "properties": {
                "new_equilibrium": {
                  "type": "string"
                },
                "internal_shift": {
                  "type": "string"
                }
              }
            }
          }
        },
        "adventure_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physical_quest",
            "antagonistic_force",
            "mentor_guide",
            "boon_macguffin"
          ],
          "properties": {
            "physical_quest": {
              "type": "string"
            },
            "antagonistic_force": {
              "type": "string"
            },
            "mentor_guide": {
              "type": "string"
            },
            "boon_macguffin": {
              "type": "string"
            }
          }
        }
      }
    },
    "journal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "scene_id",
        "title",
        "summary"
      ],
      "properties": {
        "chapter_id": {
          "type": "string"
        },
        "scene_id": {
          "type": "string"
        },
        "order": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "room_ids": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "central_conflict": {
          "type": "string"
        },
        "dramatic_function": {
          "type": "string"
        },
        "themes": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "character_ids": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "foreshadows_scene_id": {
          "type": "string"
        },
        "relationship_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship_change"
          }
        }
      }
    },
    "relationship_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_actor_id",
        "target_actor_id",
        "before",
        "after",
        "reason"
      ],
      "properties": {
        "source_actor_id": {
          "type": "string"
        },
        "target_actor_id": {
          "type": "string"
        },
        "before": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "string"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "chapter_id",
        "scene_id"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "goal_text": {
          "type": "string",
          "description": "What the players are trying to achieve in this quest, in their words. Setting it makes the quest goal-based: its choices marked as approaches are the ways to achieve it."
        },
        "gm_notes": {
          "type": "string",
          "description": "What only the Game Master should know about this goal. Never shown to players."
        },
        "open_resolution": {
          "description": "Whether a way nobody authored may also achieve the goal.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "chapter_id": {
          "type": "string"
        },
        "scene_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "unlocks_after": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "unlocks_to": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "unlock_condition": {
          "type": "string"
        }
      }
    },
    "branch_choice": {
      "type": "object",
      "required": [
        "decision_id",
        "source_task_id",
        "choice_id",
        "label",
        "trigger",
        "effects"
      ],
      "properties": {
        "approach": {
          "type": "object",
          "description": "Present when this choice is a way of achieving its source task's goal. Resolving it completes that quest.",
          "additionalProperties": false,
          "required": [
            "visibility",
            "outcome_label"
          ],
          "properties": {
            "visibility": {
              "description": "known: players see it from the start. discoverable: hidden until reveal_when happens. secret: never shown before it is used.",
              "enum": [
                "known",
                "discoverable",
                "secret"
              ]
            },
            "reveal_when": {
              "type": "object",
              "description": "Discoverable only. Either {objective_id} (revealed when that objective of the quest completes) or {touchpoint: {objective_type, ref}} (revealed when that game event happens, for example interacting with an actor)."
            },
            "objective_ids": {
              "description": "Objectives of the quest that make up this way. Leave empty when only the Game Master can judge it achieved.",
              "$ref": "#/$defs/string_or_string_array"
            },
            "outcome_label": {
              "type": "string",
              "description": "What players read once the goal is achieved this way."
            },
            "rewards": {
              "type": "object",
              "description": "Replaces the quest reward when the goal is achieved this way: {xp, gold, items}, and optionally reputation: [{institution, amount}] naming an institution of the library by slug or institution ID."
            }
          }
        },
        "decision_id": {
          "type": "string"
        },
        "source_task_id": {
          "type": "string",
          "description": "The task this choice belongs to. Leave it empty for a storyline-wide choice: a condition that can fire from any task, authored once."
        },
        "choice_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/branch_trigger"
        },
        "effects": {
          "$ref": "#/$defs/branch_effects"
        },
        "target_task_id": {
          "type": "string"
        },
        "target_scene_id": {
          "type": "string"
        },
        "terminal": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "branch_trigger": {
      "type": "object",
      "required": [
        "type",
        "condition",
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "player_choice",
            "action",
            "objective_result",
            "skill_result",
            "actor_state",
            "environment_state",
            "item_state",
            "timer",
            "gm_decision"
          ]
        },
        "condition": {
          "type": "string"
        },
        "interaction": {
          "enum": [
            "other",
            "attacked",
            "killed"
          ]
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "branch_state_change": {
      "type": "object",
      "required": [
        "key",
        "operation",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "set",
            "increment",
            "decrement",
            "add",
            "remove"
          ]
        },
        "value": {}
      }
    },
    "branch_effects": {
      "type": "object",
      "required": [
        "summary",
        "actors",
        "environment",
        "storyline"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "effect",
              "state_changes"
            ],
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "interaction": {
                "enum": [
                  "other",
                  "attacked",
                  "killed"
                ]
              },
              "reaction": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "state_changes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/branch_state_change"
                }
              }
            }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target_type",
              "target_id",
              "effect",
              "state_changes"
            ],
            "additionalProperties": false,
            "properties": {
              "target_type": {
                "enum": [
                  "room",
                  "dungeon",
                  "location",
                  "world"
                ]
              },
              "target_id": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "state_changes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/branch_state_change"
                }
              }
            }
          }
        },
        "storyline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target_type",
              "target_id",
              "operation",
              "effect",
              "follow_up_required",
              "state_changes"
            ],
            "additionalProperties": false,
            "properties": {
              "target_type": {
                "enum": [
                  "task",
                  "scene",
                  "conflict",
                  "chapter",
                  "storyline"
                ]
              },
              "target_id": {
                "type": "string"
              },
              "source_actor_id": {
                "type": "string"
              },
              "operation": {
                "enum": [
                  "unlock",
                  "lock",
                  "reveal",
                  "conceal",
                  "redirect",
                  "escalate",
                  "resolve",
                  "set"
                ]
              },
              "effect": {
                "type": "string"
              },
              "follow_up_required": {
                "type": "boolean"
              },
              "state_changes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/branch_state_change"
                }
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "description"
      ],
      "properties": {
        "objective_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string",
          "description": "The task this objective is a required step of. Objectives of one task are completed in row order."
        },
        "type": {
          "type": "string",
          "enum": [
            "collect",
            "kill",
            "investigate",
            "interact",
            "explore",
            "escort"
          ],
          "description": "What the players do, and what completes it in play. collect needs item and completes when the items are obtained; kill needs target and completes when it is defeated; investigate needs target and completes when the lead is found; interact needs target and completes when the players talk with or use that target, whatever the result; explore needs location and completes when the party reaches it; escort needs destination and completes when the party arrives there. To require that an actor is persuaded (agrees to help, agrees to join the party), use interact with requires_check set to request."
        },
        "next_step": {
          "type": "string",
          "description": "What the players must do next to make progress, in their words."
        },
        "target": {
          "type": "string",
          "description": "Actor or object ID for kill, investigate and interact."
        },
        "item": {
          "type": "string",
          "description": "Item ID for collect."
        },
        "location": {
          "type": "string",
          "description": "Room or scene ID for explore."
        },
        "destination": {
          "type": "string",
          "description": "Room or scene ID for escort."
        },
        "requires_check": {
          "type": "string",
          "enum": [
            "",
            "request"
          ],
          "description": "interact only. request: the objective completes only when a player's Request (a Diplomacy check against the target, harder or easier by the target's attitude) succeeds. Talking alone does not complete it. The target must be an actor of this storyline."
        },
        "kind": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "title",
        "introduced_scene_id",
        "status"
      ],
      "properties": {
        "conflict_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "actor_ids": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "introduced_scene_id": {
          "type": "string"
        },
        "escalation_scene_ids": {
          "$ref": "#/$defs/string_or_string_array"
        },
        "resolved_scene_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "resolved",
            "intentional_open_thread"
          ]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_id",
        "actor_id",
        "role",
        "display_name"
      ],
      "properties": {
        "contact_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "motivation": {
          "type": "string"
        },
        "dialogue": {
          "type": "string"
        },
        "knowledge": {
          "type": "string"
        },
        "attitude": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "chapter_id": {
          "type": "string"
        },
        "scene_id": {
          "type": "string"
        },
        "location_id": {
          "type": "string"
        },
        "affiliations": {
          "type": "array",
          "description": "Institutions of this storyline the actor is tied to. Ancestry and class are not listed here: they come from the actor's sheet.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution_id"
            ],
            "properties": {
              "institution_id": {
                "type": "string",
                "minLength": 1,
                "description": "An institution_id from objects.institutions."
              },
              "standing": {
                "enum": [
                  "member",
                  "leader",
                  "exile",
                  "ally"
                ],
                "description": "member and leader belong to the institution; exile once belonged; ally stands with it from outside. Defaults to member."
              }
            }
          }
        },
        "character_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Native library character sheet in the same canonical actor row."
        },
        "character_sheet_revision": {
          "type": "integer",
          "minimum": 0
        },
        "character_sheet_spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
"alignment": {
          "description": "The actor's alignment. It makes the actor a member of the alignment institutions (Lawful or Chaotic, Good or Evil, Neutral) and is carried onto its character sheet.",
          "enum": ["LG", "NG", "CG", "LN", "N", "CN", "LE", "NE", "CE"]
        },
                "class": {
          "type": "string",
          "minLength": 1
        },
        "ancestry": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "dungeon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dungeon_id",
        "chapter_id"
      ],
      "properties": {
        "dungeon_id": {
          "type": "string"
        },
        "chapter_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
