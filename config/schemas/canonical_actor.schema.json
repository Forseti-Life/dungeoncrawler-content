{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.forseti.life/schemas/canonical_actor.schema.json",
  "title": "Canonical Actor",
  "description": "Canonical actor definition stored in dc_canonical_actors. Derived from the observed shape of the 34 live rows; every required field is present in all of them and every optional field is present in at least one. Closes the actor family schema gap so the definition editor and the GM update_canonical_definition tool can validate before writing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "version", "actor_type", "display_name", "state_data"],
  "properties": {
    "actor_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,190}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "actor_type": {"enum": ["pc", "npc", "party", "trap", "obstacle"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "source_module": {"type": ["string", "null"], "maxLength": 128},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["generated_by"], "properties": {"generated_by": {"type": "object", "additionalProperties": false, "required": ["tool", "model", "prompt_hash", "seed", "generated_at"], "properties": {"tool": {"type": "string", "enum": ["generate_item_definition", "generate_creature_definition", "generate_npc_definition", "generate_obstacle_definition", "generate_hazard_definition", "generate_trap_definition", "generate_canonical_definition"]}, "model": {"type": "string", "minLength": 1, "maxLength": 200}, "provider": {"type": "string", "minLength": 1, "maxLength": 100}, "prompt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "generated_at": {"type": "string", "format": "date-time"}}}}},
    "state_data": {"$ref": "#/definitions/state_data"}
  },
  "definitions": {
    "state_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "level", "hp_current", "conditions"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "class": {"type": "string", "minLength": 1, "maxLength": 64},
        "level": {"type": "integer", "minimum": -1, "maximum": 30},
        "hp_current": {"type": "integer", "minimum": 0},
        "max_hp": {"type": "integer", "minimum": 0},
        "ac": {"type": "integer", "minimum": 0},
        "species": {"type": "string", "minLength": 1, "maxLength": 64},
        "ancestry": {"type": "string", "minLength": 1, "maxLength": 100},
        "heritage": {"type": "string", "minLength": 1, "maxLength": 100},
        "background": {"type": "string", "minLength": 1, "maxLength": 100},
        "occupation": {"type": "string", "minLength": 1, "maxLength": 150},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "alignment": {"enum": ["LG", "NG", "CG", "LN", "N", "CN", "LE", "NE", "CE"]},
        "size": {"enum": ["Tiny", "Small", "Medium", "Large", "Huge", "Gargantuan"]},
        "speed": {"type": "integer", "minimum": 0, "maximum": 120},
        "perception": {"type": "integer", "minimum": -10, "maximum": 60},
        "attitude": {"enum": ["hostile", "unfriendly", "indifferent", "friendly", "helpful"]},
        "party_size": {"type": "integer", "minimum": 1, "maximum": 12},
        "source_module": {"type": "string", "maxLength": 128},
        "description": {"type": "string", "maxLength": 4000},
        "appearance": {"type": "string", "maxLength": 2000},
        "personality": {"type": "string", "maxLength": 2000},
        "backstory": {"type": "string", "maxLength": 5000},
        "motivations": {"type": "string", "maxLength": 1000},
        "fears": {"type": "string", "maxLength": 1000},
        "bonds": {"type": "string", "maxLength": 1000},
        "personality_traits": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "abilities": {"$ref": "#/definitions/abilities"},
        "saves": {"$ref": "#/definitions/saves"},
        "skills": {"$ref": "#/definitions/skills"},
        "attacks": {"$ref": "#/definitions/attacks"},
        "equipment": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "languages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "senses": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "spells": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "psychology": {"$ref": "#/definitions/psychology"},
        "storyline_binding": {"$ref": "#/definitions/storyline_binding"},
        "conditions": {"$ref": "#/definitions/conditions"}
      },
      "allOf": [
        {
          "if": {"properties": {"class": {"const": "party"}}, "required": ["class"]},
          "then": {"required": ["party_size"]}
        }
      ]
    },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"],
      "properties": {
        "strength": {"type": "integer", "minimum": 1, "maximum": 30},
        "dexterity": {"type": "integer", "minimum": 1, "maximum": 30},
        "constitution": {"type": "integer", "minimum": 1, "maximum": 30},
        "intelligence": {"type": "integer", "minimum": 1, "maximum": 30},
        "wisdom": {"type": "integer", "minimum": 1, "maximum": 30},
        "charisma": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "saves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fortitude", "reflex", "will"],
      "properties": {
        "fortitude": {"type": "integer", "minimum": -10, "maximum": 60},
        "reflex": {"type": "integer", "minimum": -10, "maximum": 60},
        "will": {"type": "integer", "minimum": -10, "maximum": 60}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modifier"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "modifier": {"type": "integer", "minimum": -10, "maximum": 60}
        }
      }
    },
    "attacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bonus", "damage"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "bonus": {"type": "integer", "minimum": -10, "maximum": 60},
          "damage": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "psychology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inner_conflict",
        "coping_mechanism",
        "stress_response",
        "insecurity",
        "secret",
        "desire",
        "need",
        "trigger",
        "anchor"
      ],
      "properties": {
        "inner_conflict": {"type": "string", "minLength": 1, "maxLength": 500},
        "coping_mechanism": {"type": "string", "minLength": 1, "maxLength": 500},
        "stress_response": {"type": "string", "minLength": 1, "maxLength": 500},
        "insecurity": {"type": "string", "minLength": 1, "maxLength": 500},
        "secret": {"type": "string", "minLength": 1, "maxLength": 500},
        "desire": {"type": "string", "minLength": 1, "maxLength": 500},
        "need": {"type": "string", "minLength": 1, "maxLength": 500},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
        "anchor": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "storyline_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact_id": {"type": "string", "maxLength": 128},
        "availability": {"type": "string", "maxLength": 64},
        "chapter_id": {"type": "string", "maxLength": 128},
        "scene_id": {"type": "string", "maxLength": 128},
        "location_id": {"type": "string", "maxLength": 128},
        "dialogue": {"type": "string", "maxLength": 2000},
        "knowledge": {"type": "string", "maxLength": 2000}
      }
    },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "description": "Active PF2e conditions. Item shape is identical to character.schema.json#/properties/conditions so a canonical actor and a runtime character carry conditions in one format.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["integer", "null"]},
          "duration": {"type": ["string", "null"]}
        }
      }
    }
  }
}
