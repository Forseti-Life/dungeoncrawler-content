{
  "schema_version": "storyline-validation-troubleshooting-v1",
  "routes": {
    "draft_operation": {
      "owner": "StorylineAuthoringDraftService",
      "tool": "plan_storyline_draft_operations"
    },
    "canonical_definition": {
      "owner": "CanonicalDefinitionService",
      "tool": "update_canonical_definition"
    },
    "actor_sheet_build": {
      "owner": "StorylineActorSheetService",
      "tool": "build_storyline_actor_sheets"
    },
    "dungeon_editor": {
      "owner": "DungeonEditorGmService",
      "tool": "route_to_editor"
    },
    "room_editor": {
      "owner": "RoomEditorGmService",
      "tool": "route_to_editor"
    }
  },
  "stages": {
    "schema": {"route": "draft_operation", "resolver": "generic"},
    "definition_completeness": {"route": "draft_operation", "resolver": "generic"},
    "cross_references": {"route": "canonical_definition", "resolver": "generic"},
    "questline_progression": {"route": "draft_operation", "resolver": "generic"},
    "narrative_analysis": {"route": "draft_operation", "resolver": "generic"},
    "navigation_progression": {"route": "draft_operation", "resolver": "generic"},
    "objective_control_chain": {"route": "draft_operation", "resolver": "generic"},
    "entity_type_contracts": {"route": "canonical_definition", "resolver": "generic"},
    "task_contracts": {"route": "draft_operation", "resolver": "generic"},
    "objective_playability": {"route": "draft_operation", "resolver": "generic"},
    "entity_linkage": {"route": "draft_operation", "resolver": "generic"},
    "dungeon_room_contracts": {"route": "dungeon_editor", "resolver": "generic"},
    "authored_room_dungeon_bindings": {"route": "dungeon_editor", "resolver": "generic"},
    "actor_character_sheets": {"route": "actor_sheet_build", "resolver": "generic"},
    "authored_questline_edges": {"route": "draft_operation", "resolver": "generic"}
  },
  "findings": {
    "DCV_OBJ_PLAYABILITY_MISSING_TARGET_LABEL": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["target_label", "target_aliases"],
      "verification": "same_object"
    },
    "DCV_OBJ_PLAYABILITY_MISSING_TARGET_ALIASES": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["target_label", "target_aliases"],
      "verification": "same_object"
    },
    "DCV_OBJ_PLAYABILITY_MISSING_WAYFINDING_HINT": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["wayfinding_hint"],
      "verification": "same_object"
    },
    "DCV_OBJ_PLAYABILITY_MISSING_ACTION_ANCHOR": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["target", "location", "destination"],
      "verification": "selected_code"
    },
    "DCV_OBJECTIVE_TYPE_FIELD_CONFLICT": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["target", "item", "location", "destination", "required"],
      "verification": "same_object"
    },
    "DCV_OBJECTIVE_NONCOUNT_REQUIRED": {
      "resolver": "storyline_quest_objective",
      "route": "draft_operation",
      "fields": ["required"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_PRIMARY_CHAPTER_MISMATCH": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_CONTACT_CHAPTER_UNKNOWN": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_ASSET_CHAPTER_UNKNOWN": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_ENTRY_CHAPTER_UNKNOWN": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_ENTRY_SCENE_CHAPTER_MISMATCH": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_STORYLINE_ENTRY_LOCATION_CHAPTER_MISMATCH": {
      "resolver": "storyline_chapter_reference",
      "route": "draft_operation",
      "fields": ["chapter_id"],
      "verification": "same_object"
    },
    "DCV_CANONICAL_ROOM_MISSING": {
      "resolver": "editor_route",
      "route": "room_editor",
      "fields": [],
      "verification": "selected_code"
    },
    "DCV_AUTHORED_ROOM_NOT_IN_DUNGEON": {
      "resolver": "editor_route",
      "route": "dungeon_editor",
      "fields": [],
      "verification": "selected_code"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_REQUIRED_FLAG": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": [],
      "verification": "same_object"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_ENTITY_TYPE_INVALID": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": [],
      "verification": "same_object"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_MISSING_REGISTRY_TYPE": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": [],
      "verification": "same_object"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_MISSING_ACTOR": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": ["actor_id"],
      "verification": "same_object"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_MISSING_LOCATION": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": ["location_id"],
      "verification": "same_object"
    },
    "DCV_ACTOR_RUNTIME_MATERIALIZATION_LOCATION_UNANCHORED": {
      "resolver": "storyline_actor_materialization",
      "route": "draft_operation",
      "fields": ["location_id"],
      "verification": "same_object"
    },
    "actor_home_missing": {
      "resolver": "storyline_actor_home",
      "route": "draft_operation",
      "fields": ["affiliations"],
      "verification": "same_object"
    }
  },
  "default": {
    "route": "unclassified",
    "resolver": "generic",
    "verification": "selected_code",
    "scope": "read_only_unless_registered"
  }
}
