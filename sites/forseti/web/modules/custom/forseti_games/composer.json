{
  "name": "your-org/drupal-games",
  "type": "drupal-module",
  "description": "Interactive games module for Drupal",
  "license": "Apache-2.0",
  "homepage": "https://github.com/your-org/drupal-games",
  "support": {
    "issues": "https://github.com/your-org/drupal-games/issues",
    "docs": "https://github.com/your-org/drupal-games/wiki"
  },
  "authors": [
    {
      "name": "Your Name",
      "email": "your-email@example.com"
    }
  ],
  "keywords": [
    "drupal",
    "games",
    "gamification",
    "puzzle",
    "leaderboards"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^10.3 || ^11"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\forseti_games\\": "src/"
    }
  }
}
