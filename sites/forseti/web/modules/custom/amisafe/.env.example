# AmISafe Configuration Examples

# H3 Resolution Settings
# Default resolution level (5-13)
AMISAFE_DEFAULT_RESOLUTION=9

# Use pre-computed Gold Layer (recommended for performance)
AMISAFE_USE_GOLD_LAYER=true

# Location Tracking (enable if using mobile app)
AMISAFE_ENABLE_LOCATION_TRACKING=false

# Log Management (track console diagnostics)
AMISAFE_ENABLE_LOG_MANAGEMENT=false

# User Authentication (enable mobile app registration/login)
AMISAFE_ENABLE_USER_AUTH=false

# Data Source Configuration
# URL to external data service (optional)
AMISAFE_DATA_SOURCE_URL=""
AMISAFE_DATA_SOURCE_API_KEY=""

# Logging
# Log level: debug, info, notice, warning, error
AMISAFE_LOG_LEVEL=notice

# Cache Settings
# Cache backend (database, redis, memcache)
AMISAFE_CACHE_BACKEND=database
