{
  "name": "drupal/amisafe",
  "description": "Spatial analytics dashboard with H3 geospatial hexagon support for real-time data visualization.",
  "type": "drupal-module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "keywords": ["drupal", "analytics", "geospatial", "h3", "spatial-analysis"],
  "homepage": "https://github.com/example/amisafe",
  "authors": [
    {
      "name": "Forseti Project",
      "email": "info@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "drupal/core": "^9.5 || ^10 || ^11"
  },
  "require-dev": {
    "drupal/core-dev": "^9.5 || ^10 || ^11",
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.0",
    "squizlabs/php_codesniffer": "^3.7",
    "drupal/coder": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\amisafe\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\amisafe\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@phpunit",
      "@phpstan"
    ],
    "phpunit": "phpunit",
    "phpstan": "phpstan analyse",
    "lint": "phpcs --standard=Drupal .",
    "fix": "phpcbf --standard=Drupal ."
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  }
}
