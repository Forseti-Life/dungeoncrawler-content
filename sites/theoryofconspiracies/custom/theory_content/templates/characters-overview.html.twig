{#
/**
 * @file
 * Characters overview page template
 *
 * Available variables:
 * - characters: Array of character data
 */
#}

<div class="characters-overview cyberpunk-container">
  
  <div class="page-header">
    <h1 class="page-title glitch-text" data-text="CHARACTERS">
      CHARACTERS
    </h1>
    <div class="page-subtitle">
      Main Characters in Theory of Conspiracies
    </div>
    <div class="page-description">
      Philadelphia 2085: A cast of humans and AI consciousnesses navigate the complex landscape of institutional control and resistance networks.
    </div>
  </div>

  <div class="characters-grid">
    {% for character in characters %}
      <div class="character-card" data-character-type="{{ character.type|lower|replace({' ': '-'}) }}">
        
        <div class="character-card-header">
          <h3 class="character-card-name">
            <a href="{{ character.path }}">{{ character.name }}</a>
          </h3>
          <div class="character-card-role">{{ character.role }}</div>
          <div class="character-card-type type-{{ character.type|lower|replace({' ': '-'}) }}">
            {{ character.type }}
          </div>
        </div>

        <div class="character-card-image">
          <div class="image-placeholder">
            <div class="loading-animation">
              <span>IMG_LOADING...</span>
            </div>
          </div>
        </div>

        <div class="character-card-content">
          <p class="character-card-description">
            {{ character.description }}
          </p>
        </div>

        <div class="character-card-actions">
          <a href="{{ character.path }}" class="character-btn">
            View Profile
          </a>
        </div>

      </div>
    {% endfor %}
  </div>

  <div class="characters-navigation">
    <a href="/story/act-i" class="cyberpunk-btn">View Story Timeline</a>
    <a href="/setting/philadelphia-2085" class="cyberpunk-btn">Explore Setting</a>
    <a href="/" class="cyberpunk-btn">Return Home</a>
  </div>

</div>
