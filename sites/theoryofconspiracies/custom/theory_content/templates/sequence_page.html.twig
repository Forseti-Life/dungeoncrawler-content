{#
/**
 * @file
 * Template for individual story sequence pages.
 *
 * Available variables:
 * - sequence: Array containing sequence data
 *   - number: Sequence number
 *   - title: Sequence title
 *   - act: Which act this sequence belongs to
 *   - summary: Brief sequence summary
 *   - detailed_description: Full sequence description
 *   - setting: Where the sequence takes place
 *   - key_characters: Important characters in this sequence
 *   - detailed_moments: Array of key moments with descriptions
 *   - trust_changes: Character relationship changes
 *   - world_building_elements: Setting and technology details
 *   - themes_explored: Thematic content
 */
#}

<div class="sequence-page">
  <div class="sequence-header">
    <div class="sequence-meta">
      <span class="act-label">{{ sequence.act }}</span>
      <h1 class="sequence-title">
        <span class="sequence-number">{{ sequence.number }}</span>
        {{ sequence.title }}
      </h1>
    </div>
    <div class="sequence-summary">
      <p class="lead">{{ sequence.summary }}</p>
    </div>
  </div>

  <div class="sequence-content">
    <div class="sequence-main">
      <section class="sequence-description">
        <h2>Overview</h2>
        <p>{{ sequence.detailed_description }}</p>
        
        {% if sequence.setting %}
          <div class="sequence-setting">
            <h3>Setting</h3>
            <p>{{ sequence.setting }}</p>
          </div>
        {% endif %}
      </section>

      {% if sequence.key_characters %}
        <section class="sequence-characters">
          <h2>Key Characters</h2>
          <div class="character-grid">
            {% for name, description in sequence.key_characters %}
              <div class="character-role">
                <h4>{{ name }}</h4>
                <p>{{ description }}</p>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if sequence.detailed_moments %}
        <section class="sequence-moments">
          <h2>Key Moments</h2>
          {% for moment in sequence.detailed_moments %}
            <div class="story-moment">
              <h3>{{ moment.moment }}</h3>
              <p class="moment-description">{{ moment.description }}</p>
              {% if moment.character_development %}
                <div class="character-development">
                  <strong>Character Development:</strong> {{ moment.character_development }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </section>
      {% endif %}

      {% if sequence.trust_changes %}
        <section class="trust-changes">
          <h2>Character Relationship Changes</h2>
          <ul class="trust-list">
            {% for change in sequence.trust_changes %}
              <li class="trust-change">{{ change }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>

    <div class="sequence-sidebar">
      {% if sequence.world_building_elements %}
        <section class="world-building">
          <h3>World Building</h3>
          <ul>
            {% for element in sequence.world_building_elements %}
              <li>{{ element }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if sequence.themes_explored %}
        <section class="themes">
          <h3>Themes Explored</h3>
          <ul>
            {% for theme in sequence.themes_explored %}
              <li>{{ theme }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if sequence.foreshadowing %}
        <section class="foreshadowing">
          <h3>Foreshadowing</h3>
          <ul>
            {% for element in sequence.foreshadowing %}
              <li>{{ element }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if sequence.dramatic_function %}
        <section class="dramatic-function">
          <h3>Dramatic Function</h3>
          <ul>
            {% for function in sequence.dramatic_function %}
              <li>{{ function }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  </div>

  <div class="sequence-navigation">
    <div class="nav-links">
      {% if sequence.number > 1 %}
        <a href="#" class="nav-prev" onclick="history.back(); return false;">
          ← Previous Sequence
        </a>
      {% endif %}
      
      <a href="/story/{{ sequence.act|lower == 'act i - discovery' ? 'act-i' : 'act-ii' }}" class="nav-up">
        ↑ Back to {{ sequence.act }}
      </a>
      
      {% if sequence.number < 16 %}
        <a href="#" class="nav-next" onclick="history.forward(); return false;">
          Next Sequence →
        </a>
      {% endif %}
    </div>
  </div>
</div>