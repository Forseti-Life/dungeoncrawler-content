{#
/**
 * @file
 * Template for the Site Footer Block.
 *
 * Available variables:
 * - attributes: HTML attributes for the block wrapper.
 */
#}

<div{{ attributes.addClass('site-footer-block') }}>
  <div class="footer-container">
    <!-- Brand Section -->
    <div class="footer-brand">
      <h3 class="footer-logo">Theory of Conspiracies</h3>
      <p class="footer-tagline">Philadelphia 2085 • Where Reality Meets Fiction</p>
      <div class="footer-rating">
        <span class="rating-badge">PG-13</span>
        <span class="rating-text">Parental Guidance Suggested</span>
      </div>
    </div>

    <!-- Navigation Section -->
    <div class="footer-nav">
      <h4 class="footer-section-title">Explore</h4>
      <ul class="footer-links">
        <li><a href="/" data-once="audio-feedback">Home</a></li>
        <li><a href="/characters" data-once="audio-feedback">Characters</a></li>
        <li><a href="/story/act-i" data-once="audio-feedback">Story Timeline</a></li>
        <li><a href="/setting/philadelphia-2085" data-once="audio-feedback">Setting</a></li>
      </ul>
    </div>

    <!-- Legal Section -->
    <div class="footer-legal">
      <h4 class="footer-section-title">Legal</h4>
      <ul class="footer-links">
        <li><a href="/legal/terms" data-once="audio-feedback">Terms of Use</a></li>
        <li><a href="/legal/privacy" data-once="audio-feedback">Privacy Policy</a></li>
        <li><a href="/legal/disclaimer" data-once="audio-feedback">Content Disclaimer</a></li>
        <li><a href="/legal/copyright" data-once="audio-feedback">Copyright</a></li>
      </ul>
    </div>

    <!-- Contact Section -->
    <div class="footer-contact">
      <h4 class="footer-section-title">Connect</h4>
      <ul class="footer-links">
        <li><a href="/legal/about" data-once="audio-feedback">About</a></li>
        <li><a href="/legal/credits" data-once="audio-feedback">Credits</a></li>
        <li><a href="#top" data-once="audio-feedback">Back to Top</a></li>
      </ul>
    </div>
  </div>
</div>

