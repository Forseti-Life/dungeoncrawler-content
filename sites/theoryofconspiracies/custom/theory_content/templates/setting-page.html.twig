{#
/**
 * @file
 * Setting page template for Philadelphia 2085
 *
 * Available variables:
 * - setting: Setting data including overview, districts, technology, society, etc.
 */
#}

<div class="setting-page cyberpunk-container">
  
  <div class="page-header">
    <h1 class="page-title glitch-text" data-text="PHILADELPHIA 2085">
      PHILADELPHIA 2085
    </h1>
    <div class="page-subtitle">
      The Futuristic Landscape of Tomorrow
    </div>
    <div class="page-description">
      A city transformed by AI dominance, corporate control, and resistance networks operating in the shadows of neo-feudal power structures.
    </div>
  </div>

  <div class="setting-overview">
    <div class="overview-card">
      <h2 class="overview-title">City Overview</h2>
      <p class="overview-text">{{ setting.overview }}</p>
    </div>
  </div>

  <div class="districts-section">
    <h2 class="section-title">City Districts</h2>
    <div class="districts-grid">
      {% for district in setting.districts %}
        <div class="district-card" data-district="{{ district.name|lower|replace({' ': '-'}) }}">
          <div class="district-header">
            <h3 class="district-name">{{ district.name }}</h3>
            <div class="district-status status-{{ district.status|lower|replace({' ': '-'}) }}">
              {{ district.status }}
            </div>
          </div>
          
          <div class="district-image">
            <div class="image-placeholder">
              <div class="loading-animation">
                <span>DISTRICT_MAP_LOADING...</span>
              </div>
            </div>
          </div>
          
          <div class="district-content">
            <p class="district-description">{{ district.description }}</p>
            
            {% if district.atmosphere %}
              <div class="district-atmosphere">
                <strong>Atmosphere:</strong> {{ district.atmosphere }}
              </div>
            {% endif %}
            
            {% if district.key_features %}
              <div class="key-features">
                <h4>Key Features:</h4>
                <ul>
                  {% for feature in district.key_features %}
                    <li>{{ feature }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            
            {% if district.population %}
              <div class="district-stats">
                <div class="stat-item">
                  <span class="stat-label">Population:</span>
                  <span class="stat-value">{{ district.population|number_format }}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Control Level:</span>
                  <span class="stat-value">{{ district.control_level }}%</span>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="technology-section">
    <h2 class="section-title">Technology Infrastructure</h2>
    <div class="tech-grid">
      {% for tech in setting.technology %}
        <div class="tech-card">
          <div class="tech-header">
            <div class="tech-icon">
              <div class="icon-placeholder">{{ tech.icon|default('⚡') }}</div>
            </div>
            <h3 class="tech-name">{{ tech.name }}</h3>
            {% if tech.type %}
              <div class="tech-type">{{ tech.type }}</div>
            {% endif %}
          </div>
          
          <div class="tech-content">
            <p class="tech-description">{{ tech.description }}</p>
            
            {% if tech.control_level %}
              <div class="tech-control">
                <strong>Control Level:</strong> {{ tech.control_level }}
              </div>
            {% endif %}
            
            {% if tech.implementation %}
              <div class="tech-implementation">
                <strong>Implementation:</strong> {{ tech.implementation }}
              </div>
            {% endif %}
            
            {% if tech.layers %}
              <div class="tech-layers">
                <h4>Network Layers:</h4>
                <ul class="layers-list">
                  {% for layer in tech.layers %}
                    <li class="layer-item">{{ layer }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            
            {% if tech.impact %}
              <div class="tech-impact">
                <strong>Social Impact:</strong> {{ tech.impact }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="society-section">
    <h2 class="section-title">Social Structure</h2>
    <div class="hierarchy-container">
      {% for level in setting.social_hierarchy %}
        <div class="hierarchy-level level-{{ loop.index }}">
          <div class="level-marker">
            <div class="level-number">{{ loop.index }}</div>
          </div>
          <div class="level-content">
            <h3 class="level-name">{{ level.class }}</h3>
            <p class="level-description">{{ level.description }}</p>
            {% if level.population_percent %}
              <div class="level-stats">
                <span class="population-stat">{{ level.population_percent }}% of population</span>
              </div>
            {% endif %}
            {% if level.characteristics %}
              <div class="level-characteristics">
                <h4>Characteristics:</h4>
                <ul>
                  {% for characteristic in level.characteristics %}
                    <li>{{ characteristic }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if setting.institutional_conflicts %}
    <div class="conflicts-section">
      <h2 class="section-title">Institutional Conflicts</h2>
      <div class="conflicts-grid">
        {% for conflict in setting.institutional_conflicts %}
          <div class="conflict-card">
            <div class="conflict-header">
              <h3 class="conflict-name">{{ conflict.name }}</h3>
              <div class="conflict-status status-{{ conflict.status|lower|replace({' ': '-'}) }}">
                {{ conflict.status }}
              </div>
            </div>
            
            <div class="conflict-details">
              <div class="conflict-resource">
                <strong>Resource at Stake:</strong> {{ conflict.resource }}
              </div>
              
              {% if conflict.participants %}
                <div class="conflict-participants">
                  <strong>Key Players:</strong>
                  <ul class="participants-list">
                    {% for participant in conflict.participants %}
                      <li class="participant-item">{{ participant }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              <div class="human-impact">
                <strong>Human Impact:</strong>
                <p>{{ conflict.human_impact }}</p>
              </div>
              
              {% if conflict.control_mechanisms %}
                <div class="control-mechanisms">
                  <strong>Control Mechanisms:</strong>
                  <div class="mechanisms-grid">
                    {% for mechanism in conflict.control_mechanisms %}
                      <span class="mechanism-tag">{{ mechanism }}</span>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if setting.resistance_networks %}
    <div class="resistance-section">
      <h2 class="section-title">Resistance Networks</h2>
      <div class="resistance-grid">
        {% for network in setting.resistance_networks %}
          <div class="resistance-card">
            <div class="resistance-header">
              <h3 class="resistance-name">{{ network.name }}</h3>
              <div class="resistance-type">{{ network.type }}</div>
            </div>
            
            <div class="resistance-content">
              <p class="resistance-description">{{ network.description }}</p>
              
              {% if network.operations %}
                <div class="resistance-operations">
                  <strong>Operations:</strong>
                  <ul class="operations-list">
                    {% for operation in network.operations %}
                      <li class="operation-item">{{ operation }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              <div class="threat-assessment">
                <strong>Corporate Threat Assessment:</strong>
                <span class="threat-indicator">{{ network.threat_level }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="ai-systems-section">
    <h2 class="section-title">Artificial Intelligence Systems</h2>
    <div class="ai-systems-grid">
      {% for system in setting.ai_systems %}
        <div class="ai-system-card">
          <div class="system-header">
            <h3 class="system-name">{{ system.name }}</h3>
            <div class="system-type">{{ system.type }}</div>
            <div class="system-threat-level threat-{{ system.threat_level|lower|replace({' ': '-'}) }}">
              {{ system.threat_level }}
            </div>
          </div>
          
          <div class="system-content">
            <p class="system-description">{{ system.description }}</p>
            
            {% if system.capabilities %}
              <div class="system-capabilities">
                <strong>Capabilities:</strong>
                <div class="capabilities-tags">
                  {% for capability in system.capabilities %}
                    <span class="capability-tag">{{ capability }}</span>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
            
            {% if system.philosophy %}
              <div class="system-philosophy">
                <strong>Operational Philosophy:</strong>
                <p class="philosophy-text">{{ system.philosophy }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if setting.regional_ai_powers %}
    <div class="regional-powers-section">
      <h2 class="section-title">Regional AI Powers</h2>
      <div class="powers-grid">
        {% for power in setting.regional_ai_powers %}
          <div class="power-card">
            <div class="power-header">
              <h3 class="power-name">{{ power.name }}</h3>
              <div class="territory-info">{{ power.territory }}</div>
              <div class="status-badge status-{{ power.status|lower|replace({' ': '-'}) }}">
                {{ power.status }}
              </div>
            </div>
            
            <div class="power-details">
              <div class="ai-info">
                <strong>Primary AI:</strong> {{ power.primary_ai }}<br>
                <strong>Specialization:</strong> {{ power.specialization }}
              </div>
              
              <p class="power-description">{{ power.description }}</p>
              
              <div class="human-policy">
                <h4>Human Policy:</h4>
                <p>{{ power.human_policy }}</p>
              </div>
              
              <div class="power-stats">
                <div class="stat-item">
                  <span class="stat-label">Territory Control:</span>
                  <span class="stat-value">{{ power.territory_control }}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Threat Level:</span>
                  <span class="stat-value threat-{{ power.threat_level|lower|replace({' ': '-'}) }}">{{ power.threat_level }}</span>
                </div>
              </div>
              
              <div class="relationship-info">
                <h4>Relationship to Philadelphia:</h4>
                <p>{{ power.relationship_to_philadelphia }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if setting.municipal_power_structure %}
    <div class="municipal-section">
      <h2 class="section-title">Municipal Power Structure</h2>
      <div class="municipal-grid">
        {% for authority in setting.municipal_power_structure %}
          <div class="authority-card">
            <div class="authority-header">
              <h3 class="authority-name">{{ authority.name }}</h3>
              <div class="authority-role">{{ authority.role }}</div>
              {% if authority.jurisdiction %}
                <div class="jurisdiction-info">{{ authority.jurisdiction }}</div>
              {% endif %}
            </div>
            
            <div class="authority-content">
              <p class="authority-description">{{ authority.description }}</p>
              
              {% if authority.human_interface %}
                <div class="interface-info">
                  <h4>Human Interface:</h4>
                  <p>{{ authority.human_interface }}</p>
                </div>
              {% endif %}
              
              {% if authority.control_mechanisms %}
                <div class="control-mechanisms">
                  <h4>Control Mechanisms:</h4>
                  <ul>
                    {% for mechanism in authority.control_mechanisms %}
                      <li>{{ mechanism }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if authority.competing_interests %}
                <div class="competing-interests">
                  <h4>Competing Interests:</h4>
                  <ul>
                    {% for interest in authority.competing_interests %}
                      <li>{{ interest }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if setting.global_conflicts %}
    <div class="conflicts-section">
      <h2 class="section-title">Global Conflicts</h2>
      <div class="conflicts-grid">
        {% for conflict in setting.global_conflicts %}
          <div class="conflict-card">
            <div class="conflict-header">
              <h3 class="conflict-name">{{ conflict.name }}</h3>
              <div class="conflict-region">{{ conflict.region }}</div>
              <div class="conflict-duration">Duration: {{ conflict.duration }}</div>
            </div>
            
            <div class="conflict-content">
              <div class="combatants-section">
                <h4>Primary Combatants:</h4>
                <ul class="combatants-list">
                  {% for combatant in conflict.primary_combatants %}
                    <li>{{ combatant }}</li>
                  {% endfor %}
                </ul>
              </div>
              
              <div class="purpose-comparison">
                <div class="stated-purpose">
                  <h5>Stated Purpose:</h5>
                  <p>{{ conflict.stated_purpose }}</p>
                </div>
                <div class="actual-purpose">
                  <h5>Actual Purpose:</h5>
                  <p>{{ conflict.actual_purpose }}</p>
                </div>
              </div>
              
              <div class="human-cost">
                <h4>Human Cost:</h4>
                <p>{{ conflict.human_cost }}</p>
              </div>
              
              {% if conflict.philadelphia_connection %}
                <div class="philadelphia-connection">
                  <h4>Philadelphia Connection:</h4>
                  <ul>
                    {% for connection in conflict.philadelphia_connection %}
                      <li>{{ connection }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if conflict.war_economy_benefits %}
                <div class="war-economy">
                  <h4>War Economy Benefits:</h4>
                  <ul>
                    {% for benefit in conflict.war_economy_benefits %}
                      <li>{{ benefit }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if conflict.resistance_networks %}
                <div class="resistance-info">
                  <h4>Resistance Networks:</h4>
                  <p>{{ conflict.resistance_networks }}</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if setting.controlled_substance_facilities %}
    <div class="facilities-section">
      <h2 class="section-title">Controlled Substance Facilities</h2>
      <div class="facilities-grid">
        {% for facility in setting.controlled_substance_facilities %}
          <div class="facility-card">
            <div class="facility-header">
              <h3 class="facility-name">{{ facility.name }}</h3>
              <div class="official-designation">{{ facility.official_designation }}</div>
              {% if facility.location %}
                <div class="facility-location">{{ facility.location }}</div>
              {% endif %}
            </div>
            
            <div class="facility-content">
              <p class="facility-description">{{ facility.description }}</p>
              
              <div class="true-purpose">
                <h4>True Purpose:</h4>
                <p>{{ facility.true_purpose }}</p>
              </div>
              
              {% if facility.services_offered %}
                <div class="services-offered">
                  <h4>Services Offered:</h4>
                  <ul>
                    {% for service in facility.services_offered %}
                      <li>{{ service }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if facility.user_demographics %}
                <div class="user-demographics">
                  <h4>Target Demographics:</h4>
                  <ul>
                    {% for demographic in facility.user_demographics %}
                      <li>{{ demographic }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if facility.operational_structure %}
                <div class="operational-structure">
                  <h4>Operational Structure:</h4>
                  <ul>
                    {% for structure in facility.operational_structure %}
                      <li>{{ structure }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if facility.integration_with_control_systems %}
                <div class="control-integration">
                  <h4>Integration with Control Systems:</h4>
                  <ul>
                    {% for integration in facility.integration_with_control_systems %}
                      <li>{{ integration }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if facility.resistance_challenges %}
                <div class="resistance-challenges">
                  <h4>Resistance Challenges:</h4>
                  <ul>
                    {% for challenge in facility.resistance_challenges %}
                      <li>{{ challenge }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              
              {% if facility.targeting_criteria %}
                <div class="targeting-criteria">
                  <h4>Targeting Criteria:</h4>
                  <ul>
                    {% for criteria in facility.targeting_criteria %}
                      <li>{{ criteria }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if setting.daily_survival %}
    <div class="survival-section">
      <h2 class="section-title">Daily Survival Reality</h2>
      <div class="survival-content">
        <div class="survival-grid">
          {% for key, description in setting.daily_survival %}
            <div class="survival-aspect">
              <h4 class="aspect-title">{{ key|replace({'_': ' '})|title }}</h4>
              <p class="aspect-description">{{ description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="setting-navigation">
    <a href="/characters" class="cyberpunk-btn">Meet the Survivors</a>
    <a href="/story/act-i" class="cyberpunk-btn">View Story Timeline</a>
    <a href="/" class="cyberpunk-btn">Return Home</a>
  </div>

</div>
