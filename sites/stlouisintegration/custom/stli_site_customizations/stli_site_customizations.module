<?php

/**
 * @file
 * St. Louis Integration site customizations module.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function stli_site_customizations_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Customize contact forms to remove "Your name" and "Your email" labels.
  if (strpos($form_id, 'contact_message_') === 0 && strpos($form_id, '_form') !== FALSE) {
    
    // Remove "Your" prefix from name field label
    if (isset($form['name'])) {
      $form['name']['#title'] = t('Name');
      $form['name']['#attributes']['placeholder'] = t('Enter your full name');
    }
    
    // Remove "Your" prefix from email field label  
    if (isset($form['mail'])) {
      $form['mail']['#title'] = t('Email Address');
      $form['mail']['#attributes']['placeholder'] = t('Enter your email address');
    }
    
    // Enhance subject field
    if (isset($form['subject'])) {
      $form['subject']['#title'] = t('Subject');
      $form['subject']['#attributes']['placeholder'] = t('Brief subject of your inquiry');
    }
    
    // Enhance message field
    if (isset($form['message'])) {
      $form['message']['#title'] = t('Message');
      $form['message']['#attributes']['placeholder'] = t('Please describe your integration needs or inquiry in detail...');
    }
  }
}