{#
/**
 * @file
 * Template for tailoring resume for a specific job opportunity.
 *
 * Available variables:
 * - user: The user entity
 * - profile: The job seeker profile entity
 * - job: The job posting entity
 */
#}

<div class="job-hunter-layout">
  <aside class="job-hunter-sidebar">
    {% set nav_block = create_block('job_hunter_navigation') %}
    {{ nav_block }}
  </aside>
  
  <main class="job-hunter-content">
    <div class="tailor-resume">
  <div class="tailor-resume-header">
    <h1>{{ 'Tailor Resume for %job'|t({'%job': job.getTitle()}) }}</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('job_application_automation.start_job_discovery', {'user': user.id()}) }}">{{ 'Job Discovery'|t }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ 'Tailor Resume'|t }}</li>
      </ol>
    </nav>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3>{{ 'Job Details'|t }}</h3>
        </div>
        <div class="card-body">
          <h4>{{ job.getTitle() }}</h4>
          
          {% if not job.get('field_job_description').isEmpty %}
            <div class="job-description">
              <h5>{{ 'Job Description'|t }}</h5>
              <div class="description-content">
                {{ job.get('field_job_description').value|raw }}
              </div>
            </div>
          {% endif %}

          {% if not job.get('field_requirements').isEmpty %}
            <div class="job-requirements mt-3">
              <h5>{{ 'Requirements'|t }}</h5>
              <div class="requirements-content">
                {{ job.get('field_requirements').value|raw }}
              </div>
            </div>
          {% endif %}

          {% if not job.get('field_skills_required').isEmpty %}
            <div class="skills-required mt-3">
              <h5>{{ 'Skills Required'|t }}</h5>
              <div class="skills-content">
                {{ job.get('field_skills_required').value|raw }}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3>{{ 'Current Resume'|t }}</h3>
        </div>
        <div class="card-body">
          {% if resume %}
            <div class="current-resume">
              <h5>{{ resume.getTitle() }}</h5>
              {% if not resume.get('body').isEmpty %}
                <div class="resume-content">
                  {{ resume.get('body').value|raw }}
                </div>
              {% endif %}
            </div>
          {% else %}
            <p>{{ 'No resume found. Please contact the administrator.'|t }}</p>
          {% endif %}
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">
          <h3>{{ 'AI Resume Tailoring'|t }}</h3>
        </div>
        <div class="card-body">
          <p class="mb-3">{{ 'Our AI will analyze this job posting and your resume to create a tailored version that highlights your most relevant skills and experience for this specific position.'|t }}</p>
          
          <div class="tailoring-options">
            <h5>{{ 'Tailoring Options'|t }}</h5>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="emphasize-keywords" checked>
              <label class="form-check-label" for="emphasize-keywords">
                {{ 'Emphasize matching keywords'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="reorder-sections" checked>
              <label class="form-check-label" for="reorder-sections">
                {{ 'Reorder sections by relevance'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="highlight-achievements" checked>
              <label class="form-check-label" for="highlight-achievements">
                {{ 'Highlight relevant achievements'|t }}
              </label>
            </div>
          </div>

          <div class="tailoring-actions mt-4">
            <button id="start-tailoring" class="btn btn-primary btn-lg" data-job-id="{{ job.id() }}" data-user-id="{{ user.id() }}">
              <i class="fas fa-magic"></i> {{ 'Start AI Tailoring'|t }}
            </button>
          </div>

          <div id="tailoring-status" class="mt-3 hidden">
            <div class="alert alert-info">
              <i class="fas fa-spinner fa-spin me-2"></i>
              {{ 'AI is analyzing the job posting and tailoring your resume...'|t }}
            </div>
          </div>

          <div id="tailoring-results" class="mt-3 hidden">
            <div class="alert alert-success">
              <h5>{{ 'Resume Tailored Successfully!'|t }}</h5>
              <p>{{ 'Your resume has been tailored for this position. Review the changes below:'|t }}</p>
            </div>
            
            <div class="tailored-resume-preview">
              <h6>{{ 'Tailored Resume Preview'|t }}</h6>
              <div id="resume-content" class="border p-3 bg-light">
                {# Resume content will be populated by JavaScript #}
              </div>
            </div>

            <div class="resume-actions mt-3">
              <button class="btn btn-success me-2">
                <i class="fas fa-download"></i> {{ 'Download PDF'|t }}
              </button>
              <button class="btn btn-outline-primary me-2">
                <i class="fas fa-edit"></i> {{ 'Edit Resume'|t }}
              </button>
              <button class="btn btn-outline-secondary">
                <i class="fas fa-save"></i> {{ 'Save Changes'|t }}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
    </div>
  </main>
</div>