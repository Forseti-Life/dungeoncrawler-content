<?php

/**
 * @file
 * Install, update and uninstall functions for the Job Application Automation module.
 * 
 * DATA PRESERVATION POLICY:
 * ========================
 * This module is designed to NEVER delete user content or fields during uninstallation.
 * All job applications, company data, user profiles, resume files, and custom content
 * are preserved to prevent accidental data loss.
 * 
 * Protected during uninstall:
 * - Content types: company, job_posting, application, issue, tailored_resume
 * - User fields: field_resume_file, field_primary_resume_text, field_profile_completeness, etc.
 * - Profile fields: field_profile_completeness, field_resume_file
 * - All associated content and data
 * 
 * Only module configuration settings are removed during uninstall.
 * Manual cleanup can be performed via Drupal admin interface if desired.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\views\Views;

/**
 * Implements hook_schema().
 * 
 * Note: The job_seeker table is NOT defined here to prevent automatic
 * deletion during module uninstall. It is created in hook_install() instead.
 */
function job_application_automation_schema() {
  // Return empty array - custom tables are created in hook_install()
  // and preserved during uninstall
  return [];
}

/**
 * Implements hook_requirements().
 */
function job_application_automation_requirements($phase) {
  $requirements = [];
  
  if ($phase === 'uninstall') {
    $requirements['job_application_automation_data_preservation'] = [
      'title' => t('Job Application Automation - Data Preservation'),
      'value' => t('All content, fields, and custom tables will be preserved'),
      'description' => t('This module is designed to preserve all user data during uninstallation. The job_seeker custom table, content types (company, job_posting, application, issue, tailored_resume), user fields (resume files, profile data), and profile fields will NOT be deleted. This prevents accidental data loss. If you need to remove these items, do so manually after uninstallation via Structure > Content types, Configuration > Account settings, or database administration tools.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }
  
  return $requirements;
}

/**
 * Create the job_seeker custom table.
 * 
 * This table is created outside of hook_schema() to prevent automatic
 * deletion during module uninstall, preserving all job seeker data.
 */
function _job_application_automation_create_job_seeker_table() {
  $database = \Drupal::database();
  $schema = $database->schema();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    // Check if table already exists
    if ($schema->tableExists('job_seeker')) {
      $logger->info('Job seeker table already exists, skipping creation.');
      return;
    }
    
    $table_schema = [
      'description' => 'Stores job seeker profile information.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
          'description' => 'Primary Key: Unique job seeker ID.',
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'The {users}.uid of the user this profile belongs to.',
        ],
        'resume_node_id' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Node ID of the original resume document.',
        ],
        'skills' => [
          'type' => 'text',
          'not null' => FALSE,
          'size' => 'big',
          'description' => 'JSON-encoded array of skills.',
        ],
        'experience_years' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Years of professional experience.',
        ],
        'target_companies' => [
          'type' => 'text',
          'not null' => FALSE,
          'size' => 'big',
          'description' => 'JSON-encoded array of target company node IDs.',
        ],
        'preferred_locations' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'JSON-encoded array of preferred job locations.',
        ],
        'job_titles' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'JSON-encoded array of target job titles.',
        ],
        'salary_expectation' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
          'description' => 'Expected salary range.',
        ],
        'availability' => [
          'type' => 'varchar',
          'length' => 50,
          'not null' => FALSE,
          'description' => 'Availability status (e.g., immediate, 2 weeks, etc.).',
        ],
        'linkedin_url' => [
          'type' => 'varchar',
          'length' => 512,
          'not null' => FALSE,
          'description' => 'LinkedIn profile URL.',
        ],
        'portfolio_url' => [
          'type' => 'varchar',
          'length' => 512,
          'not null' => FALSE,
          'description' => 'Portfolio or personal website URL.',
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Timestamp when the profile was created.',
        ],
        'changed' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Timestamp when the profile was last updated.',
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'uid' => ['uid'],
      ],
      'indexes' => [
        'created' => ['created'],
        'changed' => ['changed'],
      ],
    ];
    
    $schema->createTable('job_seeker', $table_schema);
    $logger->info('Job seeker table created successfully.');
  }
  catch (\Exception $e) {
    // Log error but don't fail installation
    $logger->warning('Could not create job_seeker table (may already exist): @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Implements hook_install().
 */
function job_application_automation_install() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    $logger->info('Starting Job Application Automation module installation...');
    
    // Create custom job_seeker table
    _job_application_automation_create_job_seeker_table();
    $logger->info('Job seeker custom table created.');
    
    // Check for partial installation state and warn about it
    _job_application_automation_check_partial_installation();
    
    // Ensure Profile module is enabled
    $module_handler = \Drupal::service('module_handler');
    if (!$module_handler->moduleExists('profile')) {
      \Drupal::service('module_installer')->install(['profile']);
      $logger->info('Profile module has been enabled.');
    }
    
    // Import profile configurations that may not have been imported automatically
    _job_application_automation_import_profile_configs();
    $logger->info('Profile configurations imported.');
    
    // Ensure critical profile fields exist programmatically
    _job_application_automation_ensure_profile_fields();
    $logger->info('Profile fields verified and created if needed.');
    
    // Create content types if they don't exist
    // This checks for existing types and only creates missing ones
    _job_application_automation_create_content_types();
    
    // Create the target companies profile field now that company content type exists
    _job_application_automation_create_target_companies_field();
    
    // Create and attach fields to content types
    _job_application_automation_create_content_type_fields();
    
    // Configure field displays (content types only - profile fields are handled by config)
    _job_application_automation_configure_displays();
    
    // Create administrative Views
    _job_application_automation_create_views();
    
    // Set default permissions
    _job_application_automation_set_permissions();
    
    // Final verification of installation completeness
    _job_application_automation_verify_installation_completeness();
    
    $messenger->addMessage(t('Job Application Automation module has been installed successfully. All content types, fields, and administrative views have been created.'));
    $logger->info('Job Application Automation module installation completed successfully.');
    
  }
  catch (Exception $e) {
    $messenger->addError(t('There was an error installing the Job Application Automation module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Installation error: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}

/**
 * Check for partial installation state and log warnings.
 * 
 * This function detects if there's a partially implemented module in production
 * and logs warnings about what will be created or updated during installation.
 */
function _job_application_automation_check_partial_installation() {
  $logger = \Drupal::logger('job_application_automation');
  $logger->info('INSTALLATION STATE CHECK: Analyzing existing components...');
  
  $existing_components = [];
  $missing_components = [];
  
  // Check content types
  $expected_content_types = ['company', 'job_posting', 'application', 'issue', 'tailored_resume'];
  foreach ($expected_content_types as $type) {
    if (NodeType::load($type)) {
      $existing_components['content_types'][] = $type;
      $logger->warning('PARTIAL INSTALLATION DETECTED: Content type "@type" already exists', ['@type' => $type]);
    } else {
      $missing_components['content_types'][] = $type;
    }
  }
  
  // Check profile type
  $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->load('job_seeker');
  if ($profile_type) {
    $existing_components['profile_types'][] = 'job_seeker';
    $logger->warning('PARTIAL INSTALLATION DETECTED: Profile type "job_seeker" already exists');
  } else {
    $missing_components['profile_types'][] = 'job_seeker';
  }
  
  // Check profile field configurations
  $field_storage_config_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $profile_field_storages = $field_storage_config_storage->loadByProperties(['entity_type' => 'profile']);
  $profile_fields_config = [];
  $profile_fields_missing_tables = [];
  
  $database = \Drupal::database();
  foreach ($profile_field_storages as $field_storage) {
    $field_name = $field_storage->getName();
    $table_name = 'profile__' . $field_name;
    $profile_fields_config[] = $field_name;
    
    if ($database->schema()->tableExists($table_name)) {
      $existing_components['profile_field_tables'][] = $field_name;
    } else {
      $profile_fields_missing_tables[] = $field_name;
      $missing_components['profile_field_tables'][] = $field_name;
      $logger->warning('PARTIAL INSTALLATION DETECTED: Profile field "@field" has config but missing database table "@table"', [
        '@field' => $field_name,
        '@table' => $table_name
      ]);
    }
  }
  
  // Check for any profile field instance configurations
  $profile_field_instances = \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->loadByProperties(['entity_type' => 'profile', 'bundle' => 'job_seeker']);
  
  foreach ($profile_field_instances as $field_instance) {
    $field_name = $field_instance->getName();
    $existing_components['profile_field_instances'][] = $field_name;
  }
  
  // Summary logging
  if (!empty($existing_components)) {
    $logger->warning('PARTIAL INSTALLATION STATE DETECTED - The following components already exist and will be preserved:');
    foreach ($existing_components as $component_type => $components) {
      $logger->warning('  @type: @list', [
        '@type' => strtoupper(str_replace('_', ' ', $component_type)),
        '@list' => implode(', ', $components)
      ]);
    }
  }
  
  if (!empty($missing_components)) {
    $logger->info('MISSING COMPONENTS - The following will be created during installation:');
    foreach ($missing_components as $component_type => $components) {
      $logger->info('  @type: @list', [
        '@type' => strtoupper(str_replace('_', ' ', $component_type)),
        '@list' => implode(', ', $components)
      ]);
    }
  }
  
  if (!empty($profile_fields_missing_tables)) {
    $logger->warning('DATABASE TABLE CREATION REQUIRED: @count profile field(s) have configurations but missing database tables. These will be created automatically.', [
      '@count' => count($profile_fields_missing_tables)
    ]);
  }
  
  if (empty($existing_components) && empty($missing_components)) {
    $logger->info('CLEAN INSTALLATION: No existing components detected. Proceeding with full installation.');
  }
}

/**
 * Implements hook_uninstall().
 */
function job_application_automation_uninstall() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    $logger->info('Starting Job Application Automation module uninstallation...');
    
    // Only remove module-specific configuration - NOT content or fields
    \Drupal::configFactory()->getEditable('job_application_automation.settings')->delete();
    
    // CRITICAL: Custom tables, content types and fields are NEVER deleted during uninstall
    // This preserves all user data, job applications, companies, and profile information
    // 
    // Protected custom tables:
    // - job_seeker: All job seeker profile data (skills, experience, preferences)
    //
    // Protected content types:
    // - company: All employer company data
    // - job_posting: All discovered job opportunities  
    // - application: All user job applications and status history
    // - issue: All support requests and system issues
    // - tailored_resume: All AI-generated resume content
    //
    // Protected user fields:
    // - field_resume_file: Primary resume uploads
    // - field_primary_resume_text: Extracted resume text
    // - field_profile_completeness: User profile completion data
    // - All other user profile fields (work auth, skills, etc.)
    //
    // Protected profile fields (job_seeker profile):
    // - field_profile_completeness: Profile completion tracking
    // - field_resume_file: Resume file uploads
    // - All job seeker profile data
    //
    // Manual cleanup (if desired):
    // To remove custom tables: Use database administration tools
    // To remove content types: Structure > Content types > Delete
    // To remove fields: Structure > Content types > Manage fields > Delete
    // To remove user fields: Configuration > Account settings > Manage fields > Delete
    
    $preserved_items = [
      'Custom Tables' => ['job_seeker'],
      'Content Types' => ['company', 'job_posting', 'application', 'issue', 'tailored_resume'],
      'User Fields' => ['field_resume_file', 'field_primary_resume_text', 'field_profile_completeness', 'field_work_authorization', 'field_professional_summary', 'field_skills_summary', 'field_experience_years'],
      'Profile Fields' => ['field_profile_completeness', 'field_resume_file'],
      'Views' => ['Job Applications Dashboard', 'Company Management', 'Job Discovery'],
      'Configuration' => ['Field displays', 'Form displays', 'Permissions'],
    ];
    
    $message_parts = ['Job Application Automation module has been uninstalled safely.'];
    $message_parts[] = 'ALL CONTENT AND FIELDS HAVE BEEN PRESERVED to prevent data loss.';
    
    foreach ($preserved_items as $category => $items) {
      $message_parts[] = $category . ': ' . implode(', ', $items);
    }
    
    $message_parts[] = 'To manually remove items: Go to Structure > Content types or Configuration > Account settings.';
    
    $messenger->addStatus(implode('<br>', $message_parts));
    $logger->info('Job Application Automation module uninstallation completed. All content and fields preserved.');
    
  }
  catch (Exception $e) {
    $messenger->addError(t('There was an error uninstalling the Job Application Automation module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Uninstallation error: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Create all required content types if they don't exist.
 * This function checks for existing content types and only creates missing ones.
 */
function _job_application_automation_create_content_types() {
  $content_types = [
    'company' => [
      'label' => 'Company',
      'description' => 'Employer companies for job application automation',
    ],
    'job_posting' => [
      'label' => 'Job Posting',
      'description' => 'Individual job opportunities discovered through scraping',
    ],
    'application' => [
      'label' => 'Application',
      'description' => 'User job applications and their status',
    ],
    'issue' => [
      'label' => 'Issue',
      'description' => 'Support requests and system issues requiring attention',
    ],
    'tailored_resume' => [
      'label' => 'Tailored Resume',
      'description' => 'AI-generated resumes tailored for specific job opportunities',
      'create_body' => TRUE,
    ],
  ];

  foreach ($content_types as $type => $info) {
    // Check if content type already exists
    $existing_type = NodeType::load($type);
    if (!$existing_type) {
      $node_type = NodeType::create([
        'type' => $type,
        'name' => $info['label'],
        'description' => $info['description'],
        'title_label' => 'Title',
        'create_body' => isset($info['create_body']) ? $info['create_body'] : FALSE,
        'promote' => FALSE,
        'sticky' => FALSE,
        'locked' => FALSE,
      ]);
      $node_type->save();
      
      \Drupal::logger('job_application_automation')->info('CREATED content type: @type (@label)', [
        '@type' => $type,
        '@label' => $info['label']
      ]);
    }
    else {
      \Drupal::logger('job_application_automation')->warning('SKIPPED content type creation: @type already exists (preserving existing configuration)', ['@type' => $type]);
      
      // Verify the existing content type has expected settings
      if ($existing_type->get('description') !== $info['description']) {
        \Drupal::logger('job_application_automation')->notice('Content type @type has different description than expected', ['@type' => $type]);
      }
    }
  }
}

/**
 * Create the target companies field programmatically.
 * 
 * This field is created programmatically instead of via config files
 * to ensure the company content type exists before the field is created.
 */
function _job_application_automation_create_target_companies_field() {
  $logger = \Drupal::logger('job_application_automation');
  
  // Ensure job_seeker profile type exists
  $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->load('job_seeker');
  if (!$profile_type) {
    $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->create([
      'id' => 'job_seeker',
      'label' => 'Job Seeker',
      'weight' => 0,
      'registration' => FALSE,
      'multiple' => FALSE,
    ]);
    $profile_type->save();
    $logger->info('Created job_seeker profile type.');
  }
  
  // Create field storage for target companies field
  $field_storage = FieldStorageConfig::loadByName('profile', 'field_target_companies');
  if (!$field_storage) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => 'field_target_companies',
      'entity_type' => 'profile',
      'type' => 'entity_reference',
      'cardinality' => -1, // Unlimited
      'settings' => [
        'target_type' => 'node',
      ],
    ]);
    $field_storage->save();
    $logger->info('Created field storage for field_target_companies.');
  }
  
  // Create field config on job_seeker profile
  $field_config = FieldConfig::loadByName('profile', 'job_seeker', 'field_target_companies');
  if (!$field_config) {
    $field_config = FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => 'job_seeker',
      'label' => t('Target Companies'),
      'description' => t('Companies you are interested in working for'),
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:node',
        'handler_settings' => [
          'target_bundles' => [
            'company' => 'company',
          ],
        ],
      ],
    ]);
    $field_config->save();
    $logger->info('Created field_target_companies field on job_seeker profile.');
    
    // Configure form display for the field
    $form_display = EntityFormDisplay::load('profile.job_seeker.default');
    if ($form_display && !$form_display->getComponent('field_target_companies')) {
      $form_display->setComponent('field_target_companies', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 17,
        'region' => 'content',
        'settings' => [
          'match_operator' => 'CONTAINS',
          'match_limit' => 10,
          'size' => 60,
          'placeholder' => 'Type company names...',
        ],
      ]);
      $form_display->save();
      $logger->info('Added field_target_companies to form display.');
    }
    
    // Configure view display for the field
    $view_display = EntityViewDisplay::load('profile.job_seeker.default');
    if ($view_display && !$view_display->getComponent('field_target_companies')) {
      $view_display->setComponent('field_target_companies', [
        'type' => 'entity_reference_label',
        'label' => 'above',
        'weight' => 17,
        'region' => 'content',
        'settings' => [
          'link' => TRUE,
        ],
      ]);
      $view_display->save();
      $logger->info('Added field_target_companies to view display.');
    }
  }
}

/**
 * Create and attach all fields to content types.
 */
function _job_application_automation_create_content_type_fields() {
  $field_definitions = _job_application_automation_get_field_definitions();
  
  foreach ($field_definitions as $entity_type => $bundles) {
    foreach ($bundles as $bundle => $fields) {
      foreach ($fields as $field_name => $field_config) {
        _job_application_automation_create_field($entity_type, $bundle, $field_name, $field_config);
      }
    }
  }
}

/**
 * Create user entity fields.
 * 
 * @deprecated This function is no longer used since all profile fields 
 * are now handled by the Profile module and config files.
 */
function _job_application_automation_create_user_fields() {
  // No longer needed - profile fields are handled by Profile module config
  \Drupal::logger('job_application_automation')->info('User field creation skipped - using Profile module instead.');
}

/**
 * Create a single field and attach it to an entity bundle.
 */
function _job_application_automation_create_field($entity_type, $bundle, $field_name, $field_config) {
  $logger = \Drupal::logger('job_application_automation');
  
  // Check if field storage exists
  $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);
  
  if (!$field_storage) {
    $storage_config = [
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'type' => $field_config['type'],
    ];
    
    // Add additional storage settings if specified
    if (isset($field_config['cardinality'])) {
      $storage_config['cardinality'] = $field_config['cardinality'];
    }
    if (isset($field_config['settings'])) {
      $storage_config['settings'] = $field_config['settings'];
    }
    
    try {
      $field_storage = FieldStorageConfig::create($storage_config);
      $field_storage->save();
      
      $logger->info('CREATED field storage: @field (@type) for @entity_type', [
        '@field' => $field_name,
        '@type' => $field_config['type'],
        '@entity_type' => $entity_type,
      ]);
    } catch (Exception $e) {
      $logger->error('FAILED to create field storage @field for @entity_type: @error', [
        '@field' => $field_name,
        '@entity_type' => $entity_type,
        '@error' => $e->getMessage()
      ]);
      return;
    }
  } else {
    $logger->warning('SKIPPED field storage creation: @field already exists for @entity_type (preserving existing)', [
      '@field' => $field_name,
      '@entity_type' => $entity_type,
    ]);
    
    // Check if the existing field storage has the expected type
    if ($field_storage->getType() !== $field_config['type']) {
      $logger->warning('Field storage @field has type "@existing_type" but expected "@expected_type"', [
        '@field' => $field_name,
        '@existing_type' => $field_storage->getType(),
        '@expected_type' => $field_config['type']
      ]);
    }
  }
  
  // Check if field config exists for this bundle
  $field_instance = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  
  if (!$field_instance) {
    $instance_config = [
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $field_config['label'],
    ];
    
    // Add additional instance settings
    if (isset($field_config['required'])) {
      $instance_config['required'] = $field_config['required'];
    }
    if (isset($field_config['description'])) {
      $instance_config['description'] = $field_config['description'];
    }
    if (isset($field_config['default_value'])) {
      $instance_config['default_value'] = $field_config['default_value'];
    }
    
    try {
      $field_instance = FieldConfig::create($instance_config);
      $field_instance->save();
      
      $logger->info('CREATED field instance: @field (@label) for @entity_type:@bundle', [
        '@field' => $field_name,
        '@label' => $field_config['label'],
        '@entity_type' => $entity_type,
        '@bundle' => $bundle,
      ]);
    } catch (Exception $e) {
      $logger->error('FAILED to create field instance @field for @entity_type:@bundle: @error', [
        '@field' => $field_name,
        '@entity_type' => $entity_type,
        '@bundle' => $bundle,
        '@error' => $e->getMessage()
      ]);
    }
  } else {
    $logger->warning('SKIPPED field instance creation: @field already exists for @entity_type:@bundle (preserving existing)', [
      '@field' => $field_name,
      '@entity_type' => $entity_type,
      '@bundle' => $bundle,
    ]);
    
    // Check if existing field has expected settings
    if ($field_instance->getLabel() !== $field_config['label']) {
      $logger->notice('Field instance @field has label "@existing_label" but expected "@expected_label"', [
        '@field' => $field_name,
        '@existing_label' => $field_instance->getLabel(),
        '@expected_label' => $field_config['label']
      ]);
    }
  }
  
  // Verify database table exists for this field (particularly important for file fields)
  if ($entity_type === 'profile' || $entity_type === 'user') {
    $table_name = $entity_type . '__' . $field_name;
    $database = \Drupal::database();
    
    if (!$database->schema()->tableExists($table_name)) {
      $logger->warning('Database table @table is missing for field @field - this may cause runtime errors', [
        '@table' => $table_name,
        '@field' => $field_name
      ]);
    }
  }
}

