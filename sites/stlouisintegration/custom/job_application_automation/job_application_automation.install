/**
 * Set default permissions for the module.
 */
function _job_application_automation_set_permissions() {
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  
  // Get the authenticated user role
  $authenticated_role = $role_storage->load('authenticated');
  
  if ($authenticated_role) {
    // Grant permissions to authenticated users
    $permissions = [
      'access user job applications',
      'edit own job application profile',
      'view own job application profile',
      'create application content',
      'edit own application content',
      'view application content',
      'create tailored_resume content',
      'edit own tailored_resume content',
      'view tailored_resume content',
      'create company content',
      'view company content',
      'create job_posting content',
      'view job_posting content',
      'access job discovery',
      'tailor resume',
      'access companies overview',
    ];
    
    foreach ($permissions as $permission) {
      try {
        $authenticated_role->grantPermission($permission);
      } catch (\Exception $e) {
        \Drupal::logger('job_application_automation')->warning('Could not grant permission @permission: @error', [
          '@permission' => $permission,
          '@error' => $e->getMessage(),
        ]);
      }
    }
    
    $authenticated_role->save();
    \Drupal::logger('job_application_automation')->info('Permissions granted to authenticated users.');
  }
}

/**
 * Update 8005: Grant permissions to authenticated users for job discovery functionality.
 */
function job_application_automation_update_8005() {
  _job_application_automation_set_permissions();
  return 'Permissions have been updated for authenticated users to access job discovery functionality.';
}

/**
 * Safely import profile configurations, checking for existing configs first.
 */
function _job_application_automation_import_profile_configs() {
  $config_factory = \Drupal::configFactory();
  $logger = \Drupal::logger('job_application_automation');
  
  // List of configuration files that should be imported
  $config_files = [
    'profile.type.job_seeker',
    'field.storage.profile.field_resume_file',
    'field.storage.profile.field_primary_resume_text',
    'field.storage.profile.field_professional_summary',
    'field.storage.profile.field_skills_summary',
    'field.storage.profile.field_work_authorization',
    'field.storage.profile.field_salary_expectation_min',
    'field.storage.profile.field_salary_expectation_max',
    'field.storage.profile.field_available_start_date',
    'field.storage.profile.field_remote_preference',
    'field.storage.profile.field_education_level',
    'field.storage.profile.field_relocation_willing',
    'field.storage.profile.field_references_available',
    'field.storage.profile.field_keywords_interested',
    'field.storage.profile.field_target_job_titles',
    'field.storage.profile.field_experience_years',
    'field.storage.profile.field_certifications',
    'field.storage.profile.field_portfolio_url',
    'field.storage.profile.field_linkedin_url',
    'field.storage.profile.field_github_url',
    'field.storage.profile.field_cover_letter_template',
    'field.storage.profile.field_target_companies',
    'field.storage.profile.field_ai_analysis_data',
    'field.storage.profile.field_profile_completeness',
    'field.storage.profile.field_last_profile_update',
    // Field instances
    'field.field.profile.job_seeker.field_resume_file',
    'field.field.profile.job_seeker.field_primary_resume_text',
    'field.field.profile.job_seeker.field_professional_summary',
    'field.field.profile.job_seeker.field_skills_summary',
    'field.field.profile.job_seeker.field_work_authorization',
    'field.field.profile.job_seeker.field_salary_expectation_min',
    'field.field.profile.job_seeker.field_salary_expectation_max',
    'field.field.profile.job_seeker.field_available_start_date',
    'field.field.profile.job_seeker.field_remote_preference',
    'field.field.profile.job_seeker.field_education_level',
    'field.field.profile.job_seeker.field_relocation_willing',
    'field.field.profile.job_seeker.field_references_available',
    'field.field.profile.job_seeker.field_keywords_interested',
    'field.field.profile.job_seeker.field_target_job_titles',
    'field.field.profile.job_seeker.field_experience_years',
    'field.field.profile.job_seeker.field_certifications',
    'field.field.profile.job_seeker.field_portfolio_url',
    'field.field.profile.job_seeker.field_linkedin_url',
    'field.field.profile.job_seeker.field_github_url',
    'field.field.profile.job_seeker.field_cover_letter_template',
    'field.field.profile.job_seeker.field_target_companies',
    'field.field.profile.job_seeker.field_ai_analysis_data',
    'field.field.profile.job_seeker.field_profile_completeness',
    'field.field.profile.job_seeker.field_last_profile_update',
    // Display configurations
    'core.entity_form_display.profile.job_seeker.default',
    'core.entity_view_display.profile.job_seeker.default',
  ];
  
  $skipped = 0;
  $imported = 0;
  
  foreach ($config_files as $config_name) {
    // Check if configuration already exists
    $existing_config = $config_factory->get($config_name);
    if (!$existing_config->isNew()) {
      $logger->info('Configuration @config already exists, skipping import.', ['@config' => $config_name]);
      $skipped++;
      continue;
    }
    
    // Configuration doesn't exist, it will be imported automatically by Drupal
    // during module installation from the config/install directory
    $logger->info('Configuration @config will be imported.', ['@config' => $config_name]);
    $imported++;
  }
  
  $logger->info('Profile configuration import completed. Imported: @imported, Skipped: @skipped', [
    '@imported' => $imported,
    '@skipped' => $skipped
  ]);
}

/**
 * Update 8004: Import Job Seeker profile configuration safely.
 */
function job_application_automation_update_8004() {
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    // Ensure Profile module is enabled
    $module_handler = \Drupal::service('module_handler');
    if (!$module_handler->moduleExists('profile')) {
      \Drupal::service('module_installer')->install(['profile']);
      $logger->info('Profile module has been enabled.');
    }
    
    // Import profile configurations from config/install directory
    $config_installer = \Drupal::service('config.installer');
    $storage = \Drupal::service('config.storage');
    $config_factory = \Drupal::configFactory();
    
    // Get the module path and config install directory
    $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'job_application_automation');
    $config_install_path = $module_path . '/config/install';
    
    if (!file_exists($config_install_path)) {
      throw new \Exception('Config install directory not found: ' . $config_install_path);
    }
    
    // Get all YAML files from config/install
    $config_files = glob($config_install_path . '/*.yml');
    $imported = 0;
    $skipped = 0;
    
    foreach ($config_files as $config_file) {
      $config_name = basename($config_file, '.yml');
      
      // Skip if not profile-related
      if (!preg_match('/^(profile\.|field\..*\.profile\.|core\.entity_.*display\.profile\.)/', $config_name)) {
        continue;
      }
      
      // Check if config already exists
      $existing_config = $config_factory->get($config_name);
      if (!$existing_config->isNew()) {
        $logger->info('Configuration @config already exists, skipping.', ['@config' => $config_name]);
        $skipped++;
        continue;
      }
      
      // Load config data from file
      $config_data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($config_file));
      
      // Create the configuration
      $config_factory->getEditable($config_name)
        ->setData($config_data)
        ->save();
      
      $logger->info('Imported configuration: @config', ['@config' => $config_name]);
      $imported++;
    }
    
    // Clear caches
    drupal_flush_all_caches();
    
    $logger->info('Profile configuration import completed. Imported: @imported, Skipped: @skipped', [
      '@imported' => $imported,
      '@skipped' => $skipped
    ]);
    
    return t('Job Seeker profile configuration imported. Imported: @imported, Skipped: @skipped', [
      '@imported' => $imported,
      '@skipped' => $skipped
    ]);
    
  } catch (\Exception $e) {
    $logger->error('Error importing profile configurations: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}
/**
 * Update 8006: Add missing body field to tailored_resume content type and configure display.
 */
function job_application_automation_update_8006() {
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    // Create body field for tailored_resume if it doesn't exist
    $field_config = FieldConfig::loadByName('node', 'tailored_resume', 'body');
    
    if (!$field_config) {
      // First ensure the body field storage exists for node entities (it should by default)
      $body_storage = FieldStorageConfig::loadByName('node', 'body');
      if (!$body_storage) {
        // This shouldn't happen, but create it if missing
        $body_storage = FieldStorageConfig::create([
          'field_name' => 'body',
          'entity_type' => 'node',
          'type' => 'text_with_summary',
        ]);
        $body_storage->save();
        $logger->info('Created body field storage for node entity.');
      }
      
      // Create the body field instance for tailored_resume
      $field_config = FieldConfig::create([
        'field_name' => 'body',
        'entity_type' => 'node',
        'bundle' => 'tailored_resume',
        'label' => 'Body',
        'description' => 'The tailored resume content',
        'required' => FALSE,
      ]);
      $field_config->save();
      
      $logger->info('Created body field for tailored_resume content type.');
    } else {
      $logger->info('Body field already exists for tailored_resume content type.');
    }
    
    // Configure the view display to show body field
    $view_display = EntityViewDisplay::load('node.tailored_resume.default');
    if ($view_display) {
      $view_display->setComponent('body', [
        'type' => 'text_default',
        'label' => 'above',
        'weight' => 0,
        'settings' => [],
        'third_party_settings' => [],
      ]);
      $view_display->save();
      $logger->info('Configured view display for tailored_resume body field.');
    }
    
    // Configure the form display to show body field
    $form_display = EntityFormDisplay::load('node.tailored_resume.default');
    if (!$form_display) {
      $form_display = EntityFormDisplay::create([
        'targetEntityType' => 'node',
        'bundle' => 'tailored_resume',
        'mode' => 'default',
        'status' => TRUE,
      ]);
    }
    
    $form_display->setComponent('body', [
      'type' => 'text_textarea_with_summary',
      'weight' => 0,
      'settings' => [
        'rows' => 10,
        'summary_rows' => 3,
        'placeholder' => 'Enter the tailored resume content...',
        'show_summary' => FALSE,
      ],
    ]);
    $form_display->save();
    $logger->info('Configured form display for tailored_resume body field.');
    
    return t('Body field has been added to tailored_resume content type and displays configured.');
    
  } catch (Exception $e) {
    $logger->error('Error adding body field to tailored_resume: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}

