/**
 * Update 8008: Migrate user fields to profile fields and fix field entity type mismatch.
 * 
 * This update handles the migration from user entity fields to profile entity fields
 * that was causing database table mismatch issues on production. It:
 * 1. Creates profile entities for users who have user field data
 * 2. Migrates user field data to corresponding profile fields
 * 3. Ensures all profile field database tables exist
 * 4. Preserves all existing user data during migration
 */
function job_application_automation_update_8008() {
  $logger = \Drupal::logger('job_application_automation');
  $logger->info('Starting user-to-profile field migration (Update 8008)...');
  
  // Ensure Profile module is enabled
  $module_handler = \Drupal::service('module_handler');
  if (!$module_handler->moduleExists('profile')) {
    \Drupal::service('module_installer')->install(['profile']);
    $logger->info('Profile module has been enabled.');
  }
  
  // Ensure job_seeker profile type exists and create missing field tables
  _job_application_automation_ensure_profile_fields();
  
  // Map of user fields to profile fields (same field names, different entity types)
  $field_mapping = [
    'field_ai_analysis_data',
    'field_available_start_date', 
    'field_certifications',
    'field_cover_letter_template',
    'field_education_level',
    'field_experience_years',
    'field_github_url',
    'field_keywords_interested',
    'field_last_profile_update',
    'field_linkedin_url',
    'field_notification_preferences',
    'field_portfolio_url', 
    'field_professional_summary',
    'field_profile_completeness',
    'field_references_available',
    'field_relocation_willing',
    'field_remote_preference',
    'field_resume_file',
    'field_salary_expectation_max',
    'field_salary_expectation_min',
    'field_skills_summary',
    'field_target_companies',
    'field_target_job_titles',
    'field_work_authorization'
  ];
  
  $migrated_users = 0;
  $errors = [];
  
  // Get all users who have any of the user fields with data
  $database = \Drupal::database();
  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
  
  // Get all users with profile data
  $users_with_data = [];
  foreach ($field_mapping as $field_name) {
    $user_table = 'user__' . $field_name;
    
    // Check if user field table exists
    if ($database->schema()->tableExists($user_table)) {
      $query = $database->select($user_table, 'uf')
        ->fields('uf', ['entity_id'])
        ->distinct();
      $user_ids = $query->execute()->fetchCol();
      
      foreach ($user_ids as $user_id) {
        if ($user_id > 0) { // Skip anonymous
          $users_with_data[$user_id] = $user_id;
        }
      }
    }
  }
  
  $logger->info('Found @count users with profile field data to migrate', ['@count' => count($users_with_data)]);
  
  foreach ($users_with_data as $user_id) {
    try {
      $user = $user_storage->load($user_id);
      if (!$user) continue;
      
      // Check if user already has a job_seeker profile
      $existing_profiles = $profile_storage->loadByProperties([
        'uid' => $user_id,
        'type' => 'job_seeker'
      ]);
      
      if (empty($existing_profiles)) {
        // Create new job_seeker profile for this user
        $profile = $profile_storage->create([
          'type' => 'job_seeker',
          'uid' => $user_id,
          'status' => 1,
        ]);
      } else {
        $profile = reset($existing_profiles);
      }
      
      // Migrate each field that has data
      $migrated_fields = 0;
      foreach ($field_mapping as $field_name) {
        if ($user->hasField($field_name) && !$user->get($field_name)->isEmpty()) {
          $field_value = $user->get($field_name)->getValue();
          
          if ($profile->hasField($field_name)) {
            $profile->set($field_name, $field_value);
            $migrated_fields++;
          }
        }
      }
      
      if ($migrated_fields > 0) {
        $profile->save();
        $migrated_users++;
        $logger->info('Migrated @fields fields from user @uid to job_seeker profile', [
          '@fields' => $migrated_fields,
          '@uid' => $user_id
        ]);
      }
      
    } catch (Exception $e) {
      $errors[] = "Error migrating user $user_id: " . $e->getMessage();
      $logger->error('Migration error for user @uid: @error', [
        '@uid' => $user_id,
        '@error' => $e->getMessage()
      ]);
    }
  }
  
  // Clear caches to ensure new profile data is recognized
  drupal_flush_all_caches();
  
  $logger->info('User-to-profile field migration completed. Migrated: @migrated, Errors: @errors', [
    '@migrated' => $migrated_users,
    '@errors' => count($errors)
  ]);
  
  if (!empty($errors)) {
    $logger->warning('Migration errors: @errors', ['@errors' => implode('; ', array_slice($errors, 0, 5))]);
  }
  
    return t('Successfully migrated user field data to profile fields for @count users.', ['@count' => $migrated_users]);
}

/**
 * Update 8009: Fix NumberWidget prefix/suffix configuration to resolve PHP 8.3+ warnings.
 * 
 * This update ensures all number field widgets have proper prefix and suffix keys
 * to prevent "Undefined array key" errors in Drupal\Core\Field\Plugin\Field\FieldWidget\NumberWidget.
 */
function job_application_automation_update_8009() {
  $logger = \Drupal::logger('job_application_automation');
  $logger->info('Starting NumberWidget configuration fix (Update 8009)...');
  
  try {
    // Load the job_seeker profile form display
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('profile.job_seeker.default');
    
    if (!$form_display) {
      $logger->error('Form display profile.job_seeker.default not found');
      return t('Error: Form display profile.job_seeker.default not found');
    }
    
    $updated_fields = 0;
    $number_fields = [
      'field_experience_years',
      'field_salary_expectation_min', 
      'field_salary_expectation_max',
      'field_profile_completeness'
    ];
    
    foreach ($number_fields as $field_name) {
      $component = $form_display->getComponent($field_name);
      
      if ($component && $component['type'] === 'number') {
        // Ensure prefix and suffix keys exist
        if (!isset($component['settings']['prefix'])) {
          $component['settings']['prefix'] = null;
        }
        if (!isset($component['settings']['suffix'])) {
          $component['settings']['suffix'] = null;
        }
        
        // Set specific values for certain fields
        if ($field_name === 'field_experience_years') {
          $component['settings']['suffix'] = ' years';
        } elseif (in_array($field_name, ['field_salary_expectation_min', 'field_salary_expectation_max'])) {
          $component['settings']['prefix'] = '$';
        }
        
        $form_display->setComponent($field_name, $component);
        $updated_fields++;
        
        $logger->info('Updated NumberWidget configuration for field: @field', ['@field' => $field_name]);
      }
    }
    
    if ($updated_fields > 0) {
      $form_display->save();
      
      // Clear relevant caches
      \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
      \Drupal::cache('render')->deleteAll();
      
      $logger->info('NumberWidget configuration update completed. Updated @count fields.', ['@count' => $updated_fields]);
      
      return t('Successfully updated NumberWidget configuration for @count fields to prevent PHP 8.3+ warnings.', ['@count' => $updated_fields]);
    } else {
      $logger->info('No NumberWidget fields found that needed updating.');
      return t('No NumberWidget fields required configuration updates.');
    }
    
  } catch (Exception $e) {
    $logger->error('Error updating NumberWidget configuration: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}/**
 * Ensures critical profile fields exist programmatically.
 * This function creates fields if they don't exist, ensuring the database
 * tables are properly created even if config import fails.
 */
function _job_application_automation_ensure_profile_fields() {
  $logger = \Drupal::logger('job_application_automation');
  
  // Ensure job_seeker profile type exists
  $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->load('job_seeker');
  if (!$profile_type) {
    $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->create([
      'id' => 'job_seeker',
      'label' => 'Job Seeker',
      'weight' => 0,
      'registration' => FALSE,
      'multiple' => FALSE,
    ]);
    $profile_type->save();
    $logger->info('Created job_seeker profile type.');
  }
  
  // After profile type creation, ensure all profile field storage definitions
  // have corresponding database tables. This fixes the field entity type mismatch
  // where configurations exist but database tables are missing.
  $field_storage_config_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $profile_field_storages = $field_storage_config_storage->loadByProperties(['entity_type' => 'profile']);
  
  $database = \Drupal::database();
  $created_tables = 0;
  
  foreach ($profile_field_storages as $field_storage) {
    $field_name = $field_storage->getName();
    $table_name = 'profile__' . $field_name;
    
    // Check if database table exists for this field
    if (!$database->schema()->tableExists($table_name)) {
      try {
        // Get field storage definition and create database table
        $field_storage_definition = $field_storage->getFieldStorageDefinition();
        
        // Use entity definition update manager to create the missing table
        $update_manager = \Drupal::entityDefinitionUpdateManager();
        $update_manager->installFieldStorageDefinition($field_name, 'profile', 'profile', $field_storage_definition);
        
        $logger->info('Created database table for profile field: @field_name', ['@field_name' => $field_name]);
        $created_tables++;
      } catch (Exception $e) {
        $logger->error('Failed to create database table for profile field @field_name: @error', [
          '@field_name' => $field_name,
          '@error' => $e->getMessage()
        ]);
      }
    }
  }
  
  if ($created_tables > 0) {
    $logger->info('Successfully created @count profile field database tables.', ['@count' => $created_tables]);
  } else {
    $logger->info('All profile field database tables already exist.');
  }
  
  // Define critical profile fields that must exist programmatically
  // (This is a fallback in case config import doesn't work properly)
  $profile_fields = [
    'field_profile_completeness' => [
      'type' => 'integer',
      'label' => 'Profile Completeness',
      'description' => 'Profile completion percentage (0-100)',
      'settings' => [
        'min' => 0,
        'max' => 100,
        'prefix' => '',
        'suffix' => '%',
      ],
      'default_value' => [['value' => 0]],
    ],
  ];
  
  foreach ($profile_fields as $field_name => $field_config) {
    // Check if field storage exists
    $field_storage = FieldStorageConfig::loadByName('profile', $field_name);
    if (!$field_storage) {
      // Create field storage
      $field_storage = FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'profile',
        'type' => $field_config['type'],
        'settings' => $field_config['settings'] ?? [],
        'cardinality' => 1,
      ]);
      $field_storage->save();
      $logger->info('Created field storage for @field', ['@field' => $field_name]);
    }
    
    // Check if field instance exists
    $field = FieldConfig::loadByName('profile', 'job_seeker', $field_name);
    if (!$field) {
      // Create field instance
      $field = FieldConfig::create([
        'field_storage' => $field_storage,
        'bundle' => 'job_seeker',
        'label' => $field_config['label'],
        'description' => $field_config['description'] ?? '',
        'required' => $field_config['required'] ?? FALSE,
        'default_value' => $field_config['default_value'] ?? [],
        'settings' => $field_config['settings'] ?? [],
      ]);
      $field->save();
      $logger->info('Created field instance for @field on job_seeker profile', ['@field' => $field_name]);
      
      // Ensure database table is created
      \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
      \Drupal::entityDefinitionUpdateManager()->applyUpdates();
      $logger->info('Applied entity updates to create database table for @field', ['@field' => $field_name]);
    }
  }
}

/**
 * Verify installation completeness and log final status.
 * 
 * This function performs a final check to ensure all components were created
 * successfully and logs the final installation status.
 */
function _job_application_automation_verify_installation_completeness() {
  $logger = \Drupal::logger('job_application_automation');
  $logger->info('INSTALLATION VERIFICATION: Checking completeness...');
  
  $verification_passed = TRUE;
  $issues = [];
  
  // Verify content types
  $expected_content_types = ['company', 'job_posting', 'application', 'issue', 'tailored_resume'];
  foreach ($expected_content_types as $type) {
    if (!NodeType::load($type)) {
      $verification_passed = FALSE;
      $issues[] = "Content type '$type' was not created";
      $logger->error('VERIFICATION FAILED: Content type "@type" is missing', ['@type' => $type]);
    }
  }
  
  // Verify profile type
  $profile_type = \Drupal::entityTypeManager()->getStorage('profile_type')->load('job_seeker');
  if (!$profile_type) {
    $verification_passed = FALSE;
    $issues[] = "Profile type 'job_seeker' was not created";
    $logger->error('VERIFICATION FAILED: Profile type "job_seeker" is missing');
  }
  
  // Verify profile fields and database tables
  $field_storage_config_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $profile_field_storages = $field_storage_config_storage->loadByProperties(['entity_type' => 'profile']);
  
  $database = \Drupal::database();
  $field_count = 0;
  $table_count = 0;
  
  foreach ($profile_field_storages as $field_storage) {
    $field_name = $field_storage->getName();
    $table_name = 'profile__' . $field_name;
    $field_count++;
    
    if ($database->schema()->tableExists($table_name)) {
      $table_count++;
    } else {
      $verification_passed = FALSE;
      $issues[] = "Database table '$table_name' for profile field '$field_name' is missing";
      $logger->error('VERIFICATION FAILED: Database table "@table" for profile field "@field" is missing', [
        '@table' => $table_name,
        '@field' => $field_name
      ]);
    }
  }
  
  // Verify critical profile field instance
  $profile_completeness_field = \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->load('profile.job_seeker.field_profile_completeness');
  
  if (!$profile_completeness_field) {
    $verification_passed = FALSE;
    $issues[] = "Critical field 'field_profile_completeness' instance is missing";
    $logger->error('VERIFICATION FAILED: Critical field "field_profile_completeness" instance is missing');
  }
  
  // Log final status
  if ($verification_passed) {
    $logger->info('INSTALLATION VERIFICATION SUCCESSFUL: All components created successfully');
    $logger->info('  - Content types: @count created', ['@count' => count($expected_content_types)]);
    $logger->info('  - Profile type: job_seeker created');
    $logger->info('  - Profile fields: @field_count configurations with @table_count database tables', [
      '@field_count' => $field_count,
      '@table_count' => $table_count
    ]);
    
    // Special verification for the production issue we fixed
    if ($database->schema()->tableExists('profile__field_profile_completeness')) {
      $logger->info('PRODUCTION ISSUE RESOLVED: profile__field_profile_completeness table exists and resume upload should work');
    }
    
  } else {
    $logger->error('INSTALLATION VERIFICATION FAILED: @count issues detected:', ['@count' => count($issues)]);
    foreach ($issues as $issue) {
      $logger->error('  - @issue', ['@issue' => $issue]);
    }
    
    // Don't throw exception, but log the issues for manual resolution
    $logger->warning('Installation completed with issues. Manual review recommended.');
  }
}
