/**
 * Add extracted_text column to jobhunter_job_seeker_resumes table.
 */
function job_hunter_update_9001() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_job_seeker_resumes')) {
    if (!$schema->fieldExists('jobhunter_job_seeker_resumes', 'extracted_text')) {
      $spec = [
        'type' => 'text',
        'size' => 'big',
        'description' => 'Extracted text from resume file',
      ];
      $schema->addField('jobhunter_job_seeker_resumes', 'extracted_text', $spec);
      return t('Added extracted_text column to jobhunter_job_seeker_resumes table.');
    }
  }
  return t('No update needed - extracted_text column already exists.');
}

/**
 * Add JSON storage columns to job_hunter_job_requirements for job tailoring workflow.
 */
function job_hunter_update_9002() {
  $schema = \Drupal::database()->schema();
  $messages = [];
  
  if (!$schema->tableExists('job_hunter_job_requirements')) {
    return t('Table job_hunter_job_requirements does not exist.');
  }
  
  $new_fields = [
    'raw_posting_text' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Original pasted job posting text',
    ],
    'extracted_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'AI-extracted structured job data',
    ],
    'skills_required_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Must-have and nice-to-have skills',
    ],
    'keywords_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Important keywords from posting',
    ],
    'source_platform' => [
      'type' => 'varchar',
      'length' => 100,
      'description' => 'linkedin, indeed, company_site, etc.',
    ],
    'ai_extraction_status' => [
      'type' => 'varchar',
      'length' => 32,
      'default' => 'pending',
      'description' => 'pending, completed, failed',
    ],
  ];
  
  foreach ($new_fields as $field_name => $spec) {
    if (!$schema->fieldExists('job_hunter_job_requirements', $field_name)) {
      $schema->addField('job_hunter_job_requirements', $field_name, $spec);
      $messages[] = $field_name;
    }
  }
  
  if (empty($messages)) {
    return t('No update needed - all JSON columns already exist.');
  }
  
  return t('Added columns to job_hunter_job_requirements: @columns', [
    '@columns' => implode(', ', $messages),
  ]);
}

/**
 * Create job_hunter_tailored_resumes table for user-specific tailored resumes.
 */
function job_hunter_update_9003() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('job_hunter_tailored_resumes')) {
    return t('Table job_hunter_tailored_resumes already exists.');
  }
  
  _job_hunter_create_tailored_resumes_table();
  
  return t('Created job_hunter_tailored_resumes table.');
}

/**
 * Create job_hunter_tailored_resumes table.
 */
function _job_hunter_create_tailored_resumes_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('job_hunter_tailored_resumes')) {
    return;
  }
  
  $table_schema = [
    'description' => 'User-specific tailored resumes for job requirements.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'not null' => TRUE, 'description' => 'User ID'],
      'job_id' => ['type' => 'int', 'not null' => TRUE, 'description' => 'Job requirement ID'],
      'tailored_resume_json' => ['type' => 'text', 'size' => 'big', 'description' => 'AI-generated tailored resume JSON'],
      'tailoring_status' => ['type' => 'varchar', 'length' => 32, 'default' => 'pending', 'description' => 'pending, completed, failed'],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['user_job' => ['uid', 'job_id']],
    'indexes' => [
      'uid' => ['uid'],
      'job_id' => ['job_id'],
    ],
  ];
  
  $schema->createTable('job_hunter_tailored_resumes', $table_schema);
}

/**
 * Add pdf_path column to job_hunter_tailored_resumes table.
 */
function job_hunter_update_9008() {
  $schema = \Drupal::database()->schema();
  
  if (!$schema->fieldExists('job_hunter_tailored_resumes', 'pdf_path')) {
    $schema->addField('job_hunter_tailored_resumes', 'pdf_path', [
      'type' => 'varchar',
      'length' => 512,
      'description' => 'Path to generated PDF file',
    ]);
  }
  
  if (!$schema->fieldExists('job_hunter_tailored_resumes', 'pdf_generated')) {
    $schema->addField('job_hunter_tailored_resumes', 'pdf_generated', [
      'type' => 'int',
      'default' => 0,
      'description' => 'Timestamp when PDF was generated',
    ]);
  }
  
  return t('Added pdf_path and pdf_generated columns to job_hunter_tailored_resumes.');
}

/**
 * Create job_hunter_pdf_history table to track all generated PDFs.
 */
function job_hunter_update_9009() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('job_hunter_pdf_history')) {
    return t('Table job_hunter_pdf_history already exists.');
  }
  
  $table_schema = [
    'description' => 'History of generated resume PDFs.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'not null' => TRUE, 'description' => 'User ID'],
      'job_id' => ['type' => 'int', 'not null' => TRUE, 'description' => 'Job requirement ID'],
      'filename' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'filepath' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE],
      'filesize' => ['type' => 'int', 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid' => ['uid'],
      'job_id' => ['job_id'],
      'uid_job' => ['uid', 'job_id'],
    ],
  ];
  
  $schema->createTable('job_hunter_pdf_history', $table_schema);
  
  return t('Created job_hunter_pdf_history table.');
}

/**
 * Add potential_duplicates_json column for duplicate detection.
 */
function job_hunter_update_9010() {
  $schema = \Drupal::database()->schema();
  
  if (!$schema->tableExists('job_hunter_job_requirements')) {
    return t('Table job_hunter_job_requirements does not exist.');
  }
  
  if ($schema->fieldExists('job_hunter_job_requirements', 'potential_duplicates_json')) {
    return t('Column potential_duplicates_json already exists.');
  }
  
  $schema->addField('job_hunter_job_requirements', 'potential_duplicates_json', [
    'type' => 'text',
    'size' => 'medium',
    'description' => 'JSON array of potential duplicate job IDs with similarity scores',
  ]);
  
  return t('Added potential_duplicates_json column to job_hunter_job_requirements.');
}
