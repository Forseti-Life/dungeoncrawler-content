<?php

/**
 * @file
 * Contains professional_website_content.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function professional_website_content_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the professional_website_content module.
    case 'help.page.professional_website_content':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Manages professional website content including About Us, Services, Industry pages, and Case Studies based on resume data.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function professional_website_content_theme() {
  return [
    'services_page' => [
      'variables' => [
        'services' => [],
        'industries' => [],
      ],
      'template' => 'services-page',
    ],
    'industry_page' => [
      'variables' => [
        'industry_name' => '',
        'industry_data' => [],
        'case_studies' => [],
      ],
      'template' => 'industry-page',
    ],
    'case_study' => [
      'variables' => [
        'title' => '',
        'client' => '',
        'industry' => '',
        'challenge' => '',
        'solution' => '',
        'results' => '',
        'metrics' => [],
      ],
      'template' => 'case-study',
    ],
    'professional_navigation_menu' => [
      'variables' => [
        'menu_items' => [],
      ],
      'template' => 'professional-navigation-menu',
    ],
    'professional_services_overview' => [
      'variables' => [
        'overview_sections' => [],
      ],
      'template' => 'professional-services-overview',
    ],
    'professional_footer' => [
      'variables' => [
        'footer_data' => [],
      ],
      'template' => 'professional-footer',
    ],
  ];
}