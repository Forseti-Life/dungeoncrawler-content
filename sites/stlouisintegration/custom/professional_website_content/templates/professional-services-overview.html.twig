{#
/**
 * @file
 * Default theme implementation for Professional Services Overview block.
 *
 * Available variables:
 * - overview_sections: Array of service overview sections with:
 *   - title: Section title
 *   - description: Section description
 *   - url: URL object for the section link
 *   - icon_class: Font Awesome icon class
 *   - button_text: Text for the action button
 *   - color_scheme: Bootstrap color scheme (primary, success, info, etc.)
 */
#}

<div class="professional-services-overview-compact">
  <div class="container">
    <div class="row g-3">
      {% for section in overview_sections %}
        <div class="col-lg-4 col-md-4">
          <div class="service-compact-card text-center">
            <div class="service-compact-icon">
              <i class="{{ section.icon_class }}"></i>
            </div>
            <h4 class="service-compact-title">{{ section.title }}</h4>
            <a href="{{ section.url }}" class="btn btn-{{ section.color_scheme }} btn-sm">
              {{ section.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.professional-services-overview-compact {
  padding: 1.5rem 0;
  background: transparent;
}

.service-compact-card {
  padding: 1rem;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 8px;
  border: 1px solid rgba(100, 181, 246, 0.2);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.service-compact-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  border-color: rgba(100, 181, 246, 0.4);
}

.service-compact-icon {
  margin-bottom: 0.75rem;
}

.service-compact-icon i {
  font-size: 1.5rem;
  color: #64b5f6;
}

.service-compact-title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: #ffffff;
}

.btn-sm {
  padding: 0.375rem 0.75rem;
  font-size: 0.8rem;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(45deg, #0d6efd, #64b5f6);
}

.btn-success {
  background: linear-gradient(45deg, #198754, #20c997);
}

.btn-info {
  background: linear-gradient(45deg, #0dcaf0, #64b5f6);
}

.btn-sm:hover {
  transform: scale(1.05);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

@media (max-width: 768px) {
  .professional-services-overview-compact {
    padding: 1rem 0;
  }
  
  .service-compact-icon i {
    font-size: 1.25rem;
  }
  
  .service-compact-title {
    font-size: 0.9rem;
  }
}
</style>