{#
/**
 * @file
 * Default theme implementation for Professional Footer block.
 *
 * Available variables:
 * - footer_data: Array containing all footer sections data
 */
#}

<div class="professional-footer-wrapper">
  <div class="container">
    {# Hero Section #}
    <div class="footer-hero-section text-center mb-5">
      <h2 class="footer-hero-title">{{ footer_data.hero_section.company_name }}</h2>
      <p class="footer-hero-tagline">{{ footer_data.hero_section.tagline }}</p>
    </div>

    {# Call-to-Action Section #}
    <div class="footer-cta-section">
      <div class="row">
        {% for cta in footer_data.cta_sections %}
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="cta-card">
              <div class="cta-icon">
                <i class="{{ cta.icon_class }}"></i>
              </div>
              <h4>{{ cta.title }}</h4>
              <p>{{ cta.description }}</p>
              <a href="{{ cta.url }}" class="btn btn-{{ cta.color_scheme }}">{{ cta.button_text }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {# Main Footer Content #}
    <div class="footer-main-content">
      <div class="row">
        {# Company Information Column #}
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="company-info">
            <div class="company-name">{{ footer_data.company_info.name }}</div>
            <div class="company-tagline">{{ footer_data.company_info.tagline }}</div>
            <p>{{ footer_data.company_info.description }}</p>
            
            {# Social Media Links #}
            <div class="social-links">
              {% for social in footer_data.company_info.social_links %}
                <a href="{{ social.url }}" class="social-link" title="{{ social.title }}" target="_blank" rel="noopener">
                  {% if social.icon == 'linkedin' %}
                    <svg viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  {% elseif social.icon == 'github' %}
                    <svg viewBox="0 0 24 24">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                  {% endif %}
                </a>
              {% endfor %}
            </div>
          </div>
        </div>

        {# Industries Column #}
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="footer-links">
            <h5>{{ footer_data.industries_links.title }}</h5>
            <ul>
              {% for link in footer_data.industries_links.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </div>

        {# Company Info Column #}
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="company-info">
            <h5>Company Information</h5>
            <p class="copyright-text">
              &copy; {{ footer_data.company_info.copyright_year }} {{ footer_data.company_info.name }}. All rights reserved.
            </p>
            <div class="legal-links-inline">
              {% for link in footer_data.company_info.legal_links %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </div>
            <p class="company-tagline">
              {{ footer_data.company_info.tagline }}
            </p>
          </div>
        </div>

      </div>
    </div>

    {# Footer Bottom Section #}
    <div class="footer-bottom">
      <div class="row">
        <div class="col-12">
          {# Content removed - now handled by Company Info column above #}
        </div>
      </div>
    </div>
  </div>
</div>