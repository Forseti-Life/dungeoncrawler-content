<?php

use Drupal\node\Entity\Node;
use Drupal\resume_tailoring\ResumeTailoringManager;

/**
 * Implements hook_entity_insert().
 */
function resume_tailoring_entity_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  // Only act on Job Posting nodes.
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'job_posting') {
    // Fetch the Original Resume node.
    $resume_nodes = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties(['type' => 'resume', 'title' => 'Original Resume']);
    $original_resume = reset($resume_nodes);
    if ($original_resume) {
      // Get job posting fields.
      $job_title = $entity->get('field_job_title')->value;
      $company_ref = $entity->get('field_company_ref')->entity;
      $company = $company_ref ? $company_ref->getTitle() : '';
      $job_description = $entity->get('field_job_description')->value;
      $resume_text = $original_resume->get('body')->value;

      // Generate tailored resume using service.
      /** @var \Drupal\resume_tailoring\ResumeTailoringManager $manager */
      $manager = \Drupal::service('resume_tailoring.manager');
      $tailored_resume = $manager->generateTailoredResume($resume_text, $job_title, $company, $job_description);

      // Save tailored resume to the job posting node.
      $entity->set('field_tailored_resume', $tailored_resume);
      $entity->save();
    }
  }
}

