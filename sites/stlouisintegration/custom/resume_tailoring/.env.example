# Resume Tailoring Configuration

# Export format (pdf, docx)
RESUME_TAILORING_EXPORT_FORMAT=pdf

# Maximum number of resume versions to keep
RESUME_TAILORING_MAX_VERSIONS=5

# Enable AI-powered suggestions
RESUME_TAILORING_ENABLE_AI=false

# API credentials (if using AI)
# RESUME_TAILORING_API_KEY=YOUR_API_KEY

# Export directory (relative to Drupal root)
RESUME_TAILORING_EXPORT_DIR=sites/default/files/resumes
