<?php

/**
 * @file
 * Install, update and uninstall functions for the Resume Tailoring module.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_install().
 */
function resume_tailoring_install() {
  // Create the resume content type.
  _resume_tailoring_create_resume_content_type();
  
  // Create the tailored resume content type.
  _resume_tailoring_create_tailored_resume_content_type();

  // Ensure job_posting content type exists before adding field.
  _resume_tailoring_ensure_job_posting_content_type();

  // Add the tailored resume field to job_posting content type.
  _resume_tailoring_add_field_to_job_posting();
  
  // Set up default permissions for authenticated users.
  _resume_tailoring_setup_permissions();
}

/**
 * Implements hook_uninstall().
 */
function resume_tailoring_uninstall() {
  // Delete content types if no nodes exist.
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  
  // Check for resume nodes.
  $resume_nodes = $node_storage->getQuery()
    ->condition('type', 'resume')
    ->accessCheck(FALSE)
    ->count()
    ->execute();
    
  if ($resume_nodes == 0) {
    $resume_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('resume');
    if ($resume_type) {
      $resume_type->delete();
      \Drupal::logger('resume_tailoring')->notice('Deleted resume content type.');
    }
  }
  
  // Check for tailored_resume nodes.
  $tailored_resume_nodes = $node_storage->getQuery()
    ->condition('type', 'tailored_resume')
    ->accessCheck(FALSE)
    ->count()
    ->execute();
    
  if ($tailored_resume_nodes == 0) {
    $tailored_resume_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('tailored_resume');
    if ($tailored_resume_type) {
      $tailored_resume_type->delete();
      \Drupal::logger('resume_tailoring')->notice('Deleted tailored_resume content type.');
    }
  }
}

/**
 * Create the tailored_resume content type.
 */
function _resume_tailoring_create_tailored_resume_content_type() {
  // Check if tailored_resume content type already exists.
  $content_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('tailored_resume');
  if ($content_type) {
    \Drupal::logger('resume_tailoring')->notice('Tailored_resume content type already exists.');
    return;
  }

  // Create tailored_resume content type.
  $tailored_resume_type = NodeType::create([
    'type' => 'tailored_resume',
    'name' => 'Tailored Resume',
    'description' => 'A resume tailored for a specific job posting.',
    'has_title' => TRUE,
    'title_label' => 'Resume Title',
    'display_submitted' => FALSE,
    'new_revision' => TRUE,
    'preview_mode' => DRUPAL_OPTIONAL,
    'help' => 'This resume has been specifically tailored for a job posting using AI.',
  ]);
  $tailored_resume_type->save();

  // Add body field to tailored_resume content type.
  $body_field = FieldConfig::create([
    'field_name' => 'body',
    'entity_type' => 'node',
    'bundle' => 'tailored_resume',
    'label' => t('Tailored Resume Content'),
    'description' => t('The tailored resume content generated by AI.'),
    'required' => TRUE,
  ]);
  $body_field->save();

  // Create job_posting reference field storage if it doesn't exist.
  $job_ref_storage = FieldStorageConfig::loadByName('node', 'field_job_posting_ref');
  if (!$job_ref_storage) {
    $job_ref_storage = FieldStorageConfig::create([
      'field_name' => 'field_job_posting_ref',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'node',
      ],
    ]);
    $job_ref_storage->save();
  }

  // Create job_posting reference field config if it doesn't exist.
  $job_ref_field = FieldConfig::loadByName('node', 'tailored_resume', 'field_job_posting_ref');
  if (!$job_ref_field) {
    $job_ref_field = FieldConfig::create([
      'field_storage' => $job_ref_storage,
      'bundle' => 'tailored_resume',
      'label' => t('Job Posting'),
      'description' => t('The job posting this resume is tailored for.'),
      'required' => TRUE,
      'settings' => [
        'handler' => 'default:node',
        'handler_settings' => [
          'target_bundles' => ['job_posting'],
        ],
      ],
    ]);
    $job_ref_field->save();
  }

  // Create original resume reference field storage if it doesn't exist.
  $resume_ref_storage = FieldStorageConfig::loadByName('node', 'field_original_resume_ref');
  if (!$resume_ref_storage) {
    $resume_ref_storage = FieldStorageConfig::create([
      'field_name' => 'field_original_resume_ref',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'node',
      ],
    ]);
    $resume_ref_storage->save();
  }

  // Create original resume reference field config if it doesn't exist.
  $resume_ref_field = FieldConfig::loadByName('node', 'tailored_resume', 'field_original_resume_ref');
  if (!$resume_ref_field) {
    $resume_ref_field = FieldConfig::create([
      'field_storage' => $resume_ref_storage,
      'bundle' => 'tailored_resume',
      'label' => t('Original Resume'),
      'description' => t('The original resume that was used as the source.'),
      'required' => TRUE,
      'settings' => [
        'handler' => 'default:node',
        'handler_settings' => [
          'target_bundles' => ['resume'],
        ],
      ],
    ]);
    $resume_ref_field->save();
  }

  // Create status field storage if it doesn't exist.
  $status_storage = FieldStorageConfig::loadByName('node', 'field_tailoring_status');
  if (!$status_storage) {
    $status_storage = FieldStorageConfig::create([
      'field_name' => 'field_tailoring_status',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'pending' => t('Pending Generation'),
          'generating' => t('Generating'),
          'completed' => t('Completed'),
          'error' => t('Generation Error'),
        ],
      ],
    ]);
    $status_storage->save();
  }

  // Create status field config if it doesn't exist.
  $status_field = FieldConfig::loadByName('node', 'tailored_resume', 'field_tailoring_status');
  if (!$status_field) {
    $status_field = FieldConfig::create([
      'field_storage' => $status_storage,
      'bundle' => 'tailored_resume',
      'label' => t('Tailoring Status'),
      'description' => t('Current status of the resume tailoring process.'),
      'required' => TRUE,
      'default_value' => [['value' => 'pending']],
    ]);
    $status_field->save();
  }

  \Drupal::logger('resume_tailoring')->notice('Created tailored_resume content type with all fields.');
}

/**
 * Create the resume content type.
 */
function _resume_tailoring_create_resume_content_type() {
  // Check if resume content type already exists.
  $content_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('resume');
  if ($content_type) {
    \Drupal::logger('resume_tailoring')->notice('Resume content type already exists.');
  } else {
    // Create resume content type.
    $resume_type = NodeType::create([
      'type' => 'resume',
      'name' => 'Resume',
      'description' => 'Your original comprehensive resume.',
      'has_title' => TRUE,
      'title_label' => 'Resume Title',
      'display_submitted' => FALSE,
      'new_revision' => TRUE,
      'preview_mode' => DRUPAL_OPTIONAL,
      'help' => 'Create your master resume with comprehensive details. Include ALL your experience, skills, achievements, and education. This comprehensive resume will be used as the source material for AI-powered tailoring to specific job postings. The more detailed and complete your master resume, the better the AI can tailor it for specific opportunities.',
    ]);
    $resume_type->save();
    
    \Drupal::logger('resume_tailoring')->notice('Created resume content type.');
  }

  // Check if body field already exists on resume content type.
  $body_field = FieldConfig::loadByName('node', 'resume', 'body');
  if (!$body_field) {
    // Add body field to resume content type.
    $body_field = FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'resume',
      'label' => t('Resume Content'),
      'description' => t('Your comprehensive resume content. Include all experience, skills, achievements, and education.'),
      'required' => TRUE,
    ]);
    $body_field->save();
    
    \Drupal::logger('resume_tailoring')->notice('Added body field to resume content type.');
  } else {
    \Drupal::logger('resume_tailoring')->notice('Body field already exists on resume content type.');
  }
}

/**
 * Add tailored resume field to job_posting content type.
 */
/**
 * Ensure job_posting content type exists.
 */
function _resume_tailoring_ensure_job_posting_content_type() {
  // Check if job_posting content type already exists.
  $content_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('job_posting');
  if (!$content_type) {
    // Create job_posting content type.
    $job_posting_type = NodeType::create([
      'type' => 'job_posting',
      'name' => 'Job Posting',
      'description' => 'Individual job opportunities for resume tailoring.',
      'has_title' => TRUE,
      'title_label' => 'Job Title',
      'display_submitted' => FALSE,
      'new_revision' => TRUE,
      'preview_mode' => DRUPAL_OPTIONAL,
      'help' => 'Create a job posting to generate tailored resumes.',
    ]);
    $job_posting_type->save();
    
    \Drupal::logger('resume_tailoring')->notice('Created job_posting content type.');
  } else {
    \Drupal::logger('resume_tailoring')->notice('job_posting content type already exists.');
  }
}

function _resume_tailoring_add_field_to_job_posting() {
  // Check if field storage already exists.
  $field_storage = FieldStorageConfig::loadByName('node', 'field_tailored_resume');
  if (!$field_storage) {
    // Create field storage for tailored resume field.
    $field_storage = FieldStorageConfig::create([
      'field_name' => 'field_tailored_resume',
      'entity_type' => 'node',
      'type' => 'text_long',
      'cardinality' => 1,
    ]);
    $field_storage->save();
  }

  // Check if field config already exists on job_posting.
  $field_config = FieldConfig::loadByName('node', 'job_posting', 'field_tailored_resume');
  if (!$field_config) {
    // Add field to job_posting content type.
    $field_config = FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => 'job_posting',
      'label' => t('Tailored Resume'),
      'description' => t('The automatically generated tailored resume for this job posting.'),
      'required' => FALSE,
    ]);
    $field_config->save();
    
    \Drupal::logger('resume_tailoring')->notice('Added field_tailored_resume to job_posting content type.');
  } else {
    \Drupal::logger('resume_tailoring')->notice('field_tailored_resume already exists on job_posting content type.');
  }
}

/**
 * Update 9001: Add body field to resume content type.
 */
function resume_tailoring_update_9001() {
  // Check if body field already exists.
  $field_config = FieldConfig::loadByName('node', 'resume', 'body');
  if (!$field_config) {
    // Add body field to resume content type.
    $body_field = FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'resume',
      'label' => t('Resume Content'),
      'description' => t('The main content of your resume.'),
      'required' => TRUE,
    ]);
    $body_field->save();
    
    return t('Added body field to resume content type.');
  }
  
  return t('Body field already exists on resume content type.');
}

/**
 * Update 9002: Create tailored_resume content type.
 */
function resume_tailoring_update_9002() {
  _resume_tailoring_create_tailored_resume_content_type();
  return t('Created tailored_resume content type with all required fields.');
}

/**
 * Set up default permissions for resume tailoring.
 */
function _resume_tailoring_setup_permissions() {
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  
  // Grant permissions to authenticated users.
  $authenticated_role = $role_storage->load('authenticated');
  if ($authenticated_role) {
    $authenticated_role->grantPermission('access resume tailoring');
    $authenticated_role->grantPermission('create tailored resumes');
    $authenticated_role->grantPermission('view own tailored resumes');
    $authenticated_role->save();
    \Drupal::logger('resume_tailoring')->notice('Granted resume tailoring permissions to authenticated users.');
  }
  
  // Grant admin permissions to administrators.
  $admin_role = $role_storage->load('administrator');
  if ($admin_role) {
    $admin_role->grantPermission('access resume tailoring');
    $admin_role->grantPermission('create tailored resumes');
    $admin_role->grantPermission('view own tailored resumes');
    $admin_role->grantPermission('view all tailored resumes');
    $admin_role->grantPermission('administer resume tailoring');
    $admin_role->save();
    \Drupal::logger('resume_tailoring')->notice('Granted all resume tailoring permissions to administrators.');
  }
}

/**
 * Update 9003: Set up resume tailoring security permissions.
 */
function resume_tailoring_update_9003() {
  _resume_tailoring_setup_permissions();
  return t('Set up resume tailoring security permissions for authenticated users and administrators.');
}