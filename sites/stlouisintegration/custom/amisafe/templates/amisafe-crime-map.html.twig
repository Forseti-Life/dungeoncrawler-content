{#
/**
 * @file
 * AmISafe Crime Map template.
 *
 * Available variables:
 * - map_config: Configuration for the map
 * - crime_types: Available crime types for filtering
 * - districts: Police districts
 * - date_range: Available date range
 */
#}

<div class="amisafe-crime-map-page">
  <div class="page-header">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 class="page-title">Philadelphia Crime Map</h1>
          <p class="page-subtitle">Interactive crime data visualization and analysis</p>
        </div>
        <div>
          <a href="/amisafe/download" class="btn btn-primary" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 0.75rem 1.5rem; border-radius: 8px; color: white; text-decoration: none; font-weight: 600; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: transform 0.2s, box-shadow 0.2s; display: inline-flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 1.2rem;">📱</span>
            Get Mobile App
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="crime-map-layout">
    <div class="crime-map-container">
      <!-- Loading Overlay -->
      <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <div class="loading-text">Loading crime data...</div>
      </div>
      
      <!-- This is the main container the JavaScript expects -->
      <div id="crime-map-container"></div>
      
      <!-- Floating Map Controls (will be created by JavaScript) -->
      <div id="map-filter-controls" class="floating-controls top-left">
        <!-- Date Range Presets -->
        <div class="control-group">
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-light preset-btn active" id="preset-12-months" data-preset="12months" title="Last 12 Months">12M</button>
            <button type="button" class="btn btn-light preset-btn" id="preset-6-months" data-preset="6months" title="Last 6 Months">6M</button>
            <button type="button" class="btn btn-light preset-btn" id="preset-all-time" data-preset="alltime" title="All Time Data">ALL</button>
          </div>
          <input type="hidden" id="date-range-filter" value="12months">
        </div>
        
        <!-- Crime Type Filter Toggle -->
        <div class="control-group">
          <button id="toggle-crime-filter" class="btn btn-light btn-sm" title="Filter Crime Types">
            <span class="filter-icon">🔍</span> Filters
          </button>
        </div>
        
        <!-- Crime Type Dropdown (hidden by default) -->
        <div id="crime-type-dropdown" class="filter-dropdown" style="display: none;">
          <div class="dropdown-header">
            <strong>Crime Types</strong>
            <button id="close-crime-filter" class="btn-close-filter">&times;</button>
          </div>
          <div class="dropdown-body">
            <select id="crime-type-selector" class="form-control form-select" multiple size="10">
              <!-- Dynamically populated from API -->
            </select>
            <small class="text-muted">Hold Ctrl/Cmd for multiple</small>
          </div>
          <div class="dropdown-footer">
            <button id="apply-crime-filter" class="btn btn-primary btn-sm">Apply</button>
            <button id="clear-crime-filter" class="btn btn-secondary btn-sm">Clear</button>
          </div>
        </div>
      </div>
      
      <!-- Resolution and Zoom Indicator -->
      <div class="map-controls">
        <div class="resolution-indicator">
          <button id="zoom-out" class="btn btn-xs btn-outline-secondary" title="Zoom Out">−</button>
          <span class="zoom-label">ZOOM:</span>
          <span id="zoom-level">12</span>
          <button id="zoom-in" class="btn btn-xs btn-outline-secondary" title="Zoom In">+</button>
          <span class="separator">|</span>
          <span class="resolution-label">H3:</span>
          <button id="h3-decrease" class="btn btn-xs btn-outline-secondary" title="Decrease H3 Resolution (Larger Hexagons)">−</button>
          <span class="resolution-value" id="h3-resolution">6</span>
          <button id="h3-increase" class="btn btn-xs btn-outline-secondary" title="Increase H3 Resolution (Smaller Hexagons)">+</button>
          <span class="scale-label" id="h3-scale-label">~36km² city areas</span>
        </div>
      </div>
      
      <!-- Hexagon Detail Panel (fixed at bottom) -->
      <div id="hexagon-detail-panel" class="hexagon-detail-panel" style="display: none;">
        <button id="close-detail-panel" class="close-panel-btn" title="Close">&times;</button>
        <div id="hexagon-detail-content"></div>
      </div>
    </div>
  </div>
</div>

<!-- Incident Details Modal -->
<div id="incident-modal" class="modal fade">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Incident Analysis</h3>
        <button class="btn-close modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="incident-details"></div>
      </div>
    </div>
  </div>
</div>