<div class="editor-viewport-controls" data-{{ surface }}-viewport-controls aria-label="{{ 'Map view controls'|t }}">
  <div class="editor-viewport-controls__group" aria-label="{{ 'Zoom'|t }}">
    <button type="button" class="room-editor__button" data-{{ surface }}-viewport="zoom-out" title="{{ 'Zoom out'|t }}" aria-label="{{ 'Zoom out'|t }}">−</button>
    <button type="button" class="room-editor__button" data-{{ surface }}-viewport="zoom-in" title="{{ 'Zoom in'|t }}" aria-label="{{ 'Zoom in'|t }}">+</button>
  </div>
  <div class="editor-viewport-controls__pad" aria-label="{{ 'Move map'|t }}">
    <button type="button" class="room-editor__button editor-viewport-controls__up" data-{{ surface }}-viewport="pan-up" title="{{ 'Move map up'|t }}" aria-label="{{ 'Move map up'|t }}">↑</button>
    <button type="button" class="room-editor__button editor-viewport-controls__left" data-{{ surface }}-viewport="pan-left" title="{{ 'Move map left'|t }}" aria-label="{{ 'Move map left'|t }}">←</button>
    <button type="button" class="room-editor__button editor-viewport-controls__right" data-{{ surface }}-viewport="pan-right" title="{{ 'Move map right'|t }}" aria-label="{{ 'Move map right'|t }}">→</button>
    <button type="button" class="room-editor__button editor-viewport-controls__down" data-{{ surface }}-viewport="pan-down" title="{{ 'Move map down'|t }}" aria-label="{{ 'Move map down'|t }}">↓</button>
  </div>
  <button type="button" class="room-editor__button" data-{{ surface }}-viewport="recenter" title="{{ 'Fit and recenter map'|t }}">{{ 'Fit'|t }}</button>
</div>
