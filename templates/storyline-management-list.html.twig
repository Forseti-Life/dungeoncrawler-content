{#
 # Shared storyline library. A storyline with a working draft is one card.
 #}
<div class="dc-character-list dc-character-list--storylines">
  <div class="dc-character-list__header">
    <h1 class="dc-character-list__title">Storylines</h1>
    <div class="dc-sheet__nav-actions">
      <a href="{{ campaigns_url }}" class="dc-btn dc-btn-secondary">Campaigns</a>
      <a href="{{ path('dungeoncrawler_content.dungeon_management') }}" class="dc-btn dc-btn-secondary">Dungeons</a>
      <a href="{{ path('dungeoncrawler_content.room_management') }}" class="dc-btn dc-btn-secondary">Rooms</a>
      <a href="{{ storyline_explorer_url }}" class="dc-btn dc-btn-secondary">Storyline Explorer</a>
      {% if archived_url %}
        <a href="{{ archived_url }}" class="dc-btn dc-btn-secondary">Archived Storylines</a>
      {% endif %}
      <a href="{{ builder_url }}" class="dc-btn dc-btn-primary">Create New Storyline</a>
    </div>
  </div>

  <section class="storyline-metrics" aria-labelledby="storyline-metrics-heading">
    <h2 id="storyline-metrics-heading" class="visually-hidden">Storyline library metrics</h2>
    <div class="storyline-metrics__card">
      <strong>{{ metrics.canonical_total|default(0) }}</strong>
      <span>Published storylines</span>
    </div>
    <div class="storyline-metrics__card">
      <strong>{{ metrics.active_drafts|default(0) }}</strong>
      <span>Working drafts</span>
    </div>
    <div class="storyline-metrics__card">
      <strong>{{ metrics.saved_versions|default(0) }}</strong>
      <span>Saved revisions</span>
    </div>
  </section>

  <div class="dc-sheet__section dc-character-list__campaign-setup">
    <h2 class="dc-sheet__section-title">Storyline Library</h2>
    <p>One shared library. Storyline editors work on the same drafts and revision history. Saving records the updater; publishing remains a separate action. Concurrent edits are checked before saving.</p>
    {% if storylines|length > 0 %}
      <div class="dc-character-grid">
        {% for storyline in storylines %}
          <div class="dc-character-card dc-character-card--{{ storyline.status }}{% if storyline.cover_url %} dc-character-card--has-cover{% endif %}"{% if storyline.cover_url %} style="--storyline-cover-image: url('{{ storyline.cover_url|e('html_attr') }}');"{% endif %}>
            {% if storyline.archive_url %}
              <a href="{{ storyline.archive_url }}" class="dc-character-card__archive-btn" title="Archive {{ storyline.name }}">Archive</a>
            {% endif %}
            <a href="{{ storyline.edit_url }}" class="dc-character-card__main-link">
              <div class="dc-character-card__portrait">
                {% if not storyline.cover_url %}
                  <div class="dc-character-card__portrait-placeholder">
                    <span class="dc-character-card__initial">{{ storyline.name|first|upper }}</span>
                  </div>
                {% endif %}
                <div class="dc-character-card__status-badge">{{ storyline.has_working_draft ? 'Published + Draft' : (storyline.status == 'draft' ? 'Draft' : 'Published') }}</div>
              </div>
              <div class="dc-character-card__info">
                <h3 class="dc-character-card__name">{{ storyline.name }}</h3>
                {% if storyline.goal %}<p class="dc-character-card__meta">{{ storyline.goal }}</p>{% endif %}
                <div class="dc-character-card__meta">
                  {% if storyline.latest_revision %}<span>Draft revision: {{ storyline.latest_revision }}</span>{% endif %}
                  {% if storyline.updated_by_name %}<span>Updated by {{ storyline.updated_by_name }}</span>{% endif %}
                  {% if storyline.based_on %}<span>Based on: {{ storyline.based_on }}</span>{% endif %}
                  {% if storyline.source %}<span>Source: {{ storyline.source }}</span>{% endif %}
                  {% if storyline.updated %}<span>Updated {{ storyline.updated }}</span>{% endif %}
                </div>
                {% if storyline.narrative_completeness is not null %}
                  <div class="storyline-completeness">
                    <span><strong>Narrative:</strong> {{ storyline.narrative_completeness }}%</span>
                    <span><strong>Structure/object:</strong> {{ storyline.structure_object_completeness }}%</span>
                    <span><strong>Overall:</strong> {{ storyline.overall_completeness }}%</span>
                  </div>
                {% endif %}
                <div class="dc-character-card__action-text">
                  <span class="dc-btn dc-btn-primary">{{ storyline.action_label }}</span>
                </div>
              </div>
              <div class="dc-character-card__arrow" aria-hidden="true">&rsaquo;</div>
            </a>
            {% if storyline.history_url %}
              <a href="{{ storyline.history_url }}" class="dc-btn dc-btn-secondary">Revision History</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="dc-character-list__empty">
        <h2>No Storylines Yet</h2>
        <p>Create a storyline draft in the GM Storyline Builder.</p>
      </div>
    {% endif %}
  </div>
</div>
