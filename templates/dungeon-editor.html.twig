{#
/**
 * @file
 * Canonical Dungeon Editor shell (slice 4: placement authoring).
 *
 * Layout contract, shared with the Room Editor:
 *   [author drawer] | [level canvas] | [GM assistant panel]
 * The drawer starts collapsed; the assistant panel owns the freed space.
 *
 * Slice 4 places, moves, rotates, retargets and removes rooms through the
 * command pipeline, with undo/redo. Links, regions, publication, and the
 * assistant's dungeon_editor surface arrive in later slices; controls for
 * them are absent, not disabled, so nothing on this page promises a
 * capability the server does not yet have.
 *
 * Available variables:
 * - dungeons: List of { dungeon_id, name, publication_status, published_version_id }.
 * - selected_dungeon_id: Optional dungeon_id to auto-load.
 * Full editor state is attached via
 * drupalSettings.dungeoncrawlerContent.dungeonEditor for
 * js/v2/editor/DungeonEditorShell.js.
 */
#}
<div class="hexmap-container room-editor dungeon-editor" data-dungeon-editor>
  <div class="game-shell" data-dungeon-editor-shell>

    <header class="room-editor__header">
      <div class="room-editor__header-row">
        <button type="button"
                class="room-editor__button room-editor__drawer-toggle"
                data-dungeon-editor-action="toggle-author-drawer"
                aria-expanded="false"
                aria-controls="dungeon-editor-author-drawer"
                title="{{ 'Show or hide the manual authoring tools'|t }}">{{ 'Author Tools'|t }}</button>

        <div class="room-editor__field room-editor__field--inline">
          <label for="dungeon-editor-dungeon-select">{{ 'Dungeon'|t }}</label>
          <select id="dungeon-editor-dungeon-select" data-dungeon-editor-dungeon-select>
            <option value="">{{ '- Select a dungeon -'|t }}</option>
            {% for dungeon in dungeons %}
              <option value="{{ dungeon.dungeon_id }}"{% if dungeon.dungeon_id == selected_dungeon_id %} selected{% endif %}>
                {{ dungeon.name }} ({{ dungeon.publication_status }})
              </option>
            {% endfor %}
          </select>
        </div>
        <button type="button" class="room-editor__button" data-dungeon-editor-action="load-dungeon">{{ 'Load'|t }}</button>
        <button type="button" class="room-editor__button" data-dungeon-editor-action="new-dungeon">{{ 'New Dungeon'|t }}</button>

        <span class="room-editor__spacer"></span>

        <button type="button" class="room-editor__button" data-dungeon-editor-action="undo" disabled title="{{ 'Undo the last command (Ctrl+Z)'|t }}">{{ 'Undo'|t }}</button>
        <button type="button" class="room-editor__button" data-dungeon-editor-action="redo" disabled title="{{ 'Redo the last undone command (Ctrl+Shift+Z)'|t }}">{{ 'Redo'|t }}</button>
        <span class="dungeon-editor__revision" data-dungeon-editor-revision></span>
      </div>

      <div class="room-editor__status" data-dungeon-editor-status role="status" aria-live="polite">
        {{ 'Loading canonical Dungeon Editor...'|t }}
      </div>
    </header>

    <div class="game-shell__workspace room-editor__workspace" data-dungeon-editor-workspace>

      <aside id="dungeon-editor-author-drawer"
             class="room-editor__author-drawer"
             data-dungeon-editor-author-drawer
             aria-label="{{ 'Manual authoring tools'|t }}"
             hidden>

        <section class="room-editor__drawer-section" data-dungeon-editor-metadata aria-label="{{ 'Dungeon metadata'|t }}">
          <p class="room-editor__eyebrow">{{ 'Dungeon'|t }}</p>
          <form class="dungeon-editor__metadata" data-dungeon-editor-metadata-form>
            <label class="room-editor__field">{{ 'Name'|t }}<input type="text" name="name" maxlength="200" required data-dungeon-editor-meta="name"></label>
            <label class="room-editor__field">{{ 'Theme'|t }}<input type="text" name="theme" maxlength="100" data-dungeon-editor-meta="theme"></label>
            <label class="room-editor__field">{{ 'Depth'|t }}<input type="number" name="depth" min="0" max="100" step="1" data-dungeon-editor-meta="depth"></label>
            <label class="room-editor__field">{{ 'Description'|t }}<textarea name="description" rows="3" maxlength="8000" data-dungeon-editor-meta="description"></textarea></label>
          </form>
        </section>

        <section class="room-editor__drawer-section" data-dungeon-editor-room-library aria-label="{{ 'Room library'|t }}">
          <p class="room-editor__eyebrow">{{ 'Room Library'|t }}</p>
          <p class="room-editor__hint">{{ 'Drag a published room onto the level to place it.'|t }}</p>
          <ul class="dungeon-editor__room-list" data-dungeon-editor-room-list role="list"></ul>
          <p class="room-editor__catalog-empty" data-dungeon-editor-room-list-empty hidden>{{ 'No published rooms.'|t }}</p>
        </section>

        <section class="room-editor__drawer-section" data-dungeon-editor-placements aria-label="{{ 'Placements'|t }}">
          <p class="room-editor__eyebrow">{{ 'Placements'|t }}</p>
          <p class="room-editor__hint">{{ 'Drag a room on the canvas to move it. With one selected: [ and ] rotate, Delete removes.'|t }}</p>
          <ul class="dungeon-editor__placement-list" data-dungeon-editor-placement-list role="list"></ul>
          <p class="room-editor__hint" data-dungeon-editor-placement-empty hidden>{{ 'This level has no placements.'|t }}</p>
        </section>

        <section class="room-editor__drawer-section" data-dungeon-editor-links aria-label="{{ 'Port links'|t }}">
          <p class="room-editor__eyebrow">{{ 'Links'|t }}</p>
          <p class="room-editor__hint">{{ 'Click an unlinked exit port on the canvas, then a highlighted entry port across the shared edge. Esc cancels.'|t }}</p>
          <ul class="dungeon-editor__link-list" data-dungeon-editor-link-list role="list"></ul>
          <p class="room-editor__hint" data-dungeon-editor-link-empty hidden>{{ 'No links yet.'|t }}</p>
        </section>

        <section class="room-editor__drawer-section" data-dungeon-editor-regions aria-label="{{ 'Regions'|t }}">
          <p class="room-editor__eyebrow">{{ 'Regions'|t }}</p>
          <ul class="dungeon-editor__region-list" data-dungeon-editor-region-list role="list"></ul>
          <p class="room-editor__hint" data-dungeon-editor-region-empty hidden>{{ 'No regions yet.'|t }}</p>
          <form class="dungeon-editor__region-form" data-dungeon-editor-region-form>
            <label class="room-editor__field">{{ 'Region id'|t }}<input type="text" name="region_id" maxlength="100" pattern="[a-z0-9][a-z0-9_\-]{0,99}" required placeholder="north-wing"></label>
            <label class="room-editor__field">{{ 'Name'|t }}<input type="text" name="name" maxlength="200" required></label>
            <button type="submit" class="room-editor__button">{{ 'Add region'|t }}</button>
          </form>
        </section>

        <section class="room-editor__drawer-section room-editor__inspector" data-dungeon-editor-inspector aria-label="{{ 'Inspector'|t }}">
          <p class="room-editor__eyebrow">{{ 'Inspector'|t }}</p>
          <div data-dungeon-editor-inspector-body>
            <p class="room-editor__hint">{{ 'Select a placement, link or region to inspect it.'|t }}</p>
          </div>
        </section>

        <section class="room-editor__drawer-section room-editor__validation" data-dungeon-editor-validation aria-label="{{ 'Validation results'|t }}">
          <p class="room-editor__eyebrow">{{ 'Validation'|t }}</p>
          <ul class="room-editor__validation-list" data-dungeon-editor-validation-list></ul>
        </section>

      </aside>

      <div class="game-shell__content room-editor__center">
        <div class="hexmap-stage room-editor__stage">
          <div id="dungeon-editor-canvas" class="hexmap-canvas-wrapper" data-dungeon-editor-canvas></div>
        </div>
      </div>

      <aside class="room-editor__gm-panel" data-dungeon-editor-gm-panel aria-label="{{ 'GM assistant'|t }}">
        <header class="room-editor__gm-header">
          <p class="room-editor__eyebrow">{{ 'GM Assistant'|t }}</p>
          <span class="room-editor__gm-state" data-dungeon-editor-gm-state role="status" aria-live="polite">{{ 'Not connected'|t }}</span>
        </header>
        <section class="room-editor__gm-disclosure-group" aria-label="{{ 'Grounded editor context'|t }}">
          <button type="button"
                  class="room-editor__gm-disclosure"
                  data-dungeon-editor-action="gm-toggle-context"
                  aria-expanded="true"
                  aria-controls="dungeon-editor-gm-context-body">{{ 'Grounded context'|t }}</button>
          <div id="dungeon-editor-gm-context-body" class="room-editor__gm-context-body" data-dungeon-editor-gm-context></div>
        </section>
        <ol class="room-editor__gm-transcript" data-dungeon-editor-gm-transcript aria-label="{{ 'Assistant transcript'|t }}" aria-live="polite">
          <li class="room-editor__gm-message room-editor__gm-message--warning">
            {{ 'The dungeon_editor assistant surface is delivered in slice 7. Until then this panel shows the grounded context the assistant will receive, and accepts no messages.'|t }}
          </li>
        </ol>
      </aside>
    </div>
  </div>
</div>
