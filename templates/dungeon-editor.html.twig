{#
/**
 * @file
 * Canonical Dungeon Editor shell (slice 4: placement authoring).
 *
 * Layout contract, shared with the Room Editor:
 *   the shared editor page (editor-page-shell.html.twig): stages, state and
 *   links on the left; the Game Master Agent above the [author drawer] |
 *   [level canvas]
 * The drawer starts collapsed; the assistant panel owns the freed space.
 *
 * The shell places rooms, links ports, manages regions, publishes canonical
 * dungeon versions, and exposes the dungeon_editor GM surface.
 *
 * Available variables:
 * - dungeons: List of { dungeon_id, name, publication_status, published_version_id, has_active_draft }.
 * - selected_dungeon_id: Optional dungeon_id to auto-load.
 * Full editor state is attached via
 * drupalSettings.dungeoncrawlerContent.dungeonEditor for
 * js/v2/editor/DungeonEditorShell.js.
 */
#}
{% embed '@dungeoncrawler_content/editor-page-shell.html.twig' with {
  surface: 'dungeon-editor',
  title: 'Dungeon Editor'|t,
  intro: 'Lay out a site from published rooms: place them, link their exits, validate and publish.'|t,
  back_url: path('dungeoncrawler_content.dungeon_management'),
  back_label: 'Back to Dungeon Manager'|t,
  stages_title: 'Dungeon process stages'|t,
  thing: 'dungeon'|t,
  contains_title: 'Rooms in this dungeon'|t,
  panel_meta: 'Ask the Game Master Agent, or edit on the map below'|t,
  quick_links: [
    { label: 'Dungeon Manager'|t, url: path('dungeoncrawler_content.dungeon_management') },
    { label: 'Room Manager'|t, url: path('dungeoncrawler_content.room_management') },
    { label: 'Room Editor'|t, url: path('dungeoncrawler_content.room_editor') },
    { label: 'Storyline Manager'|t, url: path('dungeoncrawler_content.storyline_management') }
  ],
} %}
  {% block gm %}
    {% include '@dungeoncrawler_content/editor-gm-agent.html.twig' with {
      surface: 'dungeon-editor',
      eyebrow: 'Primary dungeon interface'|t,
      intro: 'Describe the site you want, ask what is missing, or request a change. Clear requests are applied to the draft and stay editable on the map below.'|t,
      placeholder: 'Describe the dungeon, ask what is missing, or request a change.'|t,
      prompts: [
        { label: 'What is next'|t, text: 'What is the next step for this dungeon? Name one finding and how it is fixed.'|t },
        { label: 'Build from the story'|t, text: 'Load the story brief for this dungeon and build what the story needs.'|t },
        { label: 'Check for publishing'|t, text: 'Validate this dungeon and tell me what blocks publishing.'|t }
      ],
    } only %}
  {% endblock %}
  {% block editor %}
    <div class="hexmap-container room-editor dungeon-editor editor-page__editor">
      <div class="game-shell" data-dungeon-editor-shell>

        <header class="room-editor__header">
          <div class="room-editor__header-row">
            <button type="button"
                    class="room-editor__button room-editor__drawer-toggle"
                    data-dungeon-editor-action="toggle-author-drawer"
                    aria-expanded="false"
                    aria-controls="dungeon-editor-author-drawer"
                    title="{{ 'Show or hide the manual authoring tools'|t }}">{{ 'Author Tools'|t }}</button>

            <div class="room-editor__field room-editor__field--inline">
              <label for="dungeon-editor-dungeon-select">{{ 'Dungeon'|t }}</label>
              <select id="dungeon-editor-dungeon-select" data-dungeon-editor-dungeon-select>
                <option value="">{{ '- Select a dungeon -'|t }}</option>
                {% for dungeon in dungeons %}
                  <option value="{{ dungeon.dungeon_id }}"
                          data-published-version-id="{{ dungeon.published_version_id }}"
                          data-has-active-draft="{{ dungeon.has_active_draft ? '1' : '0' }}"
                          {% if dungeon.dungeon_id == selected_dungeon_id %} selected{% endif %}>
                    {{ dungeon.name }} ({% if dungeon.published_version_id %}{{ dungeon.publication_status }}{% elseif dungeon.has_active_draft %}{{ 'converted draft'|t }}{% else %}{{ 'unpublished'|t }}{% endif %})
                  </option>
                {% endfor %}
              </select>
            </div>
            <button type="button" class="room-editor__button" data-dungeon-editor-action="load-dungeon">{{ 'Load'|t }}</button>
            <button type="button" class="room-editor__button" data-dungeon-editor-action="new-dungeon">{{ 'New Dungeon'|t }}</button>

            <span class="room-editor__spacer"></span>
            <button type="button" class="room-editor__button" data-dungeon-editor-action="recenter" disabled title="{{ 'Recenter and fit the dungeon map in the viewport'|t }}">{{ 'Recenter'|t }}</button>
            <button type="button" class="room-editor__button" data-dungeon-editor-action="undo" disabled title="{{ 'Undo the last command (Ctrl+Z)'|t }}">{{ 'Undo'|t }}</button>
            <button type="button" class="room-editor__button" data-dungeon-editor-action="redo" disabled title="{{ 'Redo the last undone command (Ctrl+Shift+Z)'|t }}">{{ 'Redo'|t }}</button>
            <span class="dungeon-editor__revision" data-dungeon-editor-revision></span>
          </div>

          <div class="room-editor__header-row dungeon-editor__selection-bar" data-dungeon-editor-selection-bar aria-label="{{ 'Selected room'|t }}">
            <span class="dungeon-editor__selection-name" data-dungeon-editor-selection-name>{{ 'No room selected. Click a room on the map.'|t }}</span>
            <button type="button" class="room-editor__button" data-inspector-action="rotate-ccw" disabled title="{{ 'Rotate the selected room 60° counter-clockwise ( [ )'|t }}">{{ '⟲ Rotate left'|t }}</button>
            <button type="button" class="room-editor__button" data-inspector-action="rotate-cw" disabled title="{{ 'Rotate the selected room 60° clockwise ( ] )'|t }}">{{ '⟳ Rotate right'|t }}</button>
            <button type="button" class="room-editor__button" data-inspector-action="toggle-entrance" disabled title="{{ 'Players enter the dungeon through this room'|t }}">{{ 'Set as entrance'|t }}</button>
            <button type="button" class="room-editor__button room-editor__button--danger" data-inspector-action="remove" disabled title="{{ 'Remove the selected room from this dungeon (Delete)'|t }}">{{ 'Remove from dungeon'|t }}</button>
            <a class="room-editor__button" data-dungeon-editor-selection-room-link href="#" target="_blank" rel="noopener" style="visibility: hidden" title="{{ 'Room contents are edited in the Room Editor'|t }}">{{ 'Edit room contents'|t }}</a>
          </div>
          <p class="room-editor__hint dungeon-editor__howto">
            {{ 'Place: drag a room from Author Tools › Room Library onto the map. Move: drag a room. Rotate: select a room, then Rotate left or right. Connect: drag from a port dot on one room onto another room; they do not need to touch.'|t }}
          </p>

          <div class="room-editor__status" data-dungeon-editor-status role="status" aria-live="polite">
            {{ 'Loading canonical Dungeon Editor...'|t }}
          </div>
        </header>

        <section class="room-editor__place-preview" data-dungeon-editor-place-preview aria-label="{{ 'Dungeon image'|t }}">
          <div class="room-editor__place-image">
            <button type="button" data-dungeon-editor-place-image-trigger class="room-editor__place-image-trigger" aria-label="{{ 'Open dungeon image full size'|t }}" hidden>
              <img data-dungeon-editor-place-image alt="{{ 'Dungeon preview'|t }}">
            </button>
            <span data-dungeon-editor-place-placeholder>{{ 'No dungeon image generated yet.'|t }}</span>
          </div>
          <div class="room-editor__place-preview-actions">
            <h3>{{ 'Dungeon view'|t }}</h3>
            <p data-dungeon-editor-place-status aria-live="polite">{{ 'Generate an overview image for this dungeon.'|t }}</p>
            <label class="room-editor__field" data-dungeon-editor-place-version-field hidden>
              {{ 'Image version'|t }}
              <select data-dungeon-editor-place-version aria-label="{{ 'Dungeon image version'|t }}"></select>
            </label>
            <button type="button" class="room-editor__button room-editor__button--primary" data-dungeon-editor-action="place-image">{{ 'Generate / Regenerate image'|t }}</button>
          </div>
        </section>

        <div class="game-shell__workspace room-editor__workspace room-editor__workspace--stacked" data-dungeon-editor-workspace>

          <aside id="dungeon-editor-author-drawer"
                 class="room-editor__author-drawer"
                 data-dungeon-editor-author-drawer
                 aria-label="{{ 'Manual authoring tools'|t }}"
                 hidden>

            <section class="room-editor__drawer-section" data-dungeon-editor-metadata aria-label="{{ 'Dungeon metadata'|t }}">
              <p class="room-editor__eyebrow">{{ 'Dungeon'|t }}</p>
              <form class="dungeon-editor__metadata" data-dungeon-editor-metadata-form>
                <label class="room-editor__field">{{ 'Name'|t }}<input type="text" name="name" maxlength="200" required data-dungeon-editor-meta="name"></label>
                <label class="room-editor__field">{{ 'Theme'|t }}<input type="text" name="theme" maxlength="100" data-dungeon-editor-meta="theme"></label>
                <label class="room-editor__field">{{ 'Depth'|t }}<input type="number" name="depth" min="0" max="100" step="1" data-dungeon-editor-meta="depth"></label>
                <label class="room-editor__field">{{ 'Description'|t }}<textarea name="description" rows="3" maxlength="8000" data-dungeon-editor-meta="description"></textarea></label>
              </form>
            </section>

            <section class="room-editor__drawer-section" data-dungeon-editor-room-library aria-label="{{ 'Room library'|t }}">
              <p class="room-editor__eyebrow">{{ 'Room Library'|t }}</p>
              <p class="room-editor__hint">{{ 'Drag a published room onto the level to place it.'|t }}</p>
              <ul class="dungeon-editor__room-list" data-dungeon-editor-room-list role="list"></ul>
              <p class="room-editor__catalog-empty" data-dungeon-editor-room-list-empty hidden>{{ 'No published rooms.'|t }}</p>
            </section>

            <section class="room-editor__drawer-section dungeon-editor__generation" data-dungeon-editor-generation aria-label="{{ 'Generate dungeon layout'|t }}">
              <p class="room-editor__eyebrow">{{ 'Generate…'|t }}</p>
              <label class="room-editor__field" for="dungeon-editor-generation-prompt">{{ 'Prompt'|t }}
                <textarea id="dungeon-editor-generation-prompt" data-dungeon-editor-generation-prompt rows="3" maxlength="2000" placeholder="{{ '3 connected rooms, sewer theme'|t }}"></textarea>
              </label>
              <label class="room-editor__field">{{ 'Theme'|t }}<input type="text" data-dungeon-editor-generation-theme maxlength="100" placeholder="{{ 'sewer, ruin, crypt...'|t }}"></label>
              <label class="room-editor__field">{{ 'Room count'|t }}<input type="number" data-dungeon-editor-generation-room-count min="3" max="20" step="1" value="3"></label>
              <label class="room-editor__field">{{ 'Seed (optional)'|t }}<input type="number" data-dungeon-editor-generation-seed min="0" max="2147483647" step="1"></label>
              <button type="button" class="room-editor__button room-editor__button--primary" data-dungeon-editor-action="generate-dungeon-layout">{{ 'Generate dungeon plan'|t }}</button>
            </section>

            <section class="room-editor__drawer-section" data-dungeon-editor-placements aria-label="{{ 'Placements'|t }}">
              <p class="room-editor__eyebrow">{{ 'Placements'|t }}</p>
              <p class="room-editor__hint">{{ 'Drag a room on the canvas to move it. With one selected: Rotate left and Rotate right above the map (or [ and ]) turn it 60°, Delete removes.'|t }}</p>
              <ul class="dungeon-editor__placement-list" data-dungeon-editor-placement-list role="list"></ul>
              <p class="room-editor__hint" data-dungeon-editor-placement-empty hidden>{{ 'This level has no placements.'|t }}</p>
            </section>

            <section class="room-editor__drawer-section" data-dungeon-editor-links aria-label="{{ 'Port links'|t }}">
              <p class="room-editor__eyebrow">{{ 'Links'|t }}</p>
              <p class="room-editor__hint">{{ 'Drag from a port dot on one room onto another room, or click the two ports in turn. A link joins an exit to an entry; the rooms do not need to touch. Esc cancels.'|t }}</p>
              <ul class="dungeon-editor__link-list" data-dungeon-editor-link-list role="list"></ul>
              <p class="room-editor__hint" data-dungeon-editor-link-empty hidden>{{ 'No links yet.'|t }}</p>
            </section>

            <section class="room-editor__drawer-section" data-dungeon-editor-regions aria-label="{{ 'Regions'|t }}">
              <p class="room-editor__eyebrow">{{ 'Regions'|t }}</p>
              <ul class="dungeon-editor__region-list" data-dungeon-editor-region-list role="list"></ul>
              <p class="room-editor__hint" data-dungeon-editor-region-empty hidden>{{ 'No regions yet.'|t }}</p>
              <form class="dungeon-editor__region-form" data-dungeon-editor-region-form>
                <label class="room-editor__field">{{ 'Region id (auto if blank)'|t }}<input type="text" name="region_id" maxlength="100" pattern="[a-z0-9][a-z0-9_\-]{0,99}" placeholder="north-wing"></label>
                <label class="room-editor__field">{{ 'Name'|t }}<input type="text" name="name" maxlength="200" required></label>
                <button type="submit" class="room-editor__button">{{ 'Add region'|t }}</button>
              </form>
            </section>

            <section class="room-editor__drawer-section room-editor__inspector" data-dungeon-editor-inspector aria-label="{{ 'Inspector'|t }}">
              <p class="room-editor__eyebrow">{{ 'Inspector'|t }}</p>
              <div data-dungeon-editor-inspector-body>
                <p class="room-editor__hint">{{ 'Select a placement, link or region to inspect it.'|t }}</p>
              </div>
            </section>

            <section class="room-editor__drawer-section room-editor__validation" data-dungeon-editor-validation aria-label="{{ 'Validation results'|t }}">
              <p class="room-editor__eyebrow">{{ 'Validation'|t }}</p>
              <ul class="room-editor__validation-list" data-dungeon-editor-validation-list></ul>
            </section>

            <section class="room-editor__drawer-section room-editor__validation" data-dungeon-editor-publication aria-label="{{ 'Publication'|t }}">
              <p class="room-editor__eyebrow">{{ 'Publish'|t }}</p>
              <ul class="room-editor__validation-list" data-dungeon-editor-publish-readiness>
                <li class="room-editor__validation-item">{{ 'Load a draft before publishing.'|t }}</li>
              </ul>
              <form class="dungeon-editor__publish-form" data-dungeon-editor-publish-form>
                <label class="room-editor__field">{{ 'Version'|t }}<input type="text" name="version" maxlength="32" required placeholder="1.0.0" data-dungeon-editor-publish-version></label>
                <label class="room-editor__field">{{ 'Publication note'|t }}<textarea name="publication_note" rows="2" maxlength="4000" data-dungeon-editor-publish-note></textarea></label>
                <button type="submit" class="room-editor__button room-editor__button--primary" data-dungeon-editor-action="publish" disabled>{{ 'Publish'|t }}</button>
                <p class="room-editor__hint" data-dungeon-editor-published-version hidden></p>
              </form>
            </section>

          </aside>

          <div class="game-shell__content room-editor__center">
            <div class="hexmap-stage room-editor__stage">
              <div id="dungeon-editor-canvas" class="hexmap-canvas-wrapper" data-dungeon-editor-canvas></div>
            </div>
            {% include '@dungeoncrawler_content/editor-map-legend.html.twig' with {
              groups: [
                { title: 'Rooms'|t, items: [
                  { symbol: 'hex', fill: '#446998', line: '#60a5fa', label: 'A room'|t },
                  { symbol: 'hex', fill: '#307d6c', line: '#34d399', label: 'Another room (each has its own colour)'|t },
                  { symbol: 'badge', fill: '#0f172a', line: '#60a5fa', text: 'Name', label: 'Room name'|t },
                  { symbol: 'hex', fill: '#dc2626', line: '#fecaca', label: 'Two rooms overlap here (a room on the district street is fine)'|t }
                ] },
                { title: 'Doorways'|t, items: [
                  { symbol: 'dot', fill: '#38bdf8', line: '#38bdf8', label: 'Entry port'|t },
                  { symbol: 'ring', line: '#f59e0b', label: 'Exit port, not connected yet'|t },
                  { symbol: 'dot', fill: '#22c55e', line: '#22c55e', label: 'Exit port, connected'|t }
                ] },
                { title: 'Connections'|t, items: [
                  { symbol: 'line', fill: '#f8fafc', label: 'Connection between two rooms'|t },
                  { symbol: 'line', fill: '#a855f7', label: 'Secret door'|t }
                ] },
                { title: 'While editing'|t, items: [
                  { symbol: 'ring', line: '#facc15', label: 'Port you are connecting from'|t },
                  { symbol: 'ring', line: '#22c55e', label: 'Port you can connect to'|t },
                  { symbol: 'line', fill: '#facc15', label: 'Connection being dragged'|t },
                  { symbol: 'hex', fill: '#22c55e', line: '#22c55e', label: 'Dragged room fits here'|t },
                  { symbol: 'hex', fill: '#ef4444', line: '#ef4444', label: 'Dragged room would overlap'|t }
                ] }
              ],
            } only %}
            <p class="room-editor__hint">{{ 'Water and lava keep their own shade inside a room. The compass at the bottom right shows which way is north.'|t }}</p>
          </div>

        </div>
      </div>
    </div>
  {% endblock %}
{% endembed %}
