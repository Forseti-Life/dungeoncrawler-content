{#
/**
 * @file
 * Canonical Room Editor shell with an embedded GM assistant.
 *
 * Layout: the shared editor page (editor-page-shell.html.twig): stages, state
 * and links on the left; the Game Master Agent above [author drawer] | [canvas].
 * The GM assistant is the primary surface. Every manual authoring control
 * (catalog, tool palette, inspector, validation) lives inside the collapsible
 * author drawer, which starts collapsed so the freed real estate belongs to
 * the assistant.
 *
 * Available variables:
 * - rooms: List of { room_id, name, publication_status, published_version_id }
 *   for the room selector. Full editor state (URLs, csrf token, initial
 *   room list) is also attached via drupalSettings.dungeoncrawlerContent.roomEditor
 *   for js/v2/editor/RoomEditorShell.js to consume.
 * - selected_room_id: Optional room_id to auto-load on page load.
 */
#}
{% embed '@dungeoncrawler_content/editor-page-shell.html.twig' with {
  surface: 'room-editor',
  title: 'Room Editor'|t,
  intro: 'Shape one room: its floor, entrances and exits, and what stands in it; then validate and publish.'|t,
  back_url: back_url|default(path('dungeoncrawler_content.room_management')),
  back_label: (back_label|default('Back to Room Manager'))|t,
  stages_title: 'Room process stages'|t,
  thing: 'room'|t,
  contains_title: 'Dungeons that use this room'|t,
  contents_title: 'Placed in this room'|t,
  panel_meta: 'Ask the Game Master Agent, or edit on the map below'|t,
  quick_links: [
    { label: 'Room Manager'|t, url: path('dungeoncrawler_content.room_management') },
    { label: 'Dungeon Manager'|t, url: path('dungeoncrawler_content.dungeon_management') },
    { label: 'Dungeon Editor'|t, url: path('dungeoncrawler_content.dungeon_editor') },
    { label: 'Storyline Manager'|t, url: path('dungeoncrawler_content.storyline_management') }
  ],
} %}
  {% block gm %}
    {% include '@dungeoncrawler_content/editor-gm-agent.html.twig' with {
      surface: 'room-editor',
      eyebrow: 'Primary room interface'|t,
      intro: 'Describe the room you want, ask what is missing, or request a change. Clear requests are applied to the draft and stay editable on the map below.'|t,
      placeholder: 'Describe the room, ask what is missing, or request a change.'|t,
      prompts: [
        { label: 'What is next'|t, text: 'What is the next step for this room? Name one finding and how it is fixed.'|t },
        { label: 'Build from the story'|t, text: 'Load the story brief for this room and build what the story needs.'|t },
        { label: 'Check for publishing'|t, text: 'Validate this room and tell me what blocks publishing.'|t }
      ],
    } only %}
  {% endblock %}
  {% block editor %}
    <div class="hexmap-container room-editor editor-page__editor">
      <div class="game-shell" data-room-editor-shell>

        <header class="room-editor__header">
          <div class="room-editor__header-row">
            <button type="button"
                    class="room-editor__button room-editor__drawer-toggle"
                    data-room-editor-action="toggle-author-drawer"
                    aria-expanded="false"
                    aria-controls="room-editor-author-drawer"
                    title="{{ 'Show or hide the manual authoring tools'|t }}">{{ 'Author Tools'|t }}</button>

            <div class="room-editor__field room-editor__field--inline">
              <label for="room-editor-room-select">{{ 'Room'|t }}</label>
              <select id="room-editor-room-select" data-room-editor-room-select>
                <option value="">{{ '- Select a room -'|t }}</option>
                {% for room in rooms %}
                  <option value="{{ room.room_id }}"{% if room.room_id == selected_room_id %} selected{% endif %}>
                    {{ room.name }} ({{ room.publication_status }})
                  </option>
                {% endfor %}
              </select>
            </div>
            <button type="button" class="room-editor__button" data-room-editor-action="load-room">{{ 'Load'|t }}</button>
            <button type="button" class="room-editor__button" data-room-editor-action="new-room">{{ 'New Room'|t }}</button>

            <span class="room-editor__spacer"></span>
            <button type="button" class="room-editor__button" data-room-editor-action="undo" disabled title="{{ 'Undo (Ctrl/Cmd+Z)'|t }}">{{ 'Undo'|t }}</button>
            <button type="button" class="room-editor__button" data-room-editor-action="redo" disabled title="{{ 'Redo (Ctrl/Cmd+Y)'|t }}">{{ 'Redo'|t }}</button>

            <select data-room-editor-validate-profile aria-label="{{ 'Validation profile'|t }}">
              <option value="editing">{{ 'Editing'|t }}</option>
              <option value="preview">{{ 'Preview'|t }}</option>
              <option value="publication">{{ 'Publication'|t }}</option>
            </select>
            <button type="button" class="room-editor__button" data-room-editor-action="validate">{{ 'Validate'|t }}</button>
            <button type="button" class="room-editor__button" data-room-editor-action="save">{{ 'Save'|t }}</button>
          </div>

          <div class="room-editor__header-row room-editor__header-row--publish">
            <div class="room-editor__field room-editor__field--inline">
              <label for="room-editor-publish-version">{{ 'Version'|t }}</label>
              <input type="text" id="room-editor-publish-version" data-room-editor-publish-version placeholder="1.0.0" size="8">
            </div>
            <div class="room-editor__field room-editor__field--inline room-editor__field--grow">
              <label for="room-editor-publish-note">{{ 'Publication note'|t }}</label>
              <input type="text" id="room-editor-publish-note" data-room-editor-publish-note placeholder="{{ 'What changed in this version?'|t }}">
            </div>
            <button type="button" class="room-editor__button room-editor__button--primary" data-room-editor-action="publish">{{ 'Publish'|t }}</button>
          </div>

          <div class="room-editor__header-row room-editor__selection-bar" data-room-editor-selection-bar aria-label="{{ 'Selected object'|t }}">
            <span class="room-editor__selection-name" data-room-editor-selection-name>{{ 'Nothing selected. Click an object or a port on the map.'|t }}</span>
            <button type="button" class="room-editor__button" data-room-editor-selection-action="rotate-ccw" disabled title="{{ 'Turn the selected object 60° counter-clockwise ( [ ). A port moves to the previous side of its hex.'|t }}">{{ '⟲ Turn left'|t }}</button>
            <button type="button" class="room-editor__button" data-room-editor-selection-action="rotate-cw" disabled title="{{ 'Turn the selected object 60° clockwise ( ] ). A port moves to the next side of its hex.'|t }}">{{ '⟳ Turn right'|t }}</button>
            <button type="button" class="room-editor__button room-editor__button--danger" data-room-editor-selection-action="remove" disabled title="{{ 'Remove the selected object or port from this room (Delete)'|t }}">{{ 'Remove'|t }}</button>
          </div>

          <div class="room-editor__status" data-room-editor-status role="status" aria-live="polite">
            {{ 'Loading canonical Room Editor...'|t }}
          </div>
        </header>

        <section class="room-editor__place-preview" data-room-editor-place-preview aria-label="{{ 'Room image'|t }}">
          <div class="room-editor__place-image">
            <button type="button" data-room-editor-place-image-trigger class="room-editor__place-image-trigger" aria-label="{{ 'Open room image full size'|t }}" hidden>
              <img data-room-editor-place-image alt="{{ 'Room preview'|t }}">
            </button>
            <span data-room-editor-place-placeholder>{{ 'No room image generated yet.'|t }}</span>
          </div>
          <div class="room-editor__place-preview-actions">
            <h3>{{ 'Room view'|t }}</h3>
            <p data-room-editor-place-status aria-live="polite">{{ 'Generate an establishing image for this room.'|t }}</p>
            <label class="room-editor__field" data-room-editor-place-version-field hidden>
              {{ 'Image version'|t }}
              <select data-room-editor-place-version aria-label="{{ 'Room image version'|t }}"></select>
              <button type="button" class="room-editor__button" data-room-editor-place-promote hidden>{{ 'Use selected as current'|t }}</button>
            </label>
            <button type="button" class="room-editor__button room-editor__button--primary" data-room-editor-action="place-image">{{ 'Generate / Regenerate image'|t }}</button>
          </div>
        </section>

        <section class="room-editor__metadata-panel" data-room-editor-metadata aria-label="{{ 'Room metadata'|t }}">
          <div class="room-editor__drawer-section">
            <p class="room-editor__eyebrow">{{ 'Room metadata'|t }}</p>
            <form data-room-editor-metadata-form>
              <div class="room-editor__metadata-grid">
                <label class="room-editor__field">{{ 'Room ID'|t }}<input type="text" data-room-editor-meta="room_id" readonly></label>
                <label class="room-editor__field">{{ 'Name'|t }}<input type="text" data-room-editor-meta="name" maxlength="200" required></label>
                <label class="room-editor__field room-editor__field--wide">{{ 'Description'|t }}<textarea data-room-editor-meta="description" rows="3" maxlength="2000" required></textarea></label>
                <label class="room-editor__field">{{ 'Room type'|t }}<select data-room-editor-meta="room_type"></select></label>
                <label class="room-editor__field">{{ 'Size category'|t }}<select data-room-editor-meta="size_category"></select></label>
                <label class="room-editor__field">{{ 'Default terrain'|t }}<select data-room-editor-meta="terrain_type"></select></label>
                <label class="room-editor__field">{{ 'Lighting'|t }}
                  <select data-room-editor-meta="lighting_level">
                    <option value="bright_light">{{ 'Bright light'|t }}</option>
                    <option value="dim_light">{{ 'Dim light'|t }}</option>
                    <option value="darkness">{{ 'Darkness'|t }}</option>
                    <option value="magical_darkness">{{ 'Magical darkness'|t }}</option>
                  </select>
                </label>
                <label class="room-editor__field">{{ 'Ceiling height (ft)'|t }}<input type="number" data-room-editor-meta="ceiling_height_ft" min="1" max="200" step="1" placeholder="{{ 'Optional'|t }}"></label>
                <label class="room-editor__field">{{ 'Tags'|t }}<input type="text" data-room-editor-meta="tags" placeholder="{{ 'outdoor, lightning, boss room'|t }}"></label>
                <label class="room-editor__field">{{ 'Visibility'|t }}
                  <select data-room-editor-meta="visibility">
                    <option value="visible">{{ 'Visible'|t }}</option>
                    <option value="hidden">{{ 'Hidden'|t }}</option>
                  </select>
                </label>
                <label class="room-editor__field room-editor__field--checkbox"><input type="checkbox" data-room-editor-meta="safe_for_rest"> {{ 'Safe for rest'|t }}</label>
                <p class="room-editor__hint" data-room-editor-meta-elevation>{{ 'Load a room to see floor elevation range.'|t }}</p>
                <details class="room-editor__field room-editor__field--wide">
                  <summary>{{ 'Background image metadata'|t }}</summary>
                  <label class="room-editor__field">{{ 'URL'|t }}<input type="url" data-room-editor-meta="background_url" maxlength="1024"></label>
                  <label class="room-editor__field">{{ 'Width (px)'|t }}<input type="number" data-room-editor-meta="background_width" min="1" step="1"></label>
                  <label class="room-editor__field">{{ 'Height (px)'|t }}<input type="number" data-room-editor-meta="background_height" min="1" step="1"></label>
                  <label class="room-editor__field">{{ 'Alt text'|t }}<input type="text" data-room-editor-meta="background_alt" maxlength="500"></label>
                </details>
              </div>
              <button type="submit" class="room-editor__button room-editor__button--primary">{{ 'Save room metadata'|t }}</button>
            </form>
          </div>
        </section>

        <div class="game-shell__workspace room-editor__workspace room-editor__workspace--stacked" data-room-editor-workspace>

          <aside id="room-editor-author-drawer"
                 class="room-editor__author-drawer"
                 data-room-editor-author-drawer
                 aria-label="{{ 'Manual authoring tools'|t }}"
                 hidden>

          <section class="room-editor__drawer-section room-editor__catalog" data-room-editor-catalog aria-label="{{ 'Placeable object catalog'|t }}">
            <p class="room-editor__eyebrow">{{ 'Catalog'|t }}</p>
            <div class="room-editor__catalog-controls">
              <input type="search" data-room-editor-catalog-search placeholder="{{ 'Search catalog...'|t }}" aria-label="{{ 'Search catalog'|t }}">
              <select data-room-editor-catalog-family aria-label="{{ 'Filter by family'|t }}">
                <option value="">{{ 'All families'|t }}</option>
                <option value="actor">{{ 'Actor'|t }}</option>
                <option value="item">{{ 'Item'|t }}</option>
                <option value="obstacle">{{ 'Obstacle'|t }}</option>
                <option value="trap">{{ 'Trap'|t }}</option>
                <option value="hazard">{{ 'Hazard'|t }}</option>
              </select>
            </div>
            <p class="room-editor__catalog-selected" data-room-editor-catalog-selected>{{ 'No object selected for placement.'|t }}</p>
            <div class="room-editor__catalog-actions">
              <button type="button" class="room-editor__button" data-room-editor-action="catalog-create-definition">{{ 'New in Library ↗'|t }}</button>
              <button type="button" class="room-editor__button" data-room-editor-action="catalog-edit-definition" disabled>{{ 'Edit Selected ↗'|t }}</button>
            </div>
            <ul class="room-editor__catalog-list" data-room-editor-catalog-list role="listbox" aria-label="{{ 'Placeable objects'|t }}"></ul>
            <p class="room-editor__catalog-empty" data-room-editor-catalog-empty hidden>{{ 'No matching objects.'|t }}</p>
            <button type="button" class="room-editor__button room-editor__catalog-more" data-room-editor-action="catalog-more" hidden>{{ 'Load more'|t }}</button>
          </section>

          <section class="room-editor__drawer-section room-editor__generation" data-room-editor-generation aria-label="{{ 'Generate room layout'|t }}">
            <p class="room-editor__eyebrow">{{ 'Generate…'|t }}</p>
            <label class="room-editor__field" for="room-editor-generation-prompt">{{ 'Prompt'|t }}
              <textarea id="room-editor-generation-prompt" data-room-editor-generation-prompt rows="3" maxlength="2000" placeholder="{{ 'A flooded cellar with a broken altar, ~20 hexes'|t }}"></textarea>
            </label>
            <label class="room-editor__field">{{ 'Theme'|t }}<input type="text" data-room-editor-generation-theme maxlength="100" placeholder="{{ 'sewer, cellar, shrine...'|t }}"></label>
            <label class="room-editor__field">{{ 'Size'|t }}
              <select data-room-editor-generation-size>
                <option value="small">{{ 'Small'|t }}</option>
                <option value="medium" selected>{{ 'Medium'|t }}</option>
                <option value="large">{{ 'Large'|t }}</option>
                <option value="huge">{{ 'Huge'|t }}</option>
              </select>
            </label>
            <label class="room-editor__field">{{ 'Minimum hexes'|t }}<input type="number" data-room-editor-generation-min-hexes min="16" max="80" step="1" value="16"></label>
            <label class="room-editor__field">{{ 'Maximum hexes'|t }}<input type="number" data-room-editor-generation-max-hexes min="16" max="80" step="1" value="32"></label>
            <label class="room-editor__field">{{ 'Seed (optional)'|t }}<input type="number" data-room-editor-generation-seed min="0" max="2147483647" step="1"></label>
            <button type="button" class="room-editor__button room-editor__button--primary" data-room-editor-action="generate-room-layout">{{ 'Generate room plan'|t }}</button>
          </section>

          <section class="room-editor__drawer-section room-editor__definition-generation" data-room-editor-definition-generation aria-label="{{ 'Generate canonical object'|t }}">
            <p class="room-editor__eyebrow">{{ 'Generate Library Object…'|t }}</p>
            <label class="room-editor__field">{{ 'Family'|t }}
              <select data-room-editor-defgen-family>
                <option value="obstacle">{{ 'Obstacle / Object (table, chair, lava pit…)'|t }}</option>
                <option value="hazard">{{ 'Hazard (environmental / complex)'|t }}</option>
                <option value="trap">{{ 'Trap (mechanical / magical / haunt)'|t }}</option>
                <option value="item">{{ 'Item'|t }}</option>
                <option value="actor">{{ 'Actor / NPC'|t }}</option>
              </select>
            </label>
            <label class="room-editor__field">{{ 'Prompt'|t }}
              <textarea data-room-editor-defgen-prompt rows="2" maxlength="2000" placeholder="{{ 'Heavy oak banquet table, bubbling lava fissure, or poison dart glyph'|t }}"></textarea>
            </label>
            <label class="room-editor__field">{{ 'Category / Type / Role (optional)'|t }}
              <input type="text" data-room-editor-defgen-subtype maxlength="100" placeholder="{{ 'table, decor, simple, mechanical, guardian…'|t }}">
            </label>
            <label class="room-editor__field">{{ 'Level'|t }}
              <input type="number" data-room-editor-defgen-level min="-1" max="30" step="1" value="1">
            </label>
            <button type="button" class="room-editor__button room-editor__button--primary" data-room-editor-action="generate-canonical-definition">{{ 'Generate library object'|t }}</button>
          </section>

          <section class="room-editor__drawer-section object-image-panel" data-room-editor-terrain-image-panel data-object-image-panel>
            <p class="room-editor__eyebrow">{{ 'Terrain image'|t }}</p>
            <h3 data-room-editor-terrain-image-name>{{ 'Stone floor'|t }}</h3>
            <p class="room-editor__hint" data-room-editor-terrain-image-description>{{ 'Shared terrain tile for canonical stone floor hexes.'|t }}</p>
            <img class="object-image-panel__preview" data-object-image-preview alt="{{ 'Terrain tile preview'|t }}" hidden>
            <p data-object-image-placeholder>{{ 'Choose a terrain and generate its shared tile image.'|t }}</p>
            <p data-object-image-status aria-live="polite">{{ 'Loading terrain image…'|t }}</p>
            <div class="object-image-panel__actions">
              <textarea data-object-image-prompt rows="2" placeholder="{{ 'Optional terrain generation prompt'|t }}"></textarea>
              <select data-object-image-version aria-label="{{ 'Terrain image version'|t }}"></select>
              <button type="button" class="room-editor__button" data-object-image-promote>{{ 'Use selected as current'|t }}</button>
              <button type="button" class="room-editor__button room-editor__button--primary" data-object-image-generate>{{ 'Generate / Regenerate terrain tile'|t }}</button>
            </div>
          </section>

          <section class="room-editor__drawer-section" aria-label="{{ 'Editing tools'|t }}">
            <p class="room-editor__eyebrow">{{ 'Tools'|t }}</p>
            <div class="room-editor__toolbar" role="toolbar" data-room-editor-toolbar aria-label="{{ 'Editing tools'|t }}">
              <button type="button" data-room-editor-tool="select" aria-pressed="true">{{ 'Select'|t }}</button>
              <button type="button" data-room-editor-tool="add_hex" aria-pressed="false">{{ 'Add Hex'|t }}</button>
              <button type="button" data-room-editor-tool="remove_hex" aria-pressed="false">{{ 'Remove Hex'|t }}</button>
              <button type="button" data-room-editor-tool="terrain" aria-pressed="false">{{ 'Terrain'|t }}</button>
              <select data-room-editor-terrain-value hidden aria-label="{{ 'Terrain type to apply'|t }}"></select>
              <button type="button" data-room-editor-tool="elevation" aria-pressed="false">{{ 'Elevation'|t }}</button>
              <input type="number" data-room-editor-elevation-value hidden min="-50" max="200" value="0" aria-label="{{ 'Elevation to apply (ft)'|t }}">
              <button type="button" data-room-editor-tool="place" aria-pressed="false">{{ 'Place'|t }}</button>
              <button type="button" data-room-editor-tool="entry_port" aria-pressed="false">{{ 'Entry Port'|t }}</button>
              <button type="button" data-room-editor-tool="exit_port" aria-pressed="false">{{ 'Exit Port'|t }}</button>
            </div>
          </section>

          <section class="room-editor__drawer-section room-editor__inspector" data-room-editor-inspector aria-label="{{ 'Inspector'|t }}">
            <p class="room-editor__eyebrow">{{ 'Inspector'|t }}</p>
            <div data-room-editor-inspector-body>
              <p class="room-editor__hint">{{ 'Load or create a room to begin editing.'|t }}</p>
            </div>
          </section>

          <section class="room-editor__drawer-section room-editor__validation" data-room-editor-validation aria-label="{{ 'Validation results'|t }}">
            <p class="room-editor__eyebrow">{{ 'Validation'|t }}</p>
            <ul class="room-editor__validation-list" data-room-editor-validation-list></ul>
          </section>

          </aside>

          <div class="game-shell__content room-editor__center">
            <div class="hexmap-stage room-editor__stage">
              <div id="room-editor-canvas" class="hexmap-canvas-wrapper" data-room-editor-canvas></div>
              {% include '@dungeoncrawler_content/editor-viewport-controls.html.twig' with { surface: 'room-editor' } only %}
            </div>
            {% include '@dungeoncrawler_content/editor-map-legend.html.twig' with {
              groups: [
                { title: 'Hexes'|t, items: [
                  { symbol: 'hex', fill: '#2d3748', line: '#4a5568', label: 'Floor (part of the room)'|t },
                  { symbol: 'hex', fill: '#1d4ed8', line: '#93c5fd', label: 'Water'|t },
                  { symbol: 'hex', fill: '#7f1d1d', line: '#f97316', label: 'Lava'|t },
                  { symbol: 'hex', fill: '#38bdf8', line: '#e0f2fe', label: 'Selected hex, or where a drag will land'|t },
                  { symbol: 'hex', fill: '#ef4444', line: '#fee2e2', label: 'A drag cannot land here'|t },
                  { symbol: 'text', text: '+10ft', label: 'Elevation of the hex'|t }
                ] },
                { title: 'Contents'|t, items: [
                  { symbol: 'token', fill: '#22c55e', text: 'A', label: 'Actor'|t },
                  { symbol: 'token', fill: '#f59e0b', text: 'I', label: 'Item'|t },
                  { symbol: 'token', fill: '#6b7280', text: 'O', label: 'Obstacle'|t },
                  { symbol: 'token', fill: '#a855f7', text: 'T', label: 'Trap'|t },
                  { symbol: 'token', fill: '#f97316', text: 'H', label: 'Hazard'|t },
                  { symbol: 'token', fill: '#94a3b8', line: '#ffffff', label: 'White outline: selected'|t }
                ] },
                { title: 'Doorways'|t, items: [
                  { symbol: 'triangle', fill: '#38bdf8', label: 'Entry port (destination endpoint for a new connection)'|t },
                  { symbol: 'square', fill: '#2563eb', label: 'Exit port (source endpoint for a new connection)'|t }
                ] }
              ],
            } only %}
            <p class="room-editor__hint">{{ 'Select an object, then Turn left or Turn right above the map (or [ and ]) to change which way it faces; drag it to move it. Contents with artwork show their picture instead of a lettered token. The notch or white pip on a token shows which way it faces. Doorways sit on the edge of their hex. The Dungeon Editor connects an exit endpoint to an entry endpoint; bidirectional connections allow travel between the rooms in both directions, while one-way is a special explicit choice.'|t }}</p>
          </div>


        </div>

      </div>
    </div>
  {% endblock %}
{% endembed %}
