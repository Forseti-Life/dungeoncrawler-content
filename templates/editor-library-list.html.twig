{#
 # Dungeon Manager and Room Manager. Same layout as the Storyline Manager:
 # totals, the published library, then working drafts.
 #}
<div class="dc-character-list dc-character-list--storylines" data-editor-library>
  <div class="dc-character-list__header">
    <h1 class="dc-character-list__title">{{ title }}</h1>
    <div class="dc-sheet__nav-actions">
      <a href="{{ storylines_url }}" class="dc-btn dc-btn-secondary">Storylines</a>
      <a href="{{ sibling.url }}" class="dc-btn dc-btn-secondary">{{ sibling.label }}</a>
      <a href="{{ editor_url }}" class="dc-btn dc-btn-primary">Open {{ noun }} Editor</a>
    </div>
  </div>

  <section class="storyline-metrics" aria-label="{{ title }} library totals">
    {% for metric in metrics %}
      <div class="storyline-metrics__card">
        <strong>{{ metric.value }}</strong>
        <span>{{ metric.label }}</span>
      </div>
    {% endfor %}
  </section>

  <div class="dc-sheet__section storyline-drafts">
    <h2 class="dc-sheet__section-title">Working Drafts</h2>
    <p>Status, validity and next step are what the {{ noun }} Editor reports for each saved draft.</p>
    {% if drafts|length > 0 %}
      <div class="storyline-drafts__table-wrap">
        <table class="storyline-drafts__table">
          <thead>
            <tr><th>Draft</th><th>Complete</th><th>Validity</th><th>Next step</th><th>Revision</th><th>Updated</th><th>Actions</th></tr>
          </thead>
          <tbody>
            {% for draft in drafts %}
              <tr>
                <td><a href="{{ draft.edit_url }}">{{ draft.name }}</a>{% if draft.id %}<div>{{ draft.id }}</div>{% endif %}</td>
                <td>{% if draft.percent is not null %}{{ draft.percent }}%{% else %}—{% endif %}</td>
                <td>{{ draft.validity }}</td>
                <td>{{ draft.next_step }}</td>
                <td>{{ draft.revision }}</td>
                <td>{{ draft.updated }}{% if draft.updated_by %}<div>{{ draft.updated_by }}</div>{% endif %}</td>
                <td class="storyline-drafts__actions"><a href="{{ draft.edit_url }}" class="dc-btn dc-btn-secondary">Open and edit</a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p>No working drafts.</p>
    {% endif %}
  </div>

  <div class="dc-sheet__section storyline-drafts">
    <h2 class="dc-sheet__section-title">{{ noun }} Library</h2>
    <p>{{ intro }}</p>
    <label class="editor-library__filter">Filter
      <input type="search" data-editor-library-filter placeholder="Name, ID, storyline or state">
    </label>
    <p class="storyline-drafts__status" data-editor-library-count role="status" aria-live="polite">{{ entries|length }} shown</p>
    <div class="storyline-drafts__table-wrap">
      <table class="storyline-drafts__table">
        <thead>
          <tr><th>{{ noun }}</th><th>State</th><th>Details</th><th>In these storylines</th><th>Actions</th></tr>
        </thead>
        <tbody>
          {% for entry in entries %}
            <tr data-editor-library-row>
              <td><a href="{{ entry.edit_url }}">{{ entry.name }}</a><div>{{ entry.id }}</div></td>
              <td>{{ entry.state }}</td>
              <td>{% for fact in entry.facts %}<div>{{ fact }}</div>{% endfor %}</td>
              <td>
                {% for story in entry.storylines %}
                  <div><a href="{{ story.url }}">{{ story.title }}</a> ({{ story.status }})</div>
                {% else %}
                  No storyline uses this yet.
                {% endfor %}
              </td>
              <td class="storyline-drafts__actions"><a href="{{ entry.edit_url }}" class="dc-btn dc-btn-secondary">{{ entry.action_label }}</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
