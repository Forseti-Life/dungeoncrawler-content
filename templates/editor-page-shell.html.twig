{#
/**
 * @file
 * The page format shared by the authoring editors.
 *
 *   header:   title, what the page is for, back to the manager
 *   left:     process stages, current state, quick links
 *   right:    the Game Master Agent on top, the editing surface below
 *
 * The one producer of this layout: the Storyline Builder, the Dungeon Editor
 * and the Room Editor all embed it.
 *
 * Blocks:
 * - gm, editor: the agent panel and the editing surface (Dungeon, Room).
 * - frame: replaces both when a page brings its own workspace (Storyline).
 * - stages, state, links, heading: the parts of the left column and the
 *   workspace heading. Their defaults are filled from an editor's status
 *   projection; the Storyline Builder supplies its own.
 *
 * Variables:
 * - surface: 'dungeon-editor' or 'room-editor', or empty. Becomes the root
 *   data attribute the editor shell binds to (data-dungeon-editor) and the
 *   prefix of the status attribute (data-dungeon-editor-gm-status).
 * - root_attribute: a data attribute a page's own script binds to, when it
 *   is not an editor surface (the character workspace).
 * - eyebrow: the small label over the title; "Game master workspace" when
 *   not given.
 * - panel_meta: the line beside the workspace heading.
 * - title, intro: page heading and one-sentence purpose.
 * - back_url, back_label: link to the manager page.
 * - stages_title: heading of the stage list.
 * - thing: what is being edited, lower case ("dungeon", "room").
 * - contains_title: heading of the links to what this thing contains or is
 *   contained by.
 * - quick_links: list of { label, url } shown under "Quick launch".
 * - contents_title: optional heading for the list of definitions placed in
 *   the thing being edited; the list is omitted when this is not set.
 *
 * The left column is filled from the server's status projection by
 * js/v2/editor/EditorDraftStatusCard.js; nothing in it is computed here.
 */
#}
<div class="character-setup-page{% if surface %} editor-page editor-page--{{ surface }}{% endif %}"{% if surface %} data-{{ surface }}{% endif %}{% if root_attribute %} {{ root_attribute }}{% endif %}>
  <div class="character-setup-page__header">
    <p class="character-setup-page__eyebrow">{{ eyebrow|default('Game master workspace'|t) }}</p>
    <h1 class="character-setup-page__title">{{ title }}</h1>
    <p class="character-setup-page__intro">{{ intro }}</p>
    {% if surface and thing %}
      <div class="editor-page__load-state" data-{{ surface }}-load-state data-load-state="loading" role="status" aria-live="polite">
        <span class="editor-page__load-spinner" aria-hidden="true"></span>
        <span data-{{ surface }}-load-label>{{ 'Loading @thing…'|t({'@thing': thing}) }}</span>
        <progress data-{{ surface }}-load-progress aria-label="{{ 'Loading @thing'|t({'@thing': thing}) }}"></progress>
      </div>
    {% endif %}
    <a class="btn btn-secondary character-setup-page__back" href="{{ back_url }}">{{ back_label }}</a>
  </div>

  <div class="character-setup-page__layout">
    <div class="character-setup-page__sidebar">
      <div class="character-setup-page__sidebar-stack"{% if surface %} data-{{ surface }}-gm-status{% endif %}>
        <div class="character-setup-page__sidebar-card">
          <h2 class="character-setup-page__sidebar-title">{{ stages_title }}</h2>
          {% block stages %}
            <ol class="character-setup-page__tabs editor-page__stages" data-editor-status-stages>
              <li class="editor-page__stage-empty">{{ 'Load or create a @thing to see its stages.'|t({'@thing': thing}) }}</li>
            </ol>
          {% endblock %}
        </div>

        {% block state %}
        <section class="character-setup-page__sidebar-card gm-storyline-status" aria-labelledby="{{ surface }}-status-title">
          <h2 id="{{ surface }}-status-title" class="character-setup-page__sidebar-title">{{ 'Current state'|t }}</h2>
          <div class="gm-storyline-status__score"><strong data-editor-status-percent>0%</strong><span>{{ 'authoring complete'|t }}</span></div>
          <progress data-editor-status-progress max="100" value="0">0%</progress>
          <dl>
            <div><dt>{{ 'Validity'|t }}</dt><dd data-editor-status-validity>{{ 'No draft'|t }}</dd></div>
            <div><dt>{{ 'Current stage'|t }}</dt><dd data-editor-status-stage>—</dd></div>
          </dl>
          <p><a data-editor-warning-review hidden>{{ 'Review warnings'|t }}</a></p>
          <p class="gm-storyline-status__label"><strong>{{ 'Minimum content still needed'|t }}</strong></p>
          <ul data-editor-status-missing><li>{{ 'Create or load a draft.'|t }}</li></ul>
        </section>
        {% endblock %}

        <div class="character-setup-page__sidebar-card">
          <h2 class="character-setup-page__sidebar-title">{{ 'Quick launch'|t }}</h2>
          <ul class="character-setup-page__quick-links">
            {% for link in quick_links %}
              <li><a href="{{ link.url }}">{{ link.label }}</a></li>
            {% else %}
              <li>{{ 'No additional quick-launch links are available for your role.'|t }}</li>
            {% endfor %}
          </ul>
          {% block links %}
          <h3 class="character-setup-page__sidebar-title">{{ contains_title }}</h3>
          <ul class="character-setup-page__quick-links" data-editor-status-links>
            <li>{{ 'Load a @thing to see what it links to.'|t({'@thing': thing}) }}</li>
          </ul>
          {% if contents_title %}
          <h3 class="character-setup-page__sidebar-title">{{ contents_title }}</h3>
          <ul class="character-setup-page__quick-links" data-editor-status-contents>
            <li>{{ 'Load a @thing to see what is placed in it.'|t({'@thing': thing}) }}</li>
          </ul>
          {% endif %}
          <h3 class="character-setup-page__sidebar-title">{{ 'In these storylines'|t }}</h3>
          <ul class="character-setup-page__quick-links" data-editor-status-storylines>
            <li>{{ 'No storyline uses this yet.'|t }}</li>
          </ul>
          {% endblock %}
        </div>
      </div>
    </div>

    <div class="character-setup-page__workspace">
      <div class="character-setup-page__panel-header">
        <p class="character-setup-page__panel-label">{{ 'Primary authoring interface'|t }}</p>
        {% block heading %}
          <h2 class="character-setup-page__panel-title" data-editor-status-name>{{ 'No @thing loaded'|t({'@thing': thing}) }}</h2>
        {% endblock %}
        {% if panel_meta %}
          <p class="character-setup-page__panel-meta">{{ panel_meta }}</p>
        {% endif %}
      </div>
      <div class="character-setup-page__frame-shell">
        {% block frame %}
          <div class="gm-storyline-wizard editor-page__frame">
            {% block gm %}{% endblock %}
            {% block editor %}{% endblock %}
          </div>
        {% endblock %}
      </div>
    </div>
  </div>
</div>
