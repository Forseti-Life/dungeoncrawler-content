{
  "template_id": "rescue_merchant",
  "name": "Rescue {npc} from {location}",
  "description": "{npc}, a {npc_role}, was captured by {target}s in {location}. Find and rescue them before it's too late!",
  "quest_type": "rescue",
  "level_min": 2,
  "level_max": 5,
  "tags": [
    "combat",
    "rescue",
    "time_limited"
  ],
  "objectives_schema": [
    {
      "phase": 1,
      "objectives": [
        {
          "objective_id": "find_location",
          "type": "explore",
          "description": "Find the {location}",
          "location": "{location}",
          "next_step": "Travel to {location} and reveal the rescue site on the map.",
          "completion_criteria": {
            "kind": "flag",
            "metric": "discovered",
            "required_value": true,
            "description": "Discover {location}."
          }
        },
        {
          "objective_id": "defeat_captors",
          "type": "kill",
          "target": "{target}",
          "target_count_range": [
            4,
            8
          ],
          "description": "Defeat the {target}s holding {npc}",
          "next_step": "Enter {location}, engage the {target}s guarding {npc}, and defeat them.",
          "completion_criteria": {
            "kind": "count",
            "metric": "current",
            "target_count": 1,
            "description": "Complete when {target_count} {target}s holding {npc} have been defeated."
          }
        },
        {
          "objective_id": "rescue_npc",
          "type": "interact",
          "target": "{npc}",
          "description": "Free {npc} from captivity",
          "next_step": "Interact with {npc} after the captors are defeated to free them.",
          "completion_criteria": {
            "kind": "flag",
            "metric": "completed",
            "required_value": true,
            "description": "Speak to {npc} to free them from captivity."
          }
        }
      ]
    },
    {
      "phase": 2,
      "objectives": [
        {
          "objective_id": "escort_to_safety",
          "type": "escort",
          "target": "{npc}",
          "npc_ref": "{npc}",
          "destination": "{safe_location}",
          "encounter_count_range": [
            1,
            3
          ],
          "encounter_types": [
            "social",
            "problem_solving",
            "combat"
          ],
          "encounter_profiles": [
            "negotiation_collapse",
            "chase_transition",
            "ambush"
          ],
          "description": "Escort {npc} back to safety",
          "next_step": "Travel with {npc} to {safe_location}; resolve the 1-3 route encounters and keep {npc} alive.",
          "completion_criteria": {
            "kind": "flag",
            "metric": "arrived",
            "required_value": true,
            "description": "Escort {npc} safely to {safe_location} and keep them alive."
          }
        }
      ]
    }
  ],
  "rewards_schema": {
    "xp": {
      "base": 120,
      "per_level": 40
    },
    "gold": {
      "base": 10,
      "per_level": 5,
      "randomize": true
    },
    "items": {
      "loot_table": "gmg_balanced_party_cache",
      "count": 1
    },
    "reputation": {
      "faction": "{npc_faction}",
      "amount": 25
    }
  },
  "prerequisites": {
    "level_min": 2
  },
  "story_impact": {
    "storyline_id": "torment-and-legacy",
    "chapter_id": "onboarding",
    "scene_id": "first-engagement"
  },
  "time_limit_hours": 24,
  "estimated_duration_minutes": 45,
  "version": "1.0.0"
}
