/**
 * Backfill combat_participants schema drift for status and entity_ref size.
 */
function dungeoncrawler_content_update_10061() {
  $database = \Drupal::database();
  $schema = dungeoncrawler_content_schema();
  $schema_handler = $database->schema();
  $messages = [];

  if (!$schema_handler->tableExists('combat_participants')) {
    $schema_handler->createTable('combat_participants', $schema['combat_participants']);
    return t('Created combat_participants.');
  }

  if (!$schema_handler->fieldExists('combat_participants', 'status')) {
    $schema_handler->addField('combat_participants', 'status', $schema['combat_participants']['fields']['status']);
    $database->update('combat_participants')
      ->fields(['status' => 'active'])
      ->isNull('status')
      ->execute();
    $messages[] = 'Added combat_participants.status.';
  }

  $driver = method_exists($database, 'databaseType')
    ? (string) $database->databaseType()
    : (string) (($database->getConnectionOptions()['driver'] ?? ''));
  if (in_array($driver, ['mysql', 'mysqli'], TRUE)) {
    $database->query('ALTER TABLE {combat_participants} MODIFY entity_ref VARCHAR(768) NULL');
    $messages[] = 'Expanded combat_participants.entity_ref to 768 chars.';
  }
  else {
    $schema_handler->changeField(
      'combat_participants',
      'entity_ref',
      'entity_ref',
      $schema['combat_participants']['fields']['entity_ref']
    );
    $messages[] = 'Expanded combat_participants.entity_ref via schema API.';
  }

  return t(implode(' ', $messages));
}

