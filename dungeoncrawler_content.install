  return $schema;
}

/**
 * Implements hook_install().
 */
function dungeoncrawler_content_install() {
  \Drupal::messenger()->addMessage(t('Dungeon Crawler Content module has been installed.'));

  // Create ancestry content type on fresh installs (mirrors update_10016/10030 for test environments).
  try {
    $type = \Drupal\node\Entity\NodeType::load('ancestry');
    if (!$type) {
      $type = \Drupal\node\Entity\NodeType::create([
        'type' => 'ancestry',
        'name' => 'Ancestry',
        'description' => 'PF2E ancestry definitions (dwarf, elf, gnome, goblin, halfling, human, etc.).',
        'settings' => [
          'node' => [
            'options' => ['status' => TRUE, 'promote' => FALSE, 'sticky' => FALSE, 'revision' => FALSE],
            'preview' => DRUPAL_DISABLED,
            'submitted' => FALSE,
          ],
        ],
      ]);
      $type->save();
      \Drupal::logger('dungeoncrawler_content')->notice('hook_install: created ancestry content type.');
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Ancestry content type creation during install failed: @error', ['@error' => $e->getMessage()]);
  }

  // Create ancestry custom fields on fresh installs (mirrors update_10030).
  try {
    $ancestry_fields = [
      'field_ancestry_hp' => ['type' => 'integer', 'cardinality' => 1, 'label' => 'Hit Points'],
      'field_ancestry_size' => ['type' => 'string', 'cardinality' => 1, 'label' => 'Size', 'settings' => ['max_length' => 20]],
      'field_ancestry_speed' => ['type' => 'integer', 'cardinality' => 1, 'label' => 'Speed'],
      'field_ancestry_boosts' => ['type' => 'string', 'cardinality' => \Drupal\Core\Field\FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED, 'label' => 'Ability Boosts', 'settings' => ['max_length' => 50]],
      'field_ancestry_flaws' => ['type' => 'string', 'cardinality' => \Drupal\Core\Field\FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED, 'label' => 'Ability Flaws', 'settings' => ['max_length' => 50]],
      'field_ancestry_languages' => ['type' => 'string', 'cardinality' => \Drupal\Core\Field\FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED, 'label' => 'Languages', 'settings' => ['max_length' => 50]],
      'field_ancestry_senses' => ['type' => 'string', 'cardinality' => \Drupal\Core\Field\FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED, 'label' => 'Senses', 'settings' => ['max_length' => 50]],
    ];
    foreach ($ancestry_fields as $field_name => $def) {
      if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field_name)) {
        $storage_def = [
          'field_name' => $field_name,
          'entity_type' => 'node',
          'type' => $def['type'],
          'cardinality' => $def['cardinality'],
        ];
        if (!empty($def['settings'])) {
          $storage_def['settings'] = $def['settings'];
        }
        \Drupal\field\Entity\FieldStorageConfig::create($storage_def)->save();
      }
      if (!\Drupal\field\Entity\FieldConfig::loadByName('node', 'ancestry', $field_name)) {
        \Drupal\field\Entity\FieldConfig::create([
          'field_name' => $field_name,
          'entity_type' => 'node',
          'bundle' => 'ancestry',
          'label' => $def['label'],
          'required' => FALSE,
        ])->save();
      }
    }
    \Drupal::logger('dungeoncrawler_content')->notice('hook_install: created ancestry custom fields.');
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Ancestry field creation during install failed: @error', ['@error' => $e->getMessage()]);
  }

  // Seed 6 core ancestry nodes on fresh installs (mirrors update_10016).
  try {
    $core_ancestries = ['Human', 'Elf', 'Dwarf', 'Gnome', 'Goblin', 'Halfling'];
    $all_ancestries = \Drupal\dungeoncrawler_content\Service\CharacterManager::ANCESTRIES;
    foreach ($core_ancestries as $ancestry_name) {
      if (!isset($all_ancestries[$ancestry_name])) {
        continue;
      }
      $existing = \Drupal::entityQuery('node')
        ->condition('type', 'ancestry')
        ->condition('title', $ancestry_name)
        ->accessCheck(FALSE)
        ->execute();
      if (!empty($existing)) {
        continue;
      }
      $data = $all_ancestries[$ancestry_name];
      $node = \Drupal\node\Entity\Node::create([
        'type'   => 'ancestry',
        'title'  => $ancestry_name,
        'status' => 1,
        'uid'    => 1,
        'body'   => [
          'value'  => json_encode([
            'hp'        => $data['hp'],
            'size'      => $data['size'],
            'speed'     => $data['speed'],
            'boosts'    => $data['boosts'],
            'flaw'      => $data['flaw'] ?? null,
            'languages' => $data['languages'],
            'senses'    => $data['vision'],
            'traits'    => $data['traits'],
          ], JSON_PRETTY_PRINT),
          'format' => 'plain_text',
        ],
      ]);
      $node->set('field_ancestry_hp', (int) ($data['hp'] ?? 0));
      $node->set('field_ancestry_size', $data['size'] ?? 'Medium');
      $node->set('field_ancestry_speed', (int) ($data['speed'] ?? 25));
      $node->set('field_ancestry_boosts', array_map(fn($b) => ['value' => $b], $data['boosts'] ?? []));
      $node->set('field_ancestry_flaws', array_map(fn($f) => ['value' => $f], array_filter([$data['flaw'] ?? ''])));
      $node->set('field_ancestry_languages', array_map(fn($l) => ['value' => $l], $data['languages'] ?? []));
      $node->set('field_ancestry_senses', !empty($data['vision']) ? [['value' => $data['vision']]] : []);
      $node->save();
    }
    \Drupal::logger('dungeoncrawler_content')->notice('hook_install: seeded core ancestry nodes.');
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Ancestry node seeding during install failed: @error', ['@error' => $e->getMessage()]);
  }

  // Seed all content from JSON files (items, creatures, etc.).
  try {
    /** @var \Drupal\dungeoncrawler_content\Service\ContentRegistry $registry */
    $registry = \Drupal::service('dungeoncrawler_content.content_registry');
    $count = $registry->importContentFromJson();
    \Drupal::messenger()->addMessage(t('Imported @count content items from JSON files.', ['@count' => $count]));
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Content import during install failed: @error', ['@error' => $e->getMessage()]);
  }

  // Seed template libraries (setting/room templates, encounters, loot, etc.).
  try {
    /** @var \Drupal\dungeoncrawler_content\Service\ContentSeederService $seeder */
    $seeder = \Drupal::service('dungeoncrawler_content.content_seeder');
    $summary = $seeder->seedAll();
    $total = array_sum($summary);
    \Drupal::messenger()->addMessage(t('Seeded @count template/content records from packaged JSON.', ['@count' => $total]));
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Content seeder during install failed: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Implements hook_uninstall().
 */
function dungeoncrawler_content_uninstall() {
  \Drupal::messenger()->addMessage(t('Dungeon Crawler Content module has been uninstalled.'));
}

/**
 * Add dc_characters table for PF2e character storage.
 */
function dungeoncrawler_content_update_10001() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  
  try {
    if (!$database->schema()->tableExists('dc_characters')) {
      $database->schema()->createTable('dc_characters', $schema['dc_characters']);
      return t('Created dc_characters table.');
    }
    return t('dc_characters table already exists.');
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10001 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to create dc_characters table: ' . $e->getMessage());
  }
}

/**
 * Add game content system tables.
 */
function dungeoncrawler_content_update_10002() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $messages = [];

  try {
    if (!$database->schema()->tableExists('dungeoncrawler_content_registry')) {
      $database->schema()->createTable('dungeoncrawler_content_registry', $schema['dungeoncrawler_content_registry']);
      $messages[] = 'Created dungeoncrawler_content_registry table.';
    }

    if (!$database->schema()->tableExists('dungeoncrawler_content_loot_tables')) {
      $database->schema()->createTable('dungeoncrawler_content_loot_tables', $schema['dungeoncrawler_content_loot_tables']);
      $messages[] = 'Created dungeoncrawler_content_loot_tables table.';
    }

    if (!$database->schema()->tableExists('dungeoncrawler_content_encounter_templates')) {
      $database->schema()->createTable('dungeoncrawler_content_encounter_templates', $schema['dungeoncrawler_content_encounter_templates']);
      $messages[] = 'Created dungeoncrawler_content_encounter_templates table.';
    }

    if (empty($messages)) {
      return t('Game content system tables already exist.');
    }

    return t('Game content system update complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10002 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to create game content system tables: ' . $e->getMessage());
  }
}

/**
 * Add campaign management tables.
 */
function dungeoncrawler_content_update_10003() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $messages = [];

  try {
    if (!$database->schema()->tableExists('dc_campaigns')) {
      $database->schema()->createTable('dc_campaigns', $schema['dc_campaigns']);
      $messages[] = 'Created dc_campaigns table.';
    }

    if (!$database->schema()->tableExists('dc_campaign_characters')) {
      $database->schema()->createTable('dc_campaign_characters', $schema['dc_campaign_characters']);
      $messages[] = 'Created dc_campaign_characters table.';
    }

    if (empty($messages)) {
      return t('Campaign management tables already exist.');
    }

    return t('Campaign management update complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10003 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to create campaign management tables: ' . $e->getMessage());
  }
}

/**
 * Add campaign-scoped content tables.
 */
function dungeoncrawler_content_update_10004() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $messages = [];

  $tables = [
    'dc_campaign_content_registry',
    'dc_campaign_loot_tables',
    'dc_campaign_encounter_templates',
    'dc_campaign_rooms',
    'dc_campaign_dungeons',
    'dc_campaign_encounter_instances',
    'dc_campaign_room_states',
    'dc_campaign_item_instances',
    'dc_campaign_log',
  ];

  try {
    foreach ($tables as $table) {
      if (!$database->schema()->tableExists($table)) {
        $database->schema()->createTable($table, $schema[$table]);
        $messages[] = 'Created ' . $table . ' table.';
      }
    }

    if (empty($messages)) {
      return t('Campaign-scoped content tables already exist.');
    }

    return t('Campaign-scoped content update complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10004 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to create campaign-scoped content tables: ' . $e->getMessage());
  }
}

/**
 * Unify entity storage across characters, NPCs, obstacles, traps, and hazards.
 *
 * - Adds type/default data to dc_characters for library defaults.
 * - Expands dc_campaign_characters to hold per-campaign runtime instances and locations.
 * - Backfills existing rows with sensible defaults and instance ids.
 */
function dungeoncrawler_content_update_10005() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $schema_handler = $database->schema();
  $messages = [];

  try {
    // dc_characters: add polymorphic type + defaults.
    $character_fields = ['type', 'default_character_data', 'default_locations'];
    foreach ($character_fields as $field) {
      if (!$schema_handler->fieldExists('dc_characters', $field)) {
        $schema_handler->addField('dc_characters', $field, $schema['dc_characters']['fields'][$field]);
        $messages[] = "Added dc_characters.$field";
      }
    }
    if (!$schema_handler->indexExists('dc_characters', 'type')) {
      $schema_handler->addIndex('dc_characters', 'type', ['type'], $schema['dc_characters']);
    }

    // Backfill type/defaults for existing characters.
    $database->update('dc_characters')
      ->fields(['type' => 'pc'])
      ->isNull('type')
      ->execute();
    $database->update('dc_characters')
      ->fields(['type' => 'pc'])
      ->condition('type', '')
      ->execute();

    // When no default_character_data set, mirror current character_data as a starting point.
    if ($schema_handler->fieldExists('dc_characters', 'default_character_data')) {
      $char_query = $database->select('dc_characters', 'c')
        ->fields('c', ['id', 'character_data', 'default_character_data'])
        ->isNull('default_character_data');
      $char_rows = $char_query->execute();

      // Also cover empty-string defaults; do a second pass if needed.
      $char_rows_empty = $database->select('dc_characters', 'c')
        ->fields('c', ['id', 'character_data', 'default_character_data'])
        ->condition('default_character_data', '')
        ->execute();

      $combined_rows = array_merge(iterator_to_array($char_rows), iterator_to_array($char_rows_empty));
      $seen = [];
      foreach ($combined_rows as $row) {
        if (in_array($row->id, $seen, TRUE)) {
          continue;
        }
        $seen[] = $row->id;
        $database->update('dc_characters')
          ->fields(['default_character_data' => $row->character_data])
          ->condition('id', $row->id)
          ->execute();
      }
    }

    // dc_campaign_characters: add runtime instance fields.
    $campaign_fields = ['instance_id', 'type', 'state_data', 'location_type', 'location_ref', 'updated'];
    foreach ($campaign_fields as $field) {
      if (!$schema_handler->fieldExists('dc_campaign_characters', $field)) {
        $schema_handler->addField('dc_campaign_characters', $field, $schema['dc_campaign_characters']['fields'][$field]);
        $messages[] = "Added dc_campaign_characters.$field";
      }
    }

    // Drop old unique key and add the new instance-based unique key.
    if ($schema_handler->indexExists('dc_campaign_characters', 'campaign_character')) {
      $schema_handler->dropUniqueKey('dc_campaign_characters', 'campaign_character');
    }
    if (!$schema_handler->indexExists('dc_campaign_characters', 'campaign_instance')) {
      $schema_handler->addUniqueKey('dc_campaign_characters', 'campaign_instance', ['campaign_id', 'instance_id']);
    }
    if (!$schema_handler->indexExists('dc_campaign_characters', 'type')) {
      $schema_handler->addIndex('dc_campaign_characters', 'type', ['type'], $schema['dc_campaign_characters']);
    }

    // Build a lookup of library character types for backfill.
    $types = [];
    $char_results = $database->select('dc_characters', 'c')
      ->fields('c', ['id', 'type'])
      ->execute();
    foreach ($char_results as $row) {
      $types[(int) $row->id] = $row->type ?? 'pc';
    }

    // Backfill campaign rows with instance ids and defaults.
    $now = time();
    $campaign_rows = $database->select('dc_campaign_characters', 'cc')
      ->fields('cc')
      ->execute();

    foreach ($campaign_rows as $row) {
      $instance_id = !empty($row->instance_id) ? $row->instance_id : ('char_' . $row->character_id);
      $type = $types[(int) $row->character_id] ?? 'pc';
      $state_data = $row->state_data ?? '{}';
      $location_type = $row->location_type ?? 'global';
      $location_ref = $row->location_ref ?? '';
      $updated = $row->updated ?? $now;

      $database->update('dc_campaign_characters')
        ->fields([
          'instance_id' => $instance_id,
          'type' => $type,
          'state_data' => $state_data,
          'location_type' => $location_type,
          'location_ref' => $location_ref,
          'updated' => $updated,
        ])
        ->condition('id', $row->id)
        ->execute();
    }

    if (empty($messages)) {
      $messages[] = 'Schema already up to date.';
    }

    return t('Unified entity model update complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10005 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to apply unified entity model update: ' . $e->getMessage());
  }
}

