      'operation' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'stacking' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'phase' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'breakdown_key' => ['type' => 'varchar', 'length' => 191, 'not null' => FALSE],
      'impact_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
