/**
 * Create durable quest confirmation storage and migrate key-value entries.
 */
function dungeoncrawler_content_update_10053() {
  $database = \Drupal::database();
  $schema = dungeoncrawler_content_schema();
  $schema_handler = $database->schema();
  $table_name = 'dc_campaign_quest_confirmations';

  if (!$schema_handler->tableExists($table_name)) {
    $schema_handler->createTable($table_name, $schema[$table_name]);
  }

  $store = \Drupal::keyValue('dungeoncrawler_content.quest_confirmations');
  $legacy_rows = $store->getAll();
  $migrated = 0;
  $skipped = 0;

  foreach ($legacy_rows as $confirmation_id => $row) {
    if (!is_array($row)) {
      $skipped++;
      continue;
    }

    $existing = $database->select($table_name, 'q')
      ->fields('q', ['confirmation_id'])
      ->condition('confirmation_id', (string) ($row['confirmation_id'] ?? $confirmation_id))
      ->execute()
      ->fetchField();

    if ($existing) {
      $skipped++;
      continue;
    }

    $database->insert($table_name)
      ->fields([
        'confirmation_id' => (string) ($row['confirmation_id'] ?? $confirmation_id),
        'campaign_id' => (int) ($row['campaign_id'] ?? 0),
        'character_id' => isset($row['character_id']) ? (int) $row['character_id'] : NULL,
        'status' => (string) ($row['status'] ?? 'pending'),
        'prompt' => isset($row['prompt']) ? (string) $row['prompt'] : NULL,
        'touchpoint_event' => json_encode($row['touchpoint_event'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
        'candidates' => json_encode($row['candidates'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
        'selected_objective_id' => isset($row['selected_objective_id']) ? (string) $row['selected_objective_id'] : NULL,
        'resolved_by' => isset($row['resolved_by']) ? (string) $row['resolved_by'] : NULL,
        'created_at' => (int) ($row['created_at'] ?? 0),
        'expires_at' => isset($row['expires_at']) ? (int) $row['expires_at'] : NULL,
        'resolved_at' => isset($row['resolved_at']) ? (int) $row['resolved_at'] : NULL,
      ])
      ->execute();

    $migrated++;
  }

  if (!empty($legacy_rows)) {
    $store->deleteMultiple(array_keys($legacy_rows));
  }

  return t('Quest confirmation storage ready. Migrated @migrated legacy confirmation rows and skipped @skipped existing/invalid rows.', [
    '@migrated' => $migrated,
    '@skipped' => $skipped,
  ]);
}

/**
 * Create storyline storage tables and quest-link columns.
 */
function dungeoncrawler_content_update_10054() {
  $database = \Drupal::database();
  $schema = dungeoncrawler_content_schema();
  $schema_handler = $database->schema();
  $messages = [];

  foreach ([
    'dungeoncrawler_content_storylines',
    'dc_campaign_storylines',
    'dc_campaign_storyline_log',
  ] as $table_name) {
    if (!$schema_handler->tableExists($table_name)) {
      $schema_handler->createTable($table_name, $schema[$table_name]);
      $messages[] = "Created {$table_name}.";
    }
  }

  foreach ([
    'storyline_id',
    'storyline_chapter_id',
    'storyline_scene_id',
  ] as $field_name) {
    if (
      $schema_handler->tableExists('dc_campaign_quests')
      && !$schema_handler->fieldExists('dc_campaign_quests', $field_name)
    ) {
      $schema_handler->addField('dc_campaign_quests', $field_name, $schema['dc_campaign_quests']['fields'][$field_name]);
      $messages[] = "Added dc_campaign_quests.{$field_name}.";
    }
  }

  foreach ([
    'campaign_storyline' => ['campaign_id', 'storyline_id'],
    'storyline_chapter' => ['storyline_chapter_id'],
    'storyline_scene' => ['storyline_scene_id'],
  ] as $index_name => $index_columns) {
    if (
      $schema_handler->tableExists('dc_campaign_quests')
      && !$schema_handler->indexExists('dc_campaign_quests', $index_name)
    ) {
      $schema_handler->addIndex('dc_campaign_quests', $index_name, $index_columns, $schema['dc_campaign_quests']);
      $messages[] = "Added index dc_campaign_quests.{$index_name}.";
    }
  }

  return $messages === []
    ? t('Storyline storage already existed; no schema changes were required.')
    : implode(' ', $messages);
}

