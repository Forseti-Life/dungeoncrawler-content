/**
 * Backfill registry spell metadata for locally defined cantrips and 1st-rank spells.
 */
function dungeoncrawler_content_update_10050() {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('dungeoncrawler_content_registry')) {
    return t('dungeoncrawler_content_registry does not exist; no action taken.');
  }

  $spell_map = dungeoncrawler_content_collect_local_spell_metadata([0, 1]);
  if ($spell_map === []) {
    return t('No local spell metadata definitions were found to backfill.');
  }

  $rows = $database->select('dungeoncrawler_content_registry', 'r')
    ->fields('r', ['id', 'content_id', 'schema_data'])
    ->condition('content_type', 'spell')
    ->condition('level', [0, 1], 'IN')
    ->execute()
    ->fetchAllAssoc('id');

  $updated = 0;
  foreach ($rows as $row) {
    $normalized_id = dungeoncrawler_content_normalize_spell_id((string) $row->content_id);
    if (!isset($spell_map[$normalized_id])) {
      continue;
    }

    $schema = json_decode((string) ($row->schema_data ?? '{}'), TRUE);
    if (!is_array($schema)) {
      $schema = [];
    }

    $merged = array_replace($schema, $spell_map[$normalized_id]);
    if (empty($merged['description_snippet']) && !empty($merged['description'])) {
      $merged['description_snippet'] = \Drupal\Component\Utility\Unicode::truncate(trim((string) $merged['description']), 180, TRUE, TRUE);
    }

    if (json_encode($schema, JSON_UNESCAPED_UNICODE) === json_encode($merged, JSON_UNESCAPED_UNICODE)) {
      continue;
    }

    $database->update('dungeoncrawler_content_registry')
      ->fields([
        'schema_data' => json_encode($merged, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
        'updated' => time(),
      ])
      ->condition('id', (int) $row->id)
      ->execute();
    $updated++;
  }

  return t('Backfilled local metadata into @count cantrip/1st-rank spell registry rows.', ['@count' => $updated]);
}

