      'layout_data' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE, 'description' => 'JSON: hexes, hex_manifest, entry_points, exit_points, terrain, lighting.'],
      'contents_data' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE, 'description' => 'JSON: creatures, items, traps, hazards, obstacles, interactables.'],
