      ],
      'reveal_data' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON-encoded reveal payload (NULL on failure).',
      ],
      'attempted_at' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp of most recent attempt.',
      ],
